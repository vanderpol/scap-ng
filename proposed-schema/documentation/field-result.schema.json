{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposed/documentation/field-result.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-11-02",
  "title": "Native 0.4 field comparison Result",
  "description": "Supplied field observations bound to a native require predicate and an exact retained Item/record; never an OVAL State/entity reference.",
  "type": "object",
  "required": [
    "field",
    "require_ref",
    "outcome",
    "observed_values",
    "observation_complete"
  ],
  "properties": {
    "field": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "require_ref": {
      "type": "string",
      "pattern": "^/tests/(?:[^~/]|~[01])+/require(?:/(?:[^~]|~[01])*)?$",
      "description": "Canonical RFC6901 location in the owning Assessment; semantic validation must resolve it to a requirement node of this Test."
    },
    "record_ref": {
      "type": "string",
      "pattern": "^/fields/(?:[^~]|~[01])+$",
      "description": "Canonical RFC6901 pointer into the retained Item to this exact typed record instance, including array index when multivalued."
    },
    "outcome": {
      "$ref": "result-types.schema.json#/$defs/technical_outcome"
    },
    "operation": {
      "enum": [
        "binary_equals",
        "binary_not_equal",
        "bitwise_and",
        "bitwise_or",
        "case_insensitive_equals",
        "case_insensitive_not_equal",
        "debian_evr_equals",
        "debian_evr_greater_than",
        "debian_evr_greater_than_or_equal",
        "debian_evr_less_than",
        "debian_evr_less_than_or_equal",
        "debian_evr_not_equal",
        "equals",
        "fileset_revision_equals",
        "fileset_revision_greater_than",
        "fileset_revision_greater_than_or_equal",
        "fileset_revision_less_than",
        "fileset_revision_less_than_or_equal",
        "fileset_revision_not_equal",
        "float_equals",
        "float_greater_than",
        "float_greater_than_or_equal",
        "float_less_than",
        "float_less_than_or_equal",
        "float_not_equal",
        "greater_than",
        "greater_than_or_equal",
        "ios_version_equals",
        "ios_version_greater_than",
        "ios_version_greater_than_or_equal",
        "ios_version_less_than",
        "ios_version_less_than_or_equal",
        "ios_version_not_equal",
        "ipv4_equals",
        "ipv4_greater_than",
        "ipv4_greater_than_or_equal",
        "ipv4_less_than",
        "ipv4_less_than_or_equal",
        "ipv4_not_equal",
        "ipv4_subset_of",
        "ipv4_superset_of",
        "ipv6_equals",
        "ipv6_greater_than",
        "ipv6_greater_than_or_equal",
        "ipv6_less_than",
        "ipv6_less_than_or_equal",
        "ipv6_not_equal",
        "ipv6_subset_of",
        "ipv6_superset_of",
        "less_than",
        "less_than_or_equal",
        "matches_regex",
        "not_equal",
        "rpm_evr_equals",
        "rpm_evr_greater_than",
        "rpm_evr_greater_than_or_equal",
        "rpm_evr_less_than",
        "rpm_evr_less_than_or_equal",
        "rpm_evr_not_equal",
        "subset_of",
        "superset_of",
        "version_equals",
        "version_greater_than",
        "version_greater_than_or_equal",
        "version_less_than",
        "version_less_than_or_equal",
        "version_not_equal"
      ]
    },
    "datatype": {
      "$ref": "capability-common.schema.json#/$defs/native_datatype",
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/datatype_tag"
    },
    "values_found": {
      "$ref": "assessment-language.schema.json#/$defs/existence_cardinality"
    },
    "values_matching": {
      "$ref": "assessment-language.schema.json#/$defs/cardinality"
    },
    "value_match": {
      "$ref": "assessment-language.schema.json#/$defs/cardinality"
    },
    "requirement_ref": {
      "type": "string",
      "pattern": "^/tests/(?:[^~/]|~[01])+/require(?:/(?:[^~]|~[01])*)?$",
      "description": "Canonical RFC6901 location in the owning Assessment; semantic validation must resolve it to a requirement node of this Test."
    },
    "variable_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_variable_refs"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_input_refs"
    },
    "observed_values": {
      "type": "array",
      "items": {
        "$ref": "result-types.schema.json#/$defs/typed_value"
      },
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_observed_values"
    },
    "expected_values": {
      "type": "array",
      "items": {
        "$ref": "result-types.schema.json#/$defs/typed_value"
      },
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_expected_values"
    },
    "comparison_results": {
      "type": "array",
      "items": {
        "description": "Explicit per-value comparison evidence, not a computed verdict.",
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "$ref": "result-types.schema.json#/$defs/technical_outcome"
          },
          "observed_value": {
            "$ref": "result-types.schema.json#/$defs/typed_value"
          },
          "expected_value": {
            "$ref": "result-types.schema.json#/$defs/typed_value"
          }
        },
        "additionalProperties": false
      },
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_comparison_results"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_reason"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_evidence_refs"
    },
    "observation_complete": {
      "type": "boolean",
      "description": "Explicit provider observation coverage for this field/record member. A reporting projection or omitted values never establishes absence."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error",
            "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_outcome"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reason",
          "evidence_refs"
        ],
        "properties": {
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1,
            "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_evidence_refs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "values_found": {
            "const": "none",
            "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/existence_cardinality"
          }
        },
        "required": [
          "values_found"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "operation"
              ]
            },
            {
              "required": [
                "values_matching"
              ]
            },
            {
              "required": [
                "expected_values"
              ]
            },
            {
              "required": [
                "value_match"
              ]
            },
            {
              "required": [
                "requirement_ref"
              ]
            },
            {
              "required": [
                "datatype"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "operation",
          "values_found",
          "values_matching",
          "requirement_ref",
          "expected_values"
        ]
      }
    }
  ],
  "x-doc-origin": "schema/field-result.schema.json",
  "x-doc-proposal": "Documentation-only proposal; specification_version and validation remain 0.4.0. This URI is not a release."
}
