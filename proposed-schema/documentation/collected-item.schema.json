{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-10-23",
  "title": "Draft canonical collected Item 0.4.0",
  "description": "Records one collected entity, its fields, and supporting provenance.",
  "type": "object",
  "required": [
    "id",
    "capability",
    "status",
    "fields",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/capability_name"
    },
    "status": {
      "enum": [
        "exists",
        "error",
        "not_collected"
      ]
    },
    "imported": {
      "type": "boolean"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "https://scap-ng.dev/schema/proposed/documentation/result-types.schema.json#/$defs/typed_value"
          },
          {
            "type": "array",
            "items": {
              "$ref": "https://scap-ng.dev/schema/proposed/documentation/result-types.schema.json#/$defs/typed_value"
            }
          }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_provenance"
    },
    "context": {
      "type": "object",
      "properties": {
        "name_resolution": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "source_field",
              "target_context_ref",
              "source_ref",
              "observed_at"
            ],
            "properties": {
              "source_field": {
                "type": "string",
                "minLength": 1
              },
              "target_context_ref": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "source_ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "structured",
                  "record"
                ],
                "description": "Kind of evidence location: text position, structured path, or record position.",
                "x-doc-status": "native-structure-derived"
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "path_language": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "value_index": {
                "type": "integer",
                "minimum": 0
              },
              "property": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "text",
                      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/context/properties/locators/items/properties/kind"
                    }
                  }
                },
                "then": {
                  "required": [
                    "line"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "path"
                        ]
                      },
                      {
                        "required": [
                          "path_language"
                        ]
                      },
                      {
                        "required": [
                          "index"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "structured",
                      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/context/properties/locators/items/properties/kind"
                    }
                  }
                },
                "then": {
                  "required": [
                    "path",
                    "path_language"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "line"
                        ]
                      },
                      {
                        "required": [
                          "column"
                        ]
                      },
                      {
                        "required": [
                          "index"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "record",
                      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/context/properties/locators/items/properties/kind"
                    }
                  }
                },
                "then": {
                  "required": [
                    "index"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "line"
                        ]
                      },
                      {
                        "required": [
                          "column"
                        ]
                      },
                      {
                        "required": [
                          "path"
                        ]
                      },
                      {
                        "required": [
                          "path_language"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "anyOf": [
                    {
                      "required": [
                        "value_index"
                      ]
                    },
                    {
                      "required": [
                        "property"
                      ]
                    }
                  ]
                },
                "then": {
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "kind": {
                      "const": "record",
                      "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/context/properties/locators/items/properties/kind"
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "origin": {
          "type": "object",
          "required": [
            "result_ref",
            "item_ref"
          ],
          "properties": {
            "result_ref": {
              "type": "string",
              "minLength": 1,
              "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_result_ref"
            },
            "item_ref": {
              "type": "string",
              "minLength": 1,
              "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_item_ref"
            },
            "source_execution_ref": {
              "type": "string",
              "minLength": 1,
              "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_source_execution_ref"
            },
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_source_digest"
            },
            "binding_set_id": {
              "type": "string",
              "minLength": 1
            },
            "source_completeness": {
              "$ref": "result-types.schema.json#/$defs/completeness"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "source_digest"
                ]
              },
              "then": {
                "required": [
                  "source_execution_ref",
                  "binding_set_id",
                  "source_completeness"
                ]
              }
            }
          ]
        },
        "import_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "result_ref",
              "item_ref"
            ],
            "properties": {
              "result_ref": {
                "type": "string",
                "minLength": 1,
                "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_result_ref"
              },
              "item_ref": {
                "type": "string",
                "minLength": 1,
                "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_item_ref"
              },
              "source_execution_ref": {
                "type": "string",
                "minLength": 1,
                "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_source_execution_ref"
              },
              "source_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_source_digest"
              },
              "binding_set_id": {
                "type": "string",
                "minLength": 1
              },
              "source_completeness": {
                "$ref": "result-types.schema.json#/$defs/completeness"
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "source_digest"
                  ]
                },
                "then": {
                  "required": [
                    "source_execution_ref",
                    "binding_set_id",
                    "source_completeness"
                  ]
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "imported"
        ],
        "properties": {
          "imported": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "context"
        ],
        "properties": {
          "context": {
            "required": [
              "origin"
            ]
          }
        }
      }
    }
  ],
  "x-doc-review": {
    "status": "editorially-approved",
    "source": "editorial-batch.json",
    "case": "23",
    "approval": "https://github.com/vanderpol/scap-ng/pull/41#issuecomment-6721578815"
  },
  "x-doc-origin": "schema/collected-item.schema.json",
  "x-doc-proposal": "Documentation-only proposal; specification_version and validation remain 0.4.0. This URI is not a release."
}
