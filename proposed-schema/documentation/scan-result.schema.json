{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposed/documentation/scan-result.schema.json",
  "x-scap-ng-version": "0.4.1",
  "x-last-modified": "2026-10-06",
  "title": "SCAP-NG Scan Result pre-release v0.4.1",
  "description": "Run-level index for one scanner execution. Detailed Benchmark and Assessment results remain normalized package members referenced by identity/path.",
  "type": "object",
  "required": [
    "scan_result"
  ],
  "properties": {
    "scan_result": {
      "type": "object",
      "required": [
        "result_schema_version",
        "run_id",
        "started_at",
        "scanner",
        "targets",
        "benchmark_results"
      ],
      "properties": {
        "result_schema_version": {
          "const": "0.4.1",
          "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_result_schema_version"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_run_id"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_started_at"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_completed_at"
        },
        "scanner": {
          "type": "object",
          "description": "Scanner identity metadata recorded for the scan.",
          "properties": {
            "app_guid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "format": "uuid",
              "description": "Stable scanner application/agent installation GUID for enterprise SIEM correlation; sourced from scanner/enterprise inventory, not inferred from hostname or content."
            }
          },
          "additionalProperties": true,
          "x-doc-status": "native-structure-derived"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Identifier of this scan target.",
                "x-doc-status": "native-structure-derived"
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Additional identifiers recorded for the scan target.",
                "x-doc-status": "native-structure-derived"
              },
              "hostname": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Hostname recorded for the target.",
                "x-doc-status": "native-structure-derived"
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Network addresses recorded for the target.",
                "x-doc-status": "native-structure-derived"
              },
              "machine_guid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "format": "uuid",
                "description": "Stable target-machine GUID supplied by authoritative system or enterprise asset inventory. This belongs to each target (a scan may have multiple targets); it is not the scanner application GUID, hostname, address, or per-scan session ID. Do not fabricate from hostnames or MAC addresses; omit when unavailable."
              }
            },
            "additionalProperties": false
          },
          "description": "Target identity records associated with the scan.",
          "x-doc-status": "native-structure-derived"
        },
        "benchmark_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "benchmark_result_ref",
              "benchmark_id",
              "target_ref"
            ],
            "properties": {
              "benchmark_result_ref": {
                "type": "string",
                "minLength": 1,
                "description": "Reference to the Benchmark result.",
                "x-doc-status": "native-structure-derived"
              },
              "benchmark_id": {
                "type": "string",
                "minLength": 1,
                "description": "Identifier of the Benchmark evaluated for this entry.",
                "x-doc-status": "native-structure-derived"
              },
              "benchmark_version": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ],
                "description": "Benchmark version recorded for this entry.",
                "x-doc-status": "native-structure-derived"
              },
              "target_ref": {
                "type": "string",
                "minLength": 1,
                "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_target_ref"
              },
              "profile_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Profile identifier recorded for this Benchmark evaluation.",
                "x-doc-status": "native-structure-derived"
              },
              "tailoring_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Tailoring identifier recorded for this Benchmark evaluation.",
                "x-doc-status": "native-structure-derived"
              },
              "summary": {
                "type": "object",
                "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/benchmark-result.schema.json#/properties/benchmark_result/properties/summary"
              }
            },
            "additionalProperties": false
          },
          "description": "Benchmark-result entries associated with the scan.",
          "x-doc-status": "native-structure-derived"
        },
        "assessment_result_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Assessment-result references associated with the scan.",
          "x-doc-status": "native-structure-derived"
        },
        "signature_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Signature status recorded for the scan result.",
          "x-doc-status": "native-structure-derived"
        },
        "scan_session_guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid",
          "description": "Globally unique scan/session correlation identifier, newly generated once per scan session and shared by all result events belonging to that session. This is distinct from the existing run_id and from any compliance or evidence identity. Canonical lowercase hyphenated UUID; it must never be regenerated per Rule/Assessment event."
        }
      },
      "additionalProperties": false,
      "description": "Scan-level scanner and target metadata with references to evaluation results.",
      "x-doc-status": "native-structure-derived"
    }
  },
  "additionalProperties": false,
  "x-doc-origin": "schema/scan-result.schema.json",
  "x-doc-proposal": "Documentation-only proposal; specification_version and validation remain 0.4.1. This URI is not a release."
}
