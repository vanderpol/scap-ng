{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposed/documentation/item-materialization.schema.json",
  "x-scap-ng-version": "0.4.1",
  "x-last-modified": "2026-10-06",
  "type": "object",
  "required": [
    "scope",
    "available_count",
    "included_count",
    "omitted_count",
    "consumed_item_refs",
    "collections"
  ],
  "properties": {
    "scope": {
      "enum": [
        "all",
        "consumed"
      ]
    },
    "available_count": {
      "type": "integer",
      "minimum": 0
    },
    "included_count": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0
    },
    "consumed_item_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "References to consumed Items identified by this materialization record.",
      "x-doc-status": "native-structure-derived"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_ref",
          "available_count",
          "included_count",
          "omitted_count"
        ],
        "properties": {
          "object_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Object reference associated with this materialization entry.",
            "x-doc-status": "native-structure-derived"
          },
          "available_count": {
            "type": "integer",
            "minimum": 0
          },
          "included_count": {
            "type": "integer",
            "minimum": 0
          },
          "omitted_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "description": "Per-collection entries describing the Item materialization.",
      "x-doc-status": "native-structure-derived"
    }
  },
  "additionalProperties": false,
  "x-doc-origin": "schema/item-materialization.schema.json",
  "x-doc-proposal": "Documentation-only proposal; specification_version and validation remain 0.4.1. This URI is not a release.",
  "description": "Record of which available Items are included in the result and which are omitted.",
  "x-doc-status": "native-structure-derived"
}
