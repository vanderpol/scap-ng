{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposed/documentation/item-report.schema.json",
  "x-scap-ng-version": "0.4.1",
  "x-last-modified": "2026-10-23",
  "title": "Draft derived Item report 0.4.1",
  "description": "An explicitly marked projection of evaluated/redacted canonical Items. Not a replacement Assessment Result.",
  "type": "object",
  "required": [
    "item_report"
  ],
  "additionalProperties": false,
  "properties": {
    "item_report": {
      "type": "object",
      "required": [
        "kind",
        "source_execution_ref",
        "source_completeness",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "reported_elements_projection",
          "description": "Identifies a projection of the requested reported elements.",
          "x-doc-status": "native-structure-derived"
        },
        "source_execution_ref": {
          "type": "string",
          "minLength": 1,
          "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_source_execution_ref"
        },
        "source_completeness": {
          "type": "object",
          "required": [
            "logical_complete",
            "population_complete",
            "evidence_complete"
          ],
          "properties": {
            "logical_complete": {
              "type": "boolean"
            },
            "population_complete": {
              "type": "boolean"
            },
            "evidence_complete": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "description": "Completeness information copied from the source result.",
          "x-doc-status": "native-structure-derived"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "selection"
            ],
            "properties": {
              "item": {
                "type": "object",
                "required": [
                  "id",
                  "capability",
                  "status",
                  "fields",
                  "provenance"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/id"
                  },
                  "capability": {
                    "type": "string",
                    "minLength": 1,
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/capability_name"
                  },
                  "status": {
                    "enum": [
                      "exists",
                      "error",
                      "not_collected"
                    ],
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/status"
                  },
                  "imported": {
                    "type": "boolean",
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/imported"
                  },
                  "provenance": {
                    "type": "object",
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/assessment-language.schema.json#/$defs/documentation_terms/$defs/report_provenance"
                  },
                  "context": {
                    "type": "object",
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/context"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "$ref": "https://scap-ng.dev/schema/proposed/documentation/result-types.schema.json#/$defs/typed_value"
                        },
                        {
                          "type": "array",
                          "items": {
                            "$ref": "https://scap-ng.dev/schema/proposed/documentation/result-types.schema.json#/$defs/typed_value"
                          }
                        }
                      ]
                    },
                    "x-doc-description-ref": "https://scap-ng.dev/schema/proposed/documentation/collected-item.schema.json#/properties/fields"
                  }
                },
                "additionalProperties": false,
                "description": "Projected collected Item included in the report.",
                "x-doc-status": "native-structure-derived"
              },
              "selection": {
                "type": "object",
                "required": [
                  "omitted_elements",
                  "unavailable_elements",
                  "retained_required_elements"
                ],
                "properties": {
                  "omitted_elements": {
                    "$ref": "#/$defs/names"
                  },
                  "unavailable_elements": {
                    "$ref": "#/$defs/names"
                  },
                  "retained_required_elements": {
                    "$ref": "#/$defs/names"
                  }
                },
                "additionalProperties": false,
                "description": "Metadata describing the selection of elements for this Item projection.",
                "x-doc-status": "native-structure-derived"
              }
            },
            "additionalProperties": false
          },
          "description": "Item projections included in this report.",
          "x-doc-status": "native-structure-derived"
        }
      },
      "additionalProperties": false,
      "description": "Projection of evaluated and redacted Items selected for reporting.",
      "x-doc-status": "native-structure-derived"
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "List of distinct, nonempty element names.",
      "x-doc-status": "native-structure-derived"
    }
  },
  "x-doc-origin": "schema/item-report.schema.json",
  "x-doc-proposal": "Documentation-only proposal; specification_version and validation remain 0.4.1. This URI is not a release."
}
