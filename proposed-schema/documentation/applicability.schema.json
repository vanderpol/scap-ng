{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposed/documentation/applicability.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-10-06",
  "title": "SCAP-NG Applicability Catalog v0.4.0",
  "type": "object",
  "required": [
    "applicability"
  ],
  "properties": {
    "applicability": {
      "type": "object",
      "required": [
        "id",
        "conditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Applicability declaration identifier.",
          "x-doc-status": "native-structure-derived"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "assessment"
            ],
            "properties": {
              "assessment": {
                "type": "string",
                "minLength": 1,
                "description": "Assessment reference used for this applicability condition.",
                "x-doc-status": "native-structure-derived"
              }
            },
            "additionalProperties": false
          },
          "description": "Map of condition names to their Assessment references.",
          "x-doc-status": "native-structure-derived"
        }
      },
      "additionalProperties": false,
      "description": "Named applicability conditions and their evaluation expression.",
      "x-doc-status": "native-structure-derived"
    }
  },
  "additionalProperties": false,
  "x-doc-origin": "schema/applicability.schema.json",
  "x-doc-proposal": "Documentation-only proposal; specification_version and validation remain 0.4.0. This URI is not a release."
}
