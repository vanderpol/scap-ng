  "$id": "https://scap-ng.dev/schema/proposed/documentation/assessment-result.schema.json",
  "x-scap-ng-version": "0.4.1",
  "x-last-modified": "2026-10-22",
  "title": "SCAP-NG Assessment Result draft v0.4.1 strawman",
