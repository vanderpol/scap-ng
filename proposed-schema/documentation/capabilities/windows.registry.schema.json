  "$defs": {
    "meanings": {
      "properties": {
        "hive": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "hive",
            "native_name": "hive",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='hive']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Registry hive containing the key.\n\nThe hive that the registry key belongs to.\n\nThis is restricted to a specific set of values: HKEY_CLASSES_ROOT, HKEY_CURRENT_CONFIG, HKEY_CURRENT_USER, HKEY_CURRENT_USER_LOCAL_SETTINGS, HKEY_LOCAL_MACHINE, and HKEY_USERS.\n\nThis is restricted to a specific set of values: HKEY_CLASSES_ROOT, HKEY_CURRENT_CONFIG, HKEY_CURRENT_USER, HKEY_CURRENT_USER_LOCAL_SETTINGS,HKEY_LOCAL_MACHINE, and HKEY_USERS.",
          "x-doc-datatypes": [
            "string"
          ],
          "x-doc-values": [
            "classes_root",
            "current_config",
            "current_user",
            "current_user_local_settings",
            "local_machine",
            "users"
          ]
        },
        "key": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "key",
            "native_name": "key",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='key']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Key path relative to the hive.\n\nThis element describes a registry key to be gathered.\n\n`key` describes a registry key to be collected.\n\nA .* pattern match says to collect every key under a given hive.\n\nThis element describes a registry key to be tested.",
          "x-doc-datatypes": [
            "string"
          ]
        },
        "name": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "name",
            "native_name": "name",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='name']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Registry value name.\n\nThis element describes the name of a registry key.\n\n`name` describes the name assigned to a value associated with a specific registry key.\n\nA .* pattern match says to collect every name under a given hive/key.\n\nThis element describes the name of a value of a registry key.",
          "x-doc-datatypes": [
            "string"
          ]
        },
        "last_write_time": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "last_write_time",
            "native_name": "last_write_time",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='last_write_time']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Last recorded write time for the key.\n\nThe last time that the key or any of its value entries were modified.\n\nSee the RegQueryInfoKey function lpftLastWriteTime.",
          "x-doc-datatypes": [
            "integer"
          ]
        },
        "type": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "type",
            "native_name": "type",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='type']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Native registry value kind.\n\nSpecifies the type of data stored by the registry key.\n\n`type` allows a test to be written against the registy type associated with the specified registry key(s).",
          "x-doc-datatypes": [
            "string"
          ],
          "x-doc-values": [
            "binary",
            "dword",
            "dword_big_endian",
            "expand_string",
            "link",
            "multi_string",
            "none",
            "qword",
            "string",
            "resource_list",
            "full_resource_descriptor",
            "resource_requirements_list"
          ]
        },
        "value": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "value",
            "native_name": "value",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='value']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Data stored in the registry value.\n\n`value` holds the actual value of the specified registry key.\n\nThe representation of the value as well as the associated datatype attribute depends on type of data stored in the registry key.\n\nDWORD and QWORD values represnt unsigned 32-bit and 64-bit integers, respectively.\n\n`value` allows a test to be written against the value held within the specified registry key(s).\n\nThis allows tools performing the evaluation to know how to perform less than and greater than operations correctly.",
          "x-doc-datatypes": [
            "string",
            "integer",
            "binary",
            "version"
          ]
        },
        "expanded_value": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "registry_state",
            "field": "expanded_value",
            "native_name": "expanded_value",
            "xpath": "/xs:schema/xs:element[@name='registry_state']//xs:element[@name='expanded_value']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "native-mapping-reviewed",
          "description": "Registry string after environment-variable expansion.\n\nFor registry values of type REG_EXPAND_SZ, this field contains the expanded value.",
          "x-doc-datatypes": [
            "string"
          ]
        }
      }
    },
