            }
          },
          "x-doc-status": "source-meaning-reviewed",
          "description": "Minimum password length.\n\nAlternate Name: \"Minimum password length\".\n\nSpecifies the minimum allowable password length.\n\nValid values for this element are zero through PWLEN.",
          "x-doc-datatypes": [
            "integer"
          ]
        },
