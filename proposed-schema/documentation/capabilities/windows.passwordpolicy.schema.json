            }
          },
          "x-doc-status": "source-meaning-reviewed",
          "description": "Maximum password age.\n\nAlternate Name: \"Maximum password age\".\n\nA value of TIMEQ_FOREVER (max DWORD value, 4294967295) indicates that the password never expires.\n\nThe minimum valid value for this element is ONE_DAY (86400).\n\nSee the USER_MODALS_INFO_0 structure returned by a call to NetUserModalsGet().",
          "x-doc-datatypes": [
            "integer"
          ]
        },
        "min_passwd_age": {
          "x-doc-source": {
            "schema": "windows-definitions-schema.xsd",
            "element": "passwordpolicy_state",
            "field": "min_passwd_age",
            "native_name": "min_passwd_age",
            "xpath": "/xs:schema/xs:element[@name='passwordpolicy_state']//xs:element[@name='min_passwd_age']/xs:annotation/xs:documentation",
            "xpath_namespace": {
              "xs": "http://www.w3.org/2001/XMLSchema"
            }
          },
          "x-doc-status": "source-meaning-reviewed",
          "description": "Minimum password age.\n\nAlternate Name: \"Minimum password age\".\n\nA value of zero indicates that no delay is required between password updates.",
          "x-doc-datatypes": [
            "integer"
          ]
        },
