{
  "status": "experimental",
  "source_release": "2.5",
  "scope": "Three independent checks with complete typed fixture populations. No vSphere collector or Rule-level authority assertion.",
  "tests": {
    "account-lock-threshold-test": {
      "stig_id": "ESXI-80-000005",
      "check_marker": "value other than \"3\"",
      "observed_field": "advanced_setting_value",
      "datatype": "integer",
      "vectors": {
        "below": {"values": [2], "outcome": "false"},
        "at": {"values": [3], "outcome": "true"},
        "above": {"values": [4], "outcome": "false"},
        "empty": {"values": [], "outcome": "false"}
      }
    },
    "password-history-test": {
      "stig_id": "ESXI-80-000043",
      "check_marker": "5 or greater",
      "observed_field": "advanced_setting_value",
      "datatype": "integer",
      "vectors": {
        "below": {"values": [4], "outcome": "false"},
        "at": {"values": [5], "outcome": "true"},
        "above": {"values": [6], "outcome": "true"},
        "empty": {"values": [], "outcome": "false"}
      }
    },
    "dcui-shell-access-test": {
      "stig_id": "ESXI-80-000249",
      "check_marker": "shell access is not disabled for the dcui account",
      "observed_field": "shell_access_enabled",
      "datatype": "boolean",
      "vectors": {
        "enabled": {"values": [true], "outcome": "false"},
        "disabled": {"values": [false], "outcome": "true"},
        "empty": {"values": [], "outcome": "false"}
      }
    }
  }
}
