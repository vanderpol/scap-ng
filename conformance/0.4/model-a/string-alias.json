{
  "assessment": {
    "id": "string-alias-assessment",
    "version": 1,
    "assessment_title": "string-alias",
    "mode": "automated",
    "class": "miscellaneous",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "variables": {
      "source-variable": {
        "kind": "constant",
        "datatype": "string",
        "expression": {
          "literal": [
            "a",
            "a",
            "b"
          ]
        }
      },
      "alias-variable": {
        "kind": "local",
        "datatype": "string",
        "expression": {
          "variable": "source-variable"
        }
      }
    },
    "tests": {
      "values-test": {
        "test_title": "string-alias",
        "capability": "variable.value",
        "variable": "alias-variable",
        "reported_elements": "all",
        "require": {
          "item_requirement": {
            "items_found": "one_or_more",
            "items_satisfying": "every"
          },
          "field_requirement": {
            "values_found": "one_or_more",
            "values_matching": "one_or_more"
          },
          "fields": {
            "value": {
              "datatype": "string",
              "equals": "a"
            }
          }
        }
      }
    },
    "evaluate": {
      "test": "values-test"
    }
  }
}
