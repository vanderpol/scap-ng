    "variables": {
      "source-variable": {
        "kind": "constant",
        "expression": {
          "literal": "22"
        }
      },
      "empty-variable": {
        "kind": "constant",
        "expression": {
          "literal": {
            "datatype": "string",
            "value": []
          }
        }
      },
      "blank-variable": {
        "kind": "constant",
        "expression": {
          "literal": ""
        }
      },
      "match-variable": {
        "kind": "constant",
        "expression": {
          "literal": "22"
        }
      },
      "alias-variable": {
        "kind": "local",
        "expression": {
          "variable": "empty-variable"
        }
      },
      "count-variable": {
        "kind": "local",
        "expression": {
          "count": {
            "variable": "empty-variable"
          }
        }
      },
      "unique-variable": {
        "kind": "local",
        "expression": {
          "unique": {
            "variable": "empty-variable"
          }
        }
      },
      "concat-variable": {
        "kind": "local",
        "expression": {
          "concat": [
            {
              "literal": "prefix"
            },
            {
              "variable": "empty-variable"
            }
          ]
        }
      },
      "shell-empty-variable": {
        "kind": "local",
        "expression": {
          "values": {
            "object": {
              "capability": "independent.shellcommand",
              "command": "printf '%s\\n' 'not-a-port'",
              "shell": "bash",
              "pattern": "^([0-9]+)$",
              "error_if_exit_status_not_0": true,
              "error_if_stderr_exists": true
            },
            "field": "subexpression"
          }
        }
      },
      "shell-match-variable": {
        "kind": "local",
        "expression": {
          "values": {
            "object": {
              "capability": "independent.shellcommand",
              "command": "printf '%s\\n' '22'",
              "shell": "bash",
              "pattern": "^([0-9]+)$",
              "error_if_exit_status_not_0": true,
              "error_if_stderr_exists": true
            },
            "field": "subexpression"
          }
        }
      },
      "shell-concat-variable": {
        "kind": "local",
        "expression": {
          "unique": {
            "concat": [
              {
                "literal": ""
              },
              {
                "variable": "shell-empty-variable"
              }
            ]
          }
        }
      }
