<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:oval-def="http://oval.mitre.org/XMLSchema/oval-definitions-5"
           xmlns:ind-def="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent"
           xmlns:unix-def="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix"
           xmlns:linux-def="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
  <!--
    Round-trip research aggregate schema.
    The imported XSDs are authoritative OVAL 5.12.3 files from the pinned
    OVAL-Community/OVAL v5.12.3 checkout. This wrapper adds no semantics.
  -->
  <xs:import schemaLocation="oval-definitions-schema.xsd"
             namespace="http://oval.mitre.org/XMLSchema/oval-definitions-5"/>
  <xs:import schemaLocation="independent-definitions-schema.xsd"
             namespace="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent"/>
  <xs:import schemaLocation="unix-definitions-schema.xsd"
             namespace="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix"/>
  <xs:import schemaLocation="linux-definitions-schema.xsd"
             namespace="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux"/>
</xs:schema>
