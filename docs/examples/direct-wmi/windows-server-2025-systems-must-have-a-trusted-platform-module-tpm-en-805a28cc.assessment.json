                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "and": [
        {
          "test": "tpm-isenabled-initialvalue-equals-true-da3740ba-test"
        },
        {
          "test": "tpm-isactivated-initialvalue-equals-true-973cabc8-test"
        },
        {
          "test": "tpm-isowned-initialvalue-equals-true-fbf8e11d-test"
        }
      ]
    }
  }
