{
  "assessment": {
    "id": "windows-server-2025-must-prevent-the-display-of-slide-shows-on-the-loc-da1e140a-assessment",
    "version": 1,
    "assessment_title": "Windows Server 2025 must prevent the display of slide shows on the lock screen.",
    "mode": "automated",
    "class": "compliance",
    "purpose": "assessment",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "tests": {
      "verifies-prevent-enabling-lock-screen-slide-show-is-set-to-enabled-a63c69f0-test": {
        "test_title": "Verifies 'Prevent enabling lock screen slide show' is set to 'Enabled'",
        "capability": "windows.registry",
        "object": {
          "hive": {
            "equals": "local_machine"
          },
          "key": {
            "equals": "SOFTWARE\\Policies\\Microsoft\\Windows\\Personalization"
          },
          "name": {
            "equals": "NoLockScreenSlideshow"
          }
        },
        "require": {
          "items_found": "one_or_more",
          "items_satisfying": "every",
          "and": [
            {
              "fields": {
                "type": {
                  "equals": "dword",
                  "values_found": "one_or_more",
                  "values_matching": "every"
                }
              }
            },
            {
              "fields": {
                "value": {
                  "equals": 1,
                  "datatype": "integer",
                  "values_found": "one_or_more",
                  "values_matching": "every"
                }
              }
            }
          ]
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "verifies-prevent-enabling-lock-screen-slide-show-is-set-to-enabled-a63c69f0-test"
    }
  }
}
