{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/review/issue43-phase-a/capabilities/unix.file.schema.json",
  "$comment": "Review-only annotation library. No datatype/tag tightening or runtime semantics.",
  "$defs": {
    "field_meanings": {
      "properties": {
        "full_path": {
          "description": "Full path of the collected entry."
        },
        "directory": {
          "description": "Directory component of the collected path."
        },
        "name": {
          "description": "Entry name without the directory."
        },
        "type": {
          "description": "Kind of filesystem entry."
        },
        "owner_uid": {
          "description": "Numeric user ID of the owner."
        },
        "owner_gid": {
          "description": "Numeric group ID of the owning group."
        },
        "size": {
          "description": "File size."
        },
        "access_time": {
          "description": "Last data-access time."
        },
        "change_time": {
          "description": "Last inode-status change, not creation time."
        },
        "modify_time": {
          "description": "Last content-modification time."
        },
        "setuid": {
          "description": "Set-user-ID permission flag."
        },
        "setgid": {
          "description": "Set-group-ID permission flag."
        },
        "sticky": {
          "description": "Sticky/restricted-deletion flag."
        },
        "owner_read": {
          "description": "Whether the owner-read permission bit is set.\n\nPermission flags are bits, not an effective-access guarantee; directory-specific read/write/search interpretation remains unspecified."
        },
        "owner_write": {
          "description": "Whether the owner-write permission bit is set."
        },
        "owner_execute": {
          "description": "Whether the owner-execute/search permission bit is set."
        },
        "group_read": {
          "description": "Whether the group-read permission bit is set."
        },
        "group_write": {
          "description": "Whether the group-write permission bit is set."
        },
        "group_execute": {
          "description": "Whether the group-execute/search permission bit is set."
        },
        "other_read": {
          "description": "Whether the other-read permission bit is set."
        },
        "other_write": {
          "description": "Whether the other-write permission bit is set."
        },
        "other_execute": {
          "description": "Whether the other-execute/search permission bit is set."
        },
        "has_extended_acl": {
          "description": "Whether ACL permissions differ from standard UNIX permissions."
        }
      },
      "description": "Permission bits do not establish effective access; link/target metadata, cycle handling and mount classification are not yet specified."
    },
