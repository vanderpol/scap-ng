{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-11-12",
  "title": "Native Variable declarations and retained OVAL transformations",
  "description": "Declare typed local or constant Variables from literal data, other Variables, collected Object fields, or explicit recursive transformations. Active 0.4 forms preserve source operand order, collection multiplicity, empty values, and evaluation status; datatype compatibility and status propagation are checked separately by semantic validation or a qualified runtime.",
  "x-scap-ng-owner-decision": "https://github.com/vanderpol/scap-ng-tools/issues/48",
  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/declaration",
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "kind",
        "datatype",
        "expression"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "constant"
          ],
          "title": "Variable kind",
          "description": "Use `local` for a derived value or `constant` for a literal declaration."
        },
        "datatype": {
          "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/capability-common.schema.json#/$defs/native_datatype",
          "title": "Variable datatype",
          "description": "Datatype promised by this Variable. The expression must produce compatible values."
        },
        "expression": {
          "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
          "title": "Variable expression",
          "description": "Expression that supplies this Variable’s values."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "title": "Authoring title",
          "description": "Optional author-facing title for this Variable."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            }
          },
          "then": {
            "properties": {
              "expression": {
                "type": "object",
                "required": [
                  "literal"
                ],
                "properties": {
                  "literal": {
                    "oneOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "datatype",
                          "value"
                        ],
                        "properties": {
                          "datatype": {
                            "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/capability-common.schema.json#/$defs/native_datatype",
                            "title": "Literal datatype",
                            "description": "Datatype of the supplied literal or record."
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "array",
                              "object"
                            ],
                            "title": "Literal payload",
                            "description": "Payload for the selected datatype; record data uses an object and scalar datatypes use scalar/list data."
                          }
                        },
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "datatype": {
                                  "const": "record"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": "object",
                                  "title": "Literal payload",
                                  "description": "Record data for `record`; scalar or ordered list data for other datatypes."
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "value": {
                                  "anyOf": [
                                    {
                                      "type": [
                                        "string",
                                        "number",
                                        "boolean"
                                      ]
                                    },
                                    {
                                      "type": "array",
                                      "items": {
                                        "type": [
                                          "string",
                                          "number",
                                          "boolean"
                                        ]
                                      }
                                    }
                                  ],
                                  "title": "Literal payload",
                                  "description": "Scalar or ordered list data for the selected datatype."
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "title": "Literal value",
                    "description": "A scalar, ordered list, or explicitly typed value. Use the typed form when the datatype matters; lists preserve their supplied order and duplicates.",
                    "examples": [
                      {
                        "datatype": "string",
                        "value": "example"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "arithmetic"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "integer",
                  "float"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "substring"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "split"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "begin"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "end"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "count"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "integer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "concat"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "regex_capture"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "unique"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "merge"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "datatype",
                    "value"
                  ],
                  "properties": {
                    "datatype": {
                      "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/capability-common.schema.json#/$defs/native_datatype",
                      "title": "Literal datatype",
                      "description": "Datatype of the supplied literal or record."
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object"
                      ],
                      "title": "Literal payload",
                      "description": "Payload for the selected datatype; record data uses an object and scalar datatypes use scalar/list data."
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "datatype": {
                            "const": "record"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object",
                            "title": "Literal payload",
                            "description": "Record data for `record`; scalar or ordered list data for other datatypes."
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean"
                                ]
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean"
                                  ]
                                }
                              }
                            ],
                            "title": "Literal payload",
                            "description": "Scalar or ordered list data for the selected datatype."
                          }
                        }
                      }
                    }
                  ]
                }
              ],
              "title": "Literal value",
              "description": "A scalar, ordered list, or explicitly typed value. Use the typed form when the datatype matters; lists preserve their supplied order and duplicates.",
              "examples": [
                {
                  "datatype": "string",
                  "value": "example"
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Literal expression",
          "description": "Produce literal scalar, list, or typed data."
        },
        {
          "type": "object",
          "required": [
            "variable"
          ],
          "properties": {
            "variable": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-variable$",
              "maxLength": 64,
              "title": "Variable reference",
              "description": "Reference another named Variable. The referenced Variable supplies values and evaluation status.",
              "examples": [
                "host-name-variable"
              ]
            }
          },
          "additionalProperties": false,
          "title": "Variable reference expression",
          "description": "Use values from another Variable."
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "object",
              "required": [
                "object",
                "field"
              ],
              "properties": {
                "object": {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/capability-common.schema.json#/$defs/object_use",
                  "title": "Collection Object",
                  "description": "Object source whose collected Items supply the field values."
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Collected field",
                  "description": "Name of the collected field to read from each collected Item."
                }
              },
              "additionalProperties": false,
              "title": "Collected field values",
              "description": "Read the selected field from the collected Object. Field availability, multiplicity, and collection status are semantic/runtime concerns.",
              "examples": [
                {
                  "object": {
                    "object_ref": "server-object"
                  },
                  "field": "hostname"
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Collected values expression",
          "description": "Produce values from a collected Object field."
        },
        {
          "type": "object",
          "required": [
            "concat"
          ],
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression"
              },
              "title": "Concatenated components",
              "description": "Concatenate two or more components in order. Multiple values produce the Cartesian product of component values. Components follow inherited source casting rules when a string conversion is required; incompatible values produce an error. A missing or nonexistent component yields the inherited source status; Error, Incomplete, Not Collected, and Not Applicable statuses are not silently converted to strings.",
              "examples": [
                [
                  {
                    "literal": "https://"
                  },
                  {
                    "variable": "host-name-variable"
                  },
                  {
                    "literal": "/policy"
                  }
                ],
                [
                  {
                    "literal": [
                      "a",
                      "b"
                    ]
                  },
                  {
                    "literal": ".conf"
                  }
                ]
              ]
            }
          },
          "additionalProperties": false,
          "title": "Concatenation expression",
          "description": "Join two or more ordered expressions while retaining collection/status semantics."
        },
        {
          "type": "object",
          "required": [
            "regex_capture"
          ],
          "properties": {
            "regex_capture": {
              "type": "object",
              "required": [
                "pattern",
                "value"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "title": "Capture pattern",
                  "description": "Regular expression containing the capture group to return."
                },
                "value": {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
                  "title": "Input expression",
                  "description": "Expression producing the string value(s) to search. Each value is processed independently."
                }
              },
              "additionalProperties": false,
              "title": "Regular-expression capture",
              "description": "Capture text from each input string using the first capturing group. The source regex dialect and first-match behavior are retained; inputs with no capture group or no match produce an empty string under the inherited function contract.",
              "examples": [
                {
                  "pattern": "^https://([^/]+)/",
                  "value": {
                    "variable": "url-variable"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Regex capture expression",
          "description": "Extract the first capture from each input string."
        },
        {
          "type": "object",
          "required": [
            "unique"
          ],
          "properties": {
            "unique": {
              "title": "Unique values or ordered populations",
              "description": "Remove duplicate scalar values from one expression or from multiple ordered component populations. Multiple components are flattened in source order before first-occurrence deduplication; duplicates and diagnostic statuses are preserved. Record data is not a supported transformation operand.",
              "examples": [
                {
                  "values": {
                    "object": {
                      "object_ref": "server-object"
                    },
                    "field": "tag"
                  }
                },
                {
                  "unique": [
                    {
                      "literal": [
                        "a",
                        "a"
                      ]
                    },
                    {
                      "literal": [
                        "b",
                        "a"
                      ]
                    }
                  ]
                }
              ],
              "oneOf": [
                {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "Remove duplicate scalar values.",
          "title": "Unique expression"
        },
        {
          "type": "object",
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
              "title": "Counted values",
              "description": "Evaluate the nested expression and return the number of values it produces as one integer. Count each produced value, including duplicates; do not count unique values unless the author explicitly wraps the input with unique. An empty, successfully evaluated collection produces zero. Missing, incomplete, not-collected, error, and other non-success states must retain the native status contract instead of silently becoming zero. Runtime equivalence is subject to independent conformance tests.",
              "examples": [
                {
                  "literal": [
                    "one",
                    "one",
                    "two"
                  ]
                },
                {
                  "values": {
                    "object": {
                      "object_ref": "example-object"
                    },
                    "field": "name"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Count expression",
          "description": "Return the cardinality of values from a nested Variable expression as one integer. Duplicates contribute to the count; non-success statuses are not coerced to zero."
        },
        {
          "type": "object",
          "required": [
            "split"
          ],
          "properties": {
            "split": {
              "type": "object",
              "required": [
                "delimiter",
                "value"
              ],
              "properties": {
                "delimiter": {
                  "type": "string",
                  "title": "Delimiter",
                  "description": "Literal delimiter; an empty delimiter is literal, not a regular expression."
                },
                "value": {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
                  "title": "Input expression",
                  "description": "Expression producing string values to split independently."
                }
              },
              "additionalProperties": false,
              "title": "Split values",
              "description": "Split each input string on the explicit literal delimiter. Preserve leading, trailing, and adjacent empty parts, duplicates, collection order, and diagnostic statuses.",
              "examples": [
                {
                  "delimiter": ",",
                  "value": {
                    "literal": "a,,b"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Split values expression",
          "description": "Split each input string on the explicit literal delimiter. Preserve leading, trailing, and adjacent empty parts, duplicates, collection order, and diagnostic statuses."
        },
        {
          "type": "object",
          "required": [
            "substring"
          ],
          "properties": {
            "substring": {
              "type": "object",
              "required": [
                "substring_start",
                "substring_length",
                "value"
              ],
              "properties": {
                "substring_start": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647,
                  "title": "Start",
                  "description": "Signed 32-bit OVAL start position; evaluation applies the source one-based boundary rules."
                },
                "substring_length": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647,
                  "title": "Length",
                  "description": "Signed 32-bit length; negative or oversized lengths retain the source remainder behavior."
                },
                "value": {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
                  "title": "Input expression",
                  "description": "Expression producing string values to slice independently."
                }
              },
              "additionalProperties": false,
              "title": "Substring values",
              "description": "Extract a substring from each input string using explicit signed 32-bit source options. Out-of-range and diagnostic outcomes remain errors/statuses; no defaults are inferred.",
              "examples": [
                {
                  "substring_start": 1,
                  "substring_length": 3,
                  "value": {
                    "literal": "abcdef"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Substring values expression",
          "description": "Extract a substring from each input string using explicit signed 32-bit source options. Out-of-range and diagnostic outcomes remain errors/statuses; no defaults are inferred."
        },
        {
          "type": "object",
          "required": [
            "arithmetic"
          ],
          "properties": {
            "arithmetic": {
              "type": "object",
              "required": [
                "arithmetic_operation",
                "values"
              ],
              "properties": {
                "arithmetic_operation": {
                  "enum": [
                    "add",
                    "multiply"
                  ],
                  "title": "Arithmetic operation",
                  "description": "Numeric addition or multiplication; no boolean or string coercion."
                },
                "values": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression"
                  },
                  "title": "Numeric operands",
                  "description": "Two or more ordered numeric expressions. Multiple-valued operands use the source Cartesian-product semantics and retain multiplicity/status."
                }
              },
              "additionalProperties": false,
              "title": "Arithmetic values",
              "description": "Add or multiply two or more numeric populations over the source Cartesian product. Integer-only inputs produce integers; any float input produces floats. Invalid types and diagnostic populations are not coerced.",
              "examples": [
                {
                  "arithmetic_operation": "add",
                  "values": [
                    {
                      "literal": 1
                    },
                    {
                      "literal": [
                        2,
                        3
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Arithmetic values expression",
          "description": "Add or multiply two or more numeric populations over the source Cartesian product. Integer-only inputs produce integers; any float input produces floats. Invalid types and diagnostic populations are not coerced."
        },
        {
          "type": "object",
          "required": [
            "begin"
          ],
          "properties": {
            "begin": {
              "type": "object",
              "required": [
                "character",
                "value"
              ],
              "properties": {
                "character": {
                  "type": "string",
                  "title": "Boundary character",
                  "description": "Explicit character used by the source begin operation."
                },
                "value": {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
                  "title": "Input expression",
                  "description": "Expression producing string values to test."
                }
              },
              "additionalProperties": false,
              "title": "Begin boundary",
              "description": "Retain the source begin-character transformation with one explicit input and character. Collection and status behavior remains source-defined and is not approximated by schema validation.",
              "examples": [
                {
                  "character": "/",
                  "value": {
                    "literal": "/etc"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Begin boundary expression",
          "description": "Retain the source begin-character transformation with one explicit input and character. Collection and status behavior remains source-defined and is not approximated by schema validation."
        },
        {
          "type": "object",
          "required": [
            "end"
          ],
          "properties": {
            "end": {
              "type": "object",
              "required": [
                "character",
                "value"
              ],
              "properties": {
                "character": {
                  "type": "string",
                  "title": "Boundary character",
                  "description": "Explicit character used by the source end operation."
                },
                "value": {
                  "$ref": "https://scap-ng.dev/schema/review/issue43-phase-a/variable-expression.schema.json#/$defs/expression",
                  "title": "Input expression",
                  "description": "Expression producing string values to test."
                }
              },
              "additionalProperties": false,
              "title": "End boundary",
              "description": "Retain the source end-character transformation with one explicit input and character. Collection and status behavior remains source-defined and is not approximated by schema validation.",
              "examples": [
                {
                  "character": "/",
                  "value": {
                    "literal": "/etc"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "End boundary expression",
          "description": "Retain the source end-character transformation with one explicit input and character. Collection and status behavior remains source-defined and is not approximated by schema validation."
        },
        {
          "type": "object",
          "required": [
            "merge"
          ],
          "properties": {
            "merge": {
              "type": "object",
              "required": [
                "delimiter",
                "sort",
                "order",
                "values"
              ],
              "properties": {
                "delimiter": {
                  "type": "string",
                  "title": "Join delimiter",
                  "description": "String inserted between adjacent values."
                },
                "sort": {
                  "enum": [
                    "document",
                    "lexical",
                    "numeric",
                    "natural"
                  ],
                  "title": "Sort mode",
