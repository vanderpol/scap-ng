{
  "assessment": {
    "id": "unix-file-research-assessment",
    "version": 1,
    "assessment_title": "unix.file proposed contract witness",
    "mode": "automated",
    "class": "compliance",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.1"
    },
    "tests": {
      "sample-test": {
        "test_title": "Controlled research fixture; no runtime qualification",
        "capability": "unix.file",
        "object": {
          "filepath": {
            "equals": "/scap-ng-fixture/file"
          },
          "filesystem": "all"
        },
        "require": {
          "item_requirement": {
            "items_found": "one_or_more",
            "items_satisfying": "every"
          },
          "field_requirement": {
            "values_found": "one_or_more",
            "values_matching": "every"
          },
          "fields": {
            "owner_uid": {
              "datatype": "integer",
              "equals": 0
            }
          }
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "sample-test"
    }
  }
}
