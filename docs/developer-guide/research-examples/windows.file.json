            "equals": "C:\\SCAPNGFixture\\file.exe"
          },
          "filesystem": "all"
        },
        "require": {
          "item_requirement": {
            "items_found": "one_or_more",
            "items_satisfying": "every"
          },
          "field_requirement": {
            "values_found": "one_or_more",
            "values_matching": "every"
          },
          "fields": {
            "size": {
              "datatype": "integer",
              "greater_than": 0
            }
          }
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "sample-test"
    }
  }
}
