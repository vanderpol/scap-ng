{
  "assessment": {
    "id": "independent-textfilecontent-research-assessment",
    "version": 1,
    "assessment_title": "independent.textfilecontent proposed contract witness",
    "mode": "automated",
    "class": "compliance",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "tests": {
      "sample-test": {
        "test_title": "Controlled research fixture; no runtime qualification",
        "capability": "independent.textfilecontent",
        "object": {
          "full_path": {
            "equals": "/scap-ng-fixture/config"
          },
          "pattern": {
            "matches_regex": "^setting=(.*)$"
          },
          "instance": {
            "equals": 1
          },
          "ignore_case": false,
          "multiline": true,
          "singleline": false,
          "item_creation": "all_object_elements_fullfilled"
        },
        "require": {
          "item_requirement": {
            "items_found": "one_or_more",
            "items_satisfying": "every"
          },
          "field_requirement": {
            "values_found": "one_or_more",
            "values_matching": "every"
          },
          "fields": {
            "subexpression": {
              "equals": "enabled"
            }
          }
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "sample-test"
    }
  }
}
