{
  "assessment": {
    "id": "independent-shellcommand-research-assessment",
    "version": 1,
    "assessment_title": "independent.shellcommand proposed contract witness",
    "mode": "automated",
    "class": "compliance",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "tests": {
      "sample-test": {
        "test_title": "Controlled research fixture; no runtime qualification",
        "capability": "independent.shellcommand",
        "object": {
          "shell": "sh",
          "command": "printf '%s\\n' example",
          "error_if_exit_status_not_0": true,
          "error_if_stderr_exists": true
        },
        "require": {
          "item_requirement": {
            "items_found": "one_or_more",
            "items_satisfying": "every"
          },
          "field_requirement": {
            "values_found": "one_or_more",
            "values_matching": "every"
          },
          "fields": {
            "exit_status": {
              "datatype": "integer",
              "equals": 0
            },
            "stdout_line": {
              "equals": "example"
            }
          }
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "sample-test"
    }
  }
}
