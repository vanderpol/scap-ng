{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/proposals/issue40/assessment.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-11-01",
  "title": "SCAP-NG Assessment v0.4.0 draft",
  "description": "Pre-alpha 0.4 Assessment single authoring grammar. Source conversion must emit this native grammar.",
  "type": "object",
  "required": [
    "assessment"
  ],
  "properties": {
    "assessment": {
      "type": "object",
      "required": [
        "id",
        "version",
        "assessment_title",
        "mode",
        "class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "assessment_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "automated"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "compliance",
            "vulnerability",
            "patch",
            "inventory",
            "miscellaneous"
          ]
        },
        "variables": {
          "type": "object",
          "description": "Named typed variables. Each variable declares its value type and supported expression form; unsupported function names, options, arities and incompatible derived types are invalid. Values are never supplied implicitly.",
          "additionalProperties": {
            "$ref": "https://scap-ng.dev/schema/v0.4.0/variable-expression.schema.json"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-variable$",
            "maxLength": 64
          }
        },
        "tests": {
          "type": "object",
          "description": "Named Tests. A capability defines its Test source shape: commonly an Object, but clean native capabilities MAY consume another first-class source such as a Variable directly.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "test_title",
              "capability",
              "require"
            ],
            "properties": {
              "test_title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reported_elements": {
                "$ref": "https://scap-ng.dev/schema/v0.4.0/reported-elements.schema.json",
                "default": "all",
                "x-scap-ng-authoring": {
                  "group": "reporting",
                  "hide_when_default": true,
                  "version": 1,
                  "control_id": "reported_elements",
                  "representation": "value",
                  "aggressive_preview": false,
                  "context": "automated_test",
                  "new_authoring_only": true,
                  "serialize_explicitly": true,
                  "preserve_overrides": true,
                  "authority": "https://github.com/vanderpol/scap-ng/issues/269"
                },
                "description": "Required in saved automated Tests. The editor may prefill and hide 'all', but must serialize it explicitly; this is not a scanner default.",
                "title": "Reported elements"
              },
              "capability": {
                "type": "string",
                "minLength": 1,
                "title": "Evidence collection capability",
                "description": "Identifies the native collector and its supported selector and result fields."
              },
              "object": {
                "$ref": "https://scap-ng.dev/schema/proposals/issue40/capability-common.schema.json#/$defs/object_use",
                "title": "Collection Object",
                "description": "Defines the evidence source and selectors; an inline Object inherits its Test capability."
              },
              "variable": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-variable$",
                "description": "Named Variable used as the native Test source where the capability supports variable.value."
              },
              "require": {
                "$ref": "https://scap-ng.dev/schema/proposals/issue40/assessment-language.schema.json#/$defs/test/properties/require",
                "title": "Required evidence conditions",
                "description": "Structured collected-Item population and field requirements; no legacy State wrapper or implicit field default."
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "capability": {
                      "not": {
                        "const": "independent.unknown"
                      }
                    }
                  },
                  "required": [
                    "capability"
                  ]
                },
                "then": {
                  "required": [
                    "reported_elements"
                  ]
                }
              },
              {
                "$ref": "https://scap-ng.dev/schema/proposals/issue40/assessment-language.schema.json#/$defs/test"
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "result"
                  ]
                },
                {
                  "required": [
                    "existence"
                  ]
                },
                {
                  "required": [
                    "match"
                  ]
                },
                {
                  "required": [
                    "state"
                  ]
                },
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "states_match"
                  ]
                },
                {
                  "required": [
                    "state_fields_require"
                  ]
                }
              ]
            }
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-test$",
            "maxLength": 64
          },
          "title": "Named automated Tests"
        },
        "evaluate": {
          "$ref": "https://scap-ng.dev/schema/proposals/issue40/expression.schema.json",
          "title": "Test result evaluation",
          "description": "Combines Test outcomes with OVAL-aligned Boolean operators."
        },
        "procedure": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "description": "Named typed input contracts declared by the Assessment. Policy-layer bindings are supplied by the referring Rule/Assessment selection, not hard-coded here.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "datatype",
              "cardinality",
              "required"
            ],
            "properties": {
              "datatype": {
                "$ref": "https://scap-ng.dev/schema/proposals/issue40/capability-common.schema.json#/$defs/native_datatype"
              },
              "cardinality": {
                "type": "string",
                "enum": [
                  "exactly_one",
                  "zero_or_one",
                  "one_or_more",
                  "zero_or_more"
                ],
                "description": "Sets how many values a supplied Input may contain."
              },
              "required": {
                "type": "boolean",
                "description": "Specifies whether this Input must be supplied."
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Human explanation of the expected input and its policy meaning; not an executable requirement."
              },
              "constraints": {
                "type": "object",
                "description": "Explicit constraints on supplied values. They do not supply a missing Input or change its cardinality.",
                "properties": {
                  "allowed": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "object"
                      ]
                    },
                    "description": "Explicit allowed values in the declared domain; no casts or defaults."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-input$",
            "maxLength": 64
          }
        },
        "evidence": {
          "type": "array",
          "description": "Publisher-authored evidence requirements/guidance for this Assessment. This is source policy metadata, not collected runtime evidence; observed evidence belongs in Assessment Results or referenced evidence artifacts."
        },
        "specification": {
          "type": "object",
          "description": "Specification identifier and version used by this Assessment. This pre-release identifier is provisional.",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "description": "Statically declared dependencies on other Assessments whose final Assessment truth/result may be consumed by this Assessment's evaluate expression. Keys are local aliases.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "assessment",
              "expected_version"
            ],
            "properties": {
              "assessment": {
                "type": "string",
                "minLength": 1,
                "description": "Logical Assessment ID in native 0.4 authoring; compiler resolves kind, identity, exact version and scope to a packaged reference.",
                "title": "Assessment"
              },
              "expected_id": {
                "type": "string",
                "minLength": 1,
                "description": "Transitional duplicate target identity for converted source; when present it SHALL match the resolved Assessment ID. Not required for native logical-ID authoring."
              },
              "expected_version": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "purpose": {
                "enum": [
                  "assessment",
                  "applicability"
                ],
                "description": "Optional context for invoking this dependency. It is not an intrinsic target property and does not provide an assessment default."
              }
            },
            "additionalProperties": false
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "applicability": {
          "oneOf": [
            {
              "$ref": "https://scap-ng.dev/schema/proposals/issue40/expression.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {},
        "references": {},
        "evidence_guidance": {},
        "shared_objects": {
          "type": "object",
          "description": "Assessment-scoped named Objects with meaningful reusable/referenceable acquisition identity. Private Objects are authored inline with their consumer.",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "https://scap-ng.dev/schema/proposals/issue40/capability-common.schema.json#/$defs/inline_object"
              },
              {
                "type": "object",
                "required": [
                  "object_title",
                  "capability"
                ],
                "properties": {
                  "object_title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-object$",
            "maxLength": 64
          },
          "title": "Shared collection Objects"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "$ref": "https://scap-ng.dev/schema/v0.4.0/manual-assessment.schema.json#/properties/assessment"
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "automated"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "specification",
              "tests",
              "evaluate"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "specification": {
                "properties": {
                  "id": {
                    "const": "scap-ng.pre-alpha.assessment"
                  },
                  "version": {
                    "const": "0.4.0"
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "procedure"
                  ]
                },
                {
                  "required": [
                    "response"
                  ]
                },
                {
                  "required": [
                    "references"
                  ]
                },
                {
                  "required": [
                    "evidence_guidance"
                  ]
                }
              ]
            }
          }
        }
      ],
      "description": "Automated Assessments contain Test-local typed predicates and Object/Set-operand Filters with no named State registry. Shared Objects retain explicit acquisition identity.",
      "title": "Assessment"
    }
  },
  "additionalProperties": false
}
