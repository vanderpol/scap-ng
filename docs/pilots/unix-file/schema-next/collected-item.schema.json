{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Review-only next-schema proposal. next is an unassigned version placeholder. Not installed; active 0.4.1 primitives are reused to isolate the proposed delta.",
  "$id": "https://scap-ng.dev/schema/next/collected-item.schema.json",
  "$ref": "https://scap-ng.dev/schema/v0.4.1/collected-item.schema.json",
  "allOf": [
    {
      "if": {
        "required": [
          "capability"
        ],
        "properties": {
          "capability": {
            "const": "unix.file"
          }
        }
      },
      "then": {
        "$ref": "https://scap-ng.dev/schema/next/capabilities/unix.file.schema.json#/$defs/item"
      }
    }
  ]
}
