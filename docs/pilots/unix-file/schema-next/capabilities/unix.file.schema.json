      "properties": {
        "filepath": {
          "description": "Full path of the selected entry."
        },
        "path": {
          "description": "Directory containing the selected entry."
        },
        "filename": {
          "description": "Entry name within the selected directory; null selects the directory itself."
        },
        "filesystem": {
          "description": "Filesystem scope: all, local, or the starting filesystem (same)."
        },
        "traversal": {
          "description": "Controls recursive searching through directories and symbolic links.",
          "properties": {
            "max_depth": {
              "description": "Maximum downward recursion depth; 0 includes only the starting directory."
            },
            "recurse": {
              "description": "Entry types to follow during recursion."
            }
          }
        }
      },
      "examples": [
        {
          "path": {
            "equals": "/example"
          },
          "filename": {
            "equals": "config"
          },
          "filesystem": "all",
          "traversal": {
            "max_depth": 1,
            "recurse": "directories"
          }
        }
      ]
