          "description": "Full path of the collected entry."
        },
        "directory": {
          "description": "Directory component of the collected path."
        },
        "name": {
          "description": "Entry name without the directory; directory-only representation is not yet specified."
        },
        "type": {
          "description": "Kind of filesystem entry; value labels are not yet specified."
        },
        "owner_uid": {
          "description": "Numeric user ID of the owner."
        },
        "owner_gid": {
          "description": "Numeric group ID of the owning group."
        },
        "size": {
          "description": "File size; unit is not yet specified."
        },
        "access_time": {
          "description": "Last data-access time; unit and resolution are not yet specified."
        },
        "change_time": {
          "description": "Last inode-status change, not creation time; unit and resolution are not yet specified."
        },
        "modify_time": {
          "description": "Last content-modification time; unit and resolution are not yet specified."
        },
        "setuid": {
          "description": "Set-user-ID permission flag."
        },
        "setgid": {
          "description": "Set-group-ID permission flag."
        },
        "sticky": {
          "description": "Sticky/restricted-deletion flag."
        },
        "owner_read": {
          "description": "Whether the owner-read permission bit is set."
        },
        "owner_write": {
          "description": "Whether the owner-write permission bit is set."
        },
        "owner_execute": {
          "description": "Whether the owner-execute/search permission bit is set."
        },
        "group_read": {
          "description": "Whether the group-read permission bit is set."
        },
        "group_write": {
          "description": "Whether the group-write permission bit is set."
        },
        "group_execute": {
          "description": "Whether the group-execute/search permission bit is set."
        },
        "other_read": {
          "description": "Whether the other-read permission bit is set."
        },
        "other_write": {
          "description": "Whether the other-write permission bit is set."
        },
        "other_execute": {
          "description": "Whether the other-execute/search permission bit is set."
        },
        "has_extended_acl": {
          "description": "Whether ACL permissions differ from standard UNIX permissions; unsupported-ACL handling is not yet specified."
        }
      }
    },
