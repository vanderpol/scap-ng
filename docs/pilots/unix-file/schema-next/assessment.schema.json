{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Review-only next-schema proposal. next is an unassigned version placeholder. Not installed; frozen 0.4 primitives are reused to isolate the proposed delta.",
  "$id": "https://scap-ng.dev/schema/next/assessment.schema.json",
  "$ref": "https://scap-ng.dev/schema/v0.4.0/assessment.schema.json",
  "properties": {
    "assessment": {
      "properties": {
        "tests": {
          "additionalProperties": {
            "if": {
              "required": [
                "capability"
              ],
              "properties": {
                "capability": {
                  "const": "unix.file"
                }
              }
            },
            "then": {
              "$ref": "https://scap-ng.dev/schema/next/capabilities/unix.file.schema.json#/$defs/test"
            }
          }
        }
      }
    }
  }
}
