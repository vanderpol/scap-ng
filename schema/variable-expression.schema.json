{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.4.0/variable-expression.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-11-03",
  "title": "Native Variable declarations, legacy forms and bounded function calls",
  "description": "Finite native vocabulary. Existing forms remain unchanged. The owner-directed pre-release amendment adds only arithmetic, substring and split with explicit options; it does not activate the broad canonical-call candidate or evaluate values.",
  "x-scap-ng-owner-decision": "https://github.com/vanderpol/scap-ng-tools/issues/14#issuecomment-6592397246",
  "$ref": "#/$defs/declaration",
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "kind",
        "datatype",
        "expression"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "constant"
          ]
        },
        "datatype": {
          "$ref": "capability-common.schema.json#/$defs/native_datatype"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            }
          },
          "then": {
            "properties": {
              "expression": {
                "type": "object",
                "required": [
                  "literal"
                ],
                "properties": {
                  "literal": {
                    "oneOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "datatype",
                          "value"
                        ],
                        "properties": {
                          "datatype": {
                            "$ref": "capability-common.schema.json#/$defs/native_datatype"
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "array",
                              "object"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "datatype": {
                                  "const": "record"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": "object"
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "value": {
                                  "anyOf": [
                                    {
                                      "type": [
                                        "string",
                                        "number",
                                        "boolean"
                                      ]
                                    },
                                    {
                                      "type": "array",
                                      "items": {
                                        "type": [
                                          "string",
                                          "number",
                                          "boolean"
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "arithmetic"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "integer",
                  "float"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "substring"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "split"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "datatype",
                    "value"
                  ],
                  "properties": {
                    "datatype": {
                      "$ref": "capability-common.schema.json#/$defs/native_datatype"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "datatype": {
                            "const": "record"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object"
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean"
                                ]
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean"
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "variable"
          ],
          "properties": {
            "variable": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-variable$",
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "object",
              "required": [
                "object",
                "field"
              ],
              "properties": {
                "object": {
                  "$ref": "capability-common.schema.json#/$defs/object_use"
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "concat"
          ],
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "regex_capture"
          ],
          "properties": {
            "regex_capture": {
              "type": "object",
              "required": [
                "pattern",
                "value"
              ],
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "unique"
          ],
          "properties": {
            "unique": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false,
          "description": "Existing scalar-value unique only. Record literals are opaque data, not supported transformation operands; semantic validation enforces this domain."
        },
        {
          "type": "object",
          "required": [
            "merge"
          ],
          "properties": {
            "merge": {
              "type": "object",
              "required": [
                "delimiter",
                "sort",
                "order",
                "values"
              ],
              "properties": {
                "delimiter": {
                  "type": "string"
                },
                "sort": {
                  "enum": [
                    "document",
                    "lexical",
                    "numeric",
                    "natural"
                  ]
                },
                "order": {
                  "enum": [
                    "ascending",
                    "descending"
                  ]
                },
                "values": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/function_expression"
        }
      ]
    },
    "function_expression": {
      "type": "object",
      "required": [
        "function"
      ],
      "properties": {
        "function": {
          "type": "object",
          "required": [
            "name",
            "arguments",
            "options"
          ],
          "properties": {
            "name": {
              "enum": [
                "arithmetic",
                "substring",
                "split"
              ]
            },
            "arguments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "arithmetic"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 2
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "arithmetic_operation"
                    ],
                    "properties": {
                      "arithmetic_operation": {
                        "enum": [
                          "add",
                          "multiply"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "description": "Numeric add/multiply over the Cartesian product of argument populations; preserve multiplicity and collection flags. Boolean/string coercion is not supported."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "substring"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "substring_start",
                      "substring_length"
                    ],
                    "properties": {
                      "substring_start": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "substring_length": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      }
                    },
                    "additionalProperties": false,
                    "description": "One-based OVAL substring; start below1 means1 at evaluation, start past length is an error, negative/oversized length means remainder. Options stay explicit and are not normalized during compilation."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "split"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "delimiter"
                    ],
                    "properties": {
                      "delimiter": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "description": "Literal delimiter, not regular expression. Preserve leading, trailing and adjacent empty strings, duplicates and source collection flags; empty string values are not absent populations."
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Owner-directed three-function subset. Arguments retain collection/status semantics; no implicit options, truthiness defaults, or value execution."
    }
  }
}
