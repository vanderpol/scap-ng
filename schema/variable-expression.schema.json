{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.4.0/variable-expression.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-11-06",
  "title": "Native Variable declarations and OVAL-compatible function expressions",
  "description": "Declare typed Variables from literal data, other Variables, collected Object fields, or ordered function expressions. Canonical function calls preserve operand order, collection multiplicity, empty values, and evaluation status; datatype compatibility and status propagation are enforced by semantic validation and runtime evaluation.",
  "x-scap-ng-owner-decision": "https://github.com/vanderpol/scap-ng/issues/19",
  "$ref": "#/$defs/declaration",
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "kind",
        "datatype",
        "expression"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "constant"
          ],
          "title": "Variable kind",
          "description": "Use `local` for a derived value or `constant` for a literal declaration."
        },
        "datatype": {
          "$ref": "capability-common.schema.json#/$defs/native_datatype",
          "title": "Variable datatype",
          "description": "Datatype promised by this Variable. The expression must produce compatible values."
        },
        "expression": {
          "$ref": "#/$defs/expression",
          "title": "Variable expression",
          "description": "Expression that supplies this Variable’s values."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "title": "Authoring title",
          "description": "Optional author-facing title for this Variable."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            }
          },
          "then": {
            "properties": {
              "expression": {
                "type": "object",
                "required": [
                  "literal"
                ],
                "properties": {
                  "literal": {
                    "oneOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "datatype",
                          "value"
                        ],
                        "properties": {
                          "datatype": {
                            "$ref": "capability-common.schema.json#/$defs/native_datatype",
                            "title": "Literal datatype",
                            "description": "Datatype of the supplied literal or record."
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "array",
                              "object"
                            ],
                            "title": "Literal payload",
                            "description": "Payload for the selected datatype; record data uses an object and scalar datatypes use scalar/list data."
                          }
                        },
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "datatype": {
                                  "const": "record"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": "object",
                                  "title": "Literal payload",
                                  "description": "Record data for `record`; scalar or ordered list data for other datatypes."
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "value": {
                                  "anyOf": [
                                    {
                                      "type": [
                                        "string",
                                        "number",
                                        "boolean"
                                      ]
                                    },
                                    {
                                      "type": "array",
                                      "items": {
                                        "type": [
                                          "string",
                                          "number",
                                          "boolean"
                                        ]
                                      }
                                    }
                                  ],
                                  "title": "Literal payload",
                                  "description": "Scalar or ordered list data for the selected datatype."
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "title": "Literal value",
                    "description": "A scalar, ordered list, or explicitly typed value. Use the typed form when the datatype matters; lists preserve their supplied order and duplicates.",
                    "examples": [
                      {
                        "datatype": "string",
                        "value": "example"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "arithmetic"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "integer",
                  "float"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "substring"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "split"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "count"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "integer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "concat"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "regex_capture"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "unique"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expression": {
                "required": [
                  "function"
                ],
                "properties": {
                  "function": {
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "merge"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "datatype": {
                "enum": [
                  "string"
                ]
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "datatype",
                    "value"
                  ],
                  "properties": {
                    "datatype": {
                      "$ref": "capability-common.schema.json#/$defs/native_datatype",
                      "title": "Literal datatype",
                      "description": "Datatype of the supplied literal or record."
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object"
                      ],
                      "title": "Literal payload",
                      "description": "Payload for the selected datatype; record data uses an object and scalar datatypes use scalar/list data."
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "datatype": {
                            "const": "record"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object",
                            "title": "Literal payload",
                            "description": "Record data for `record`; scalar or ordered list data for other datatypes."
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean"
                                ]
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean"
                                  ]
                                }
                              }
                            ],
                            "title": "Literal payload",
                            "description": "Scalar or ordered list data for the selected datatype."
                          }
                        }
                      }
                    }
                  ]
                }
              ],
              "title": "Literal value",
              "description": "A scalar, ordered list, or explicitly typed value. Use the typed form when the datatype matters; lists preserve their supplied order and duplicates.",
              "examples": [
                {
                  "datatype": "string",
                  "value": "example"
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Literal expression",
          "description": "Produce literal scalar, list, or typed data."
        },
        {
          "type": "object",
          "required": [
            "variable"
          ],
          "properties": {
            "variable": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-variable$",
              "maxLength": 64,
              "title": "Variable reference",
              "description": "Reference another named Variable. The referenced Variable supplies values and evaluation status.",
              "examples": [
                "host-name-variable"
              ]
            }
          },
          "additionalProperties": false,
          "title": "Variable reference expression",
          "description": "Use values from another Variable."
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "object",
              "required": [
                "object",
                "field"
              ],
              "properties": {
                "object": {
                  "$ref": "capability-common.schema.json#/$defs/object_use",
                  "title": "Collection Object",
                  "description": "Object source whose collected Items supply the field values."
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Collected field",
                  "description": "Name of the collected field to read from each collected Item."
                }
              },
              "additionalProperties": false,
              "title": "Collected field values",
              "description": "Read the selected field from the collected Object. Field availability, multiplicity, and collection status are semantic/runtime concerns.",
              "examples": [
                {
                  "object": {
                    "object_ref": "server-object"
                  },
                  "field": "hostname"
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Collected values expression",
          "description": "Produce values from a collected Object field."
        },
        {
          "type": "object",
          "required": [
            "concat"
          ],
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "title": "Concatenated components",
              "description": "Concatenate two or more components in order. Multiple values produce the Cartesian product of component values. Components follow inherited source casting rules when a string conversion is required; incompatible values produce an error. A missing or nonexistent component yields the inherited source status; Error, Incomplete, Not Collected, and Not Applicable statuses are not silently converted to strings.",
              "examples": [
                [
                  {
                    "literal": "https://"
                  },
                  {
                    "variable": "host-name-variable"
                  },
                  {
                    "literal": "/policy"
                  }
                ],
                [
                  {
                    "literal": [
                      "a",
                      "b"
                    ]
                  },
                  {
                    "literal": ".conf"
                  }
                ]
              ]
            }
          },
          "additionalProperties": false,
          "title": "Concatenation expression",
          "description": "Join two or more ordered expressions while retaining collection/status semantics."
        },
        {
          "type": "object",
          "required": [
            "regex_capture"
          ],
          "properties": {
            "regex_capture": {
              "type": "object",
              "required": [
                "pattern",
                "value"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "title": "Capture pattern",
                  "description": "Regular expression containing the capture group to return."
                },
                "value": {
                  "$ref": "#/$defs/expression",
                  "title": "Input expression",
                  "description": "Expression producing the string value(s) to search. Each value is processed independently."
                }
              },
              "additionalProperties": false,
              "title": "Regular-expression capture",
              "description": "Capture text from each input string using the first capturing group. The source regex dialect and first-match behavior are retained; inputs with no capture group or no match produce an empty string under the inherited function contract.",
              "examples": [
                {
                  "pattern": "^https://([^/]+)/",
                  "value": {
                    "variable": "url-variable"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Regex capture expression",
          "description": "Extract the first capture from each input string."
        },
        {
          "type": "object",
          "required": [
            "unique"
          ],
          "properties": {
            "unique": {
              "$ref": "#/$defs/expression",
              "title": "Unique values",
              "description": "Remove duplicate scalar values from the input. Record data is not a supported transformation operand; value ordering and status propagation remain governed by the inherited semantic contract.",
              "examples": [
                {
                  "values": {
                    "object": {
                      "object_ref": "server-object"
                    },
                    "field": "tag"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "Remove duplicate scalar values.",
          "title": "Unique expression"
        },
        {
          "type": "object",
          "required": [
            "merge"
          ],
          "properties": {
            "merge": {
              "type": "object",
              "required": [
                "delimiter",
                "sort",
                "order",
                "values"
              ],
              "properties": {
                "delimiter": {
                  "type": "string",
                  "title": "Join delimiter",
                  "description": "String inserted between adjacent values."
                },
                "sort": {
                  "enum": [
                    "document",
                    "lexical",
                    "numeric",
                    "natural"
                  ],
                  "title": "Sort mode",
                  "description": "`document` preserves input order; `lexical`, `numeric`, and `natural` select the corresponding explicit ordering."
                },
                "order": {
                  "enum": [
                    "ascending",
                    "descending"
                  ],
                  "title": "Sort order",
                  "description": "Ascending or descending order for the selected sort mode."
                },
                "values": {
                  "$ref": "#/$defs/expression",
                  "title": "Values expression",
                  "description": "Expression producing values to join. Collection and status propagation are semantic/runtime behavior, not schema execution."
                }
              },
              "additionalProperties": false,
              "title": "Merged values",
              "description": "Combine input values into one string using an explicit delimiter, sort mode, and order. `document` preserves input order; other modes sort before joining. Duplicates are preserved unless a separate `unique` expression removes them.",
              "examples": [
                {
                  "delimiter": ",",
                  "sort": "document",
                  "order": "ascending",
                  "values": {
                    "variable": "tag-values-variable"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "Merge expression",
          "description": "Sort and join values into one string."
        },
        {
          "$ref": "#/$defs/function_expression"
        }
      ]
    },
    "function_expression": {
      "type": "object",
      "required": [
        "function"
      ],
      "properties": {
        "function": {
          "type": "object",
          "required": [
            "name",
            "arguments",
            "options"
          ],
          "properties": {
            "name": {
              "enum": [
                "arithmetic",
                "substring",
                "split",
                "count",
                "concat",
                "regex_capture",
                "unique",
                "merge"
              ]
            },
            "arguments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "Ordered expression operands. Each operand may be a collection; function-specific Cartesian, flattening, and status rules apply."
            },
            "options": {
              "type": "object",
              "description": "Function-specific options. Unknown options and implicit defaults are invalid."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "arithmetic"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 2
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "arithmetic_operation"
                    ],
                    "properties": {
                      "arithmetic_operation": {
                        "enum": [
                          "add",
                          "multiply"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "description": "Numeric add/multiply over Cartesian-product operands; preserve multiplicity and diagnostic statuses. No boolean/string coercion."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "substring"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "substring_start",
                      "substring_length"
                    ],
                    "properties": {
                      "substring_start": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "substring_length": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      }
                    },
                    "additionalProperties": false,
                    "description": "OVAL one-based substring with signed 32-bit start/length. Start below one clamps; start past the value is an error; negative length means remainder."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "split"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "delimiter"
                    ],
                    "properties": {
                      "delimiter": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "description": "Literal delimiter split; retain leading, trailing, adjacent empty parts and duplicates. Empty delimiter is literal, not regex."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "count"
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "type": "object",
                    "maxProperties": 0,
                    "additionalProperties": false,
                    "description": "Count has no options."
                  },
                  "arguments": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "concat"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 2
                  },
                  "options": {
                    "type": "object",
                    "maxProperties": 0,
                    "additionalProperties": false,
                    "description": "Concat has no options."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "regex_capture"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "pattern"
                    ],
                    "properties": {
                      "pattern": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "description": "Literal regular-expression pattern; matching outputs retain OVAL capture collection semantics."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "unique"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1
                  },
                  "options": {
                    "type": "object",
                    "maxProperties": 0,
                    "additionalProperties": false,
                    "description": "Unique has no options."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "merge"
                  }
                }
              },
              "then": {
                "properties": {
                  "arguments": {
                    "minItems": 1
                  },
                  "options": {
                    "type": "object",
                    "required": [
                      "delimiter",
                      "sort",
                      "order"
                    ],
                    "properties": {
                      "delimiter": {
                        "type": "string",
                        "description": "Literal text inserted between values."
                      },
                      "sort": {
                        "enum": [
                          "document",
                          "lexical",
                          "numeric",
                          "natural"
                        ]
                      },
                      "order": {
                        "enum": [
                          "ascending",
                          "descending"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "description": "Merge options are explicit so ordering and delimiter semantics are never inferred."
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Canonical ordered function-call envelope. Arguments are expressions evaluated as collections; options are explicit and function-specific. These calls preserve source collection/status semantics and are not evaluated by JSON Schema alone.",
      "examples": [
        {
          "function": {
            "name": "count",
            "arguments": [
              {
                "values": {
                  "object": {
                    "id": "files-object"
                  },
                  "field": "path"
                }
              }
            ],
            "options": {}
          }
        },
        {
          "function": {
            "name": "unique",
            "arguments": [
              {
                "literal": [
                  "a",
                  "b"
                ]
              },
              {
                "literal": [
                  "b",
                  "c"
                ]
              }
            ],
            "options": {}
          }
        },
        {
          "function": {
            "name": "merge",
            "arguments": [
              {
                "literal": [
                  "10",
