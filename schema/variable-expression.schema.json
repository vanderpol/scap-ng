{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.4.0/variable-expression.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-11-01",
  "title": "Native variable declarations and expressions",
  "description": "Finite current native vocabulary. No canonical function envelope, implicit options or value execution. Declaration/reference/derived type compatibility is additionally enforced by semantic validation and the direct compiler.",
  "x-scap-ng-owner-decision": "https://github.com/vanderpol/scap-ng/pull/268#issuecomment-6550047257",
  "$ref": "#/$defs/declaration",
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "kind",
        "datatype",
        "expression"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "constant"
          ],
          "description": "Whether this is a local derived Variable or a constant declaration."
        },
        "datatype": {
          "$ref": "capability-common.schema.json#/$defs/native_datatype",
          "description": "Type of values produced by this Variable."
        },
        "expression": {
          "$ref": "#/$defs/expression",
          "description": "Expression that produces the Variable values."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional author-facing name for this Variable."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            }
          },
          "then": {
            "properties": {
              "expression": {
                "type": "object",
                "required": [
                  "literal"
                ],
                "properties": {
                  "literal": {
                    "oneOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "datatype",
                          "value"
                        ],
                        "properties": {
                          "datatype": {
                            "$ref": "capability-common.schema.json#/$defs/native_datatype",
                            "description": "Datatype of this literal value."
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "array",
                              "object"
                            ],
                            "description": "Literal value or record data. Its shape follows the selected datatype.",
                            "title": "Literal value"
                          }
                        },
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "datatype": {
                                  "const": "record"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": "object",
                                  "description": "Literal value or record data. Its shape follows the selected datatype.",
                                  "title": "Literal value"
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "value": {
                                  "anyOf": [
                                    {
                                      "type": [
                                        "string",
                                        "number",
                                        "boolean"
                                      ]
                                    },
                                    {
                                      "type": "array",
                                      "items": {
                                        "type": [
                                          "string",
                                          "number",
                                          "boolean"
                                        ]
                                      }
                                    }
                                  ],
                                  "description": "Literal value or record data. Its shape follows the selected datatype.",
                                  "title": "Literal value"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "description": "A literal value or value list used by the Variable.",
                    "title": "Literal value"
                  }
                },
                "additionalProperties": false,
                "description": "Expression that produces the Variable values."
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "datatype",
                    "value"
                  ],
                  "properties": {
                    "datatype": {
                      "$ref": "capability-common.schema.json#/$defs/native_datatype",
                      "description": "Datatype of this literal value."
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object"
                      ],
                      "description": "Literal value or record data. Its shape follows the selected datatype.",
                      "title": "Literal value"
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "datatype": {
                            "const": "record"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object",
                            "description": "Literal value or record data. Its shape follows the selected datatype.",
                            "title": "Literal value"
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean"
                                ]
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean"
                                  ]
                                }
                              }
                            ],
                            "description": "Literal value or record data. Its shape follows the selected datatype.",
                            "title": "Literal value"
                          }
                        }
                      }
                    }
                  ]
                }
              ],
              "description": "A literal value or value list used by the Variable.",
              "title": "Literal value"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "variable"
          ],
          "properties": {
            "variable": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-variable$",
              "maxLength": 64,
              "description": "Reference to another named Variable.",
              "title": "Variable reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "object",
              "required": [
                "object",
                "field"
              ],
              "properties": {
                "object": {
                  "$ref": "capability-common.schema.json#/$defs/object_use"
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the collected field whose values become this Variable.",
                  "title": "Collected field"
                }
              },
              "additionalProperties": false,
              "description": "Collect values from a field of an Object.",
              "title": "Collected values"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "concat"
          ],
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "Concatenate two or more expression results in order.",
              "title": "Concatenate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "regex_capture"
          ],
          "properties": {
            "regex_capture": {
              "type": "object",
              "required": [
                "pattern",
                "value"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "Regular expression used to capture text.",
                  "title": "Capture pattern"
                },
                "value": {
                  "$ref": "#/$defs/expression",
                  "description": "Expression whose string values are processed by the capture pattern.",
                  "title": "Input expression"
                }
              },
              "additionalProperties": false,
              "description": "Capture text from an expression with a regular expression.",
              "title": "Regular-expression capture"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "unique"
          ],
          "properties": {
            "unique": {
              "$ref": "#/$defs/expression",
              "description": "Remove duplicate scalar values from an expression result.",
              "title": "Unique values"
            }
          },
          "additionalProperties": false,
          "description": "Existing scalar-value unique only. Record literals are opaque data, not supported transformation operands; semantic validation enforces this domain."
        },
        {
          "type": "object",
          "required": [
            "merge"
          ],
          "properties": {
            "merge": {
              "type": "object",
              "required": [
                "delimiter",
                "sort",
                "order",
                "values"
              ],
              "properties": {
                "delimiter": {
                  "type": "string",
                  "description": "Text placed between merged values.",
                  "title": "Delimiter"
                },
                "sort": {
                  "enum": [
                    "document",
                    "lexical",
                    "numeric",
                    "natural"
                  ],
                  "description": "Ordering used before values are merged.",
                  "title": "Sort values"
                },
                "order": {
                  "enum": [
                    "ascending",
                    "descending"
                  ],
                  "description": "Ascending or descending direction for the selected sort.",
                  "title": "Sort order"
                },
                "values": {
                  "$ref": "#/$defs/expression",
                  "description": "Expression producing the values to combine into one string.",
                  "title": "Values expression"
                }
              },
              "additionalProperties": false,
              "description": "Combine values into one string with explicit delimiter, sorting and order.",
              "title": "Merge values"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
