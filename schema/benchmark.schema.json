{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.4.1/benchmark.schema.json",
  "x-scap-ng-version": "0.4.1",
  "x-last-modified": "2026-10-06",
  "title": "SCAP-NG Benchmark v0.4.1",
  "type": "object",
  "required": [
    "benchmark"
  ],
  "properties": {
    "benchmark": {
      "type": "object",
      "required": [
        "id",
        "ng_schema_version",
        "use_case",
        "assessment_specifications",
        "title",
        "description",
        "language",
        "status",
        "version",
        "metadata",
        "notices",
        "front_matter",
        "rear_matter",
        "references",
        "text_blocks",
        "platform",
        "applicability_catalog",
        "scoring",
        "parameters",
        "default_selection",
        "groups",
        "profiles",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ng_schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "use_case": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "description": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "version": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "front_matter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "rear_matter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "text_blocks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "platform": {
          "type": "object",
          "required": [
            "id",
            "title"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "applicability": {
              "$ref": "applicability.schema.json#/$defs/expression",
              "description": "Optional Benchmark-level applicability restriction. Omission means unrestricted; no synthetic condition is implied."
            }
          },
          "additionalProperties": false
        },
        "applicability_catalog": {
          "type": "string",
          "minLength": 1
        },
        "scoring": {
          "type": "array"
        },
        "parameters": {
          "type": "array"
        },
        "default_selection": {
          "type": "boolean"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "disabled_rules"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extends": {
                "type": "string",
                "minLength": 1
              },
              "disabled_rules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "parameters": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessment_specifications": {
          "type": "array",
          "description": "External automated assessment specifications required by Assessments referenced from this Benchmark. Manual Assessment is native to SCAP-NG and is not listed here unless separately standardized in the future.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "id",
        "groups",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable Group identity."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional human-readable Group title."
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional Group description."
        },
        "applicability": {
          "$ref": "applicability.schema.json#/$defs/expression",
          "description": "Optional Group-local applicability restriction."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "description": "Nested child Groups in source order."
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Rule IDs directly contained by this Group."
        }
      },
      "additionalProperties": false,
      "description": "Nested XCCDF Group projection. Group-local applicability is independent and combines with every ancestor restriction."
    }
  }
}
