{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.4.0/expression.schema.json",
  "x-scap-ng-version": "0.4.0",
  "x-last-modified": "2026-10-23",
  "title": "Draft SCAP-NG 0.4.0 automated expression",
  "description": "SCAP-NG 0.4.0 Test-result expression grammar. Logical and/or/one/xor are canonical; legacy all/any/odd are invalid. Item cardinalities are separate.",
  "$ref": "#/$defs/expression",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "test"
          ],
          "properties": {
            "test": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-test$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "assessment"
          ],
          "properties": {
            "assessment": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "if",
            "then",
            "else"
          ],
          "properties": {
            "if": {
              "$ref": "#/$defs/expression"
            },
            "then": {
              "$ref": "#/$defs/expression"
            },
            "else": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "Logical AND of complete Test outcomes; separate from Test Item matching."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "Logical OR of complete Test outcomes; separate from Test Item matching."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not_applicable"
          ],
          "properties": {
            "not_applicable": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "one"
          ],
          "properties": {
            "one": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "xor"
          ],
          "properties": {
            "xor": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "Logical XOR of complete Test outcomes; separate from Test Item matching."
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
