  "semantic_validator_rules": [
    {
      "id": "file.hash.algorithm_collection_domain",
      "rule": "The algorithm selector determines acquisition over the complete six-algorithm domain md5, sha1, sha224, sha256, sha384, sha512. A literal collection or Variable reference is evaluated with its explicit value_match; value_match none selects the complement within that domain, not an arbitrary default algorithm. Each selected algorithm produces an Item with its algorithm and digest, and source collection errors or incomplete evidence must not be treated as a complete empty selection."
    },
