{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.2.0/item-materialization.schema.json",
  "type": "object",
  "required": [
    "scope",
    "available_count",
    "included_count",
    "omitted_count",
    "consumed_item_refs",
    "collections"
  ],
  "properties": {
    "scope": {
      "enum": [
        "all",
        "consumed"
      ],
      "default": "all"
    },
    "available_count": {
      "type": "integer",
      "minimum": 0
    },
    "included_count": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0
    },
    "consumed_item_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_ref",
          "available_count",
          "included_count",
          "omitted_count"
        ],
        "properties": {
          "object_ref": {
            "type": "string",
            "minLength": 1
          },
          "available_count": {
            "type": "integer",
            "minimum": 0
          },
          "included_count": {
            "type": "integer",
            "minimum": 0
          },
          "omitted_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
