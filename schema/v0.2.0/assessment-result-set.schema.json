{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.2.0/assessment-result-set.schema.json",
  "title": "Draft invocation-linked Assessment Results transport",
  "description": "Development transport of per-invocation artifacts; not a replacement result package or Benchmark Result.",
  "type": "object",
  "required": [
    "entry_execution_id",
    "target_ref",
    "assessment_results"
  ],
  "properties": {
    "entry_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "assessment_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "assessment-result.schema.json"
      }
    }
  },
  "additionalProperties": false
}
