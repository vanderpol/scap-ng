{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.2.0/rule-result.schema.json",
  "x-scap-ng-version": "0.2.0",
  "x-last-modified": "2026-10-03",
  "title": "SCAP-NG Rule Result draft v0.2.0 strawman",
  "description": "Compact policy-facing result for one effectively selected Rule. Detailed Assessment execution data remains in referenced Assessment Results.",
  "type": "object",
  "required": [
    "rule_id",
    "outcome",
    "assessment",
    "message",
    "instances"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unknown",
        "not_evaluated",
        "not_applicable"
      ],
      "description": "Deterministic aggregate policy outcome derived from all Rule result instances."
    },
    "assessment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "integer"
              ]
            },
            "digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "automated",
                "manual",
                null
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Identity of the effective selected Assessment for this Rule. Execution details live only in referenced Assessment Results."
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "unexpected_existence",
                "required_item_missing",
                "required_match_missing",
                "value_mismatch",
                "cardinality_mismatch",
                "unsupported_organizational_input",
                "missing_organizational_input",
                "invalid_organizational_input",
                "collection_error"
              ]
            },
            "input": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional references to decisive evidence or Assessment-result evidence members; evidence is not embedded here."
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "description": "Explicit result instances contributing to this policy-facing Rule Result. Present even for the common single-invocation case.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "outcome",
          "assessment_result_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error",
              "unknown",
              "not_evaluated",
              "not_applicable"
            ]
          },
          "assessment_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Manifest logical Assessment execution identity, never a guessed artifact filename."
          },
          "assessment_invocation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "check_instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "object",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "description": "One policy-facing invocation/check/target instance. It references, but does not duplicate, the detailed Assessment Result."
      }
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Effective Rule weight used by the selected scoring model, when defined."
    },
    "check_selector": {
      "type": [
        "string",
        "null"
      ],
      "description": "Effective named Assessment/check selector chosen for this Rule."
    },
    "parameters": {
      "type": "object",
      "description": "Effective publisher/Profile/Tailoring Parameters materially relevant to this Rule result."
    },
    "applicability": {
      "type": [
        "object",
        "null"
      ],
      "description": "Rule-level applicability disposition plus references to the applicability Assessment Results that produced it; detailed execution data is not embedded here.",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable",
            "unknown",
            "error",
            "not_evaluated"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "outcome"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "applicable",
                  "not_applicable",
                  "unknown",
                  "error",
                  "not_evaluated"
                ]
              },
              "assessment_result_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assessment_invocation_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "object",
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "outcome",
        "conditions"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
