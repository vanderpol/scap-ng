{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.3.0/reported-elements.schema.json",
  "x-scap-ng-version": "0.3.0",
  "x-last-modified": "2026-10-06",
  "title": "Draft Test reported elements 0.3.0",
  "description": "Reporting selection only. Authors SHALL select all, compared, or an explicit field list. This is not redaction or an Object selector.",
  "oneOf": [
    {
      "enum": [
        "all",
        "compared"
      ]
    },
    {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  ]
}
