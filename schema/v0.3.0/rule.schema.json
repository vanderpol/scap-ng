{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.3.0/rule.schema.json",
  "x-scap-ng-version": "0.3.0",
  "x-last-modified": "2026-10-08",
  "title": "SCAP-NG Rule v0.3.0",
  "type": "object",
  "required": [
    "rule"
  ],
  "properties": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "severity",
        "role",
        "weight",
        "discussion",
        "rationale",
        "extensions",
        "warnings",
        "identifiers",
        "references",
        "requires",
        "conflicts",
        "applicability",
        "parameters",
        "remediation",
        "organizational_input_requirements",
        "assessment_choices",
        "default_assessment_choice"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "discussion": {
          "type": "string"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "type": "object"
        },
        "warnings": {
          "type": "array"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "requires": {
          "type": "array",
          "description": "Selection prerequisites. Each array entry is one requirement clause; clauses are ANDed. A clause's any_of members are ORed. A single string is shorthand for a one-member clause.",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "any_of"
                ],
                "properties": {
                  "any_of": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability": {
          "type": "array"
        },
        "parameters": {
          "type": "object"
        },
        "remediation": {
          "type": "object"
        },
        "assessment_choices": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "assessment"
            ],
            "properties": {
              "assessment": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object",
                "description": "Assessment input name to Benchmark Parameter binding.",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "required": [
                        "parameter"
                      ],
                      "properties": {
                        "parameter": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "expected_version": {
                "type": [
                  "integer",
                  "string"
                ],
                "description": "Exact logical Assessment version required to disambiguate multiple versions in the declared source scope."
              }
            },
            "additionalProperties": false
          }
        },
        "default_assessment_choice": {
          "type": "string",
          "minLength": 1
        },
        "organizational_input_requirements": {
          "type": "object",
          "description": "Rule-level discoverability map of Organizational Input dependencies by Assessment choice. Always present; empty when no choice depends on Organizational Input. Technical use locations are identified by Test, State, and State slot.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "input",
                "required",
                "uses"
              ],
              "properties": {
                "input": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "uses": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "test",
                      "state",
                      "state_slot"
                    ],
                    "properties": {
                      "test": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state_slot": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
