{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/collection-result.schema.json",
  "title": "SCAP-NG Object Collection Result v0.1.0 strawman",
  "description": "Runtime result of evaluating an authored Object and producing Items. Collection status is intentionally not Boolean.",
  "type": "object",
  "required": [
    "id",
    "capability",
    "status",
    "item_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "object_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "error",
        "complete",
        "incomplete",
        "does_not_exist",
        "not_collected",
        "not_applicable"
      ]
    },
    "item_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logical_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "population_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_execution_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
