{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/assessment.schema.json",
  "title": "SCAP-NG Assessment v0.1.0",
  "type": "object",
  "required": ["assessment"],
  "properties": {
    "assessment": {
      "type":"object",
      "required":["id","version","assessment_title","mode","class","purpose"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "version":{"type":"integer","minimum":1},
        "assessment_title":{"type":"string"},
        "mode":{"type":"string"},
        "class":{"type":"string"},
        "purpose":{"type":"string"},
        "collections":{"type":"object"},
        "variables":{"type":"object"},
        "tests":{"type":"object"},
        "evaluate":{"type":"object"},
        "procedure":{"type":"string"},
        "inputs":{"type":"array"},
        "evidence":{"type":"array"}
      },
      "additionalProperties":false,
      "allOf":[
        {"if":{"properties":{"mode":{"const":"manual"}},"required":["mode"]},"then":{"required":["procedure","inputs","evidence"]}},
        {"if":{"properties":{"mode":{"const":"automated"}},"required":["mode"]},"then":{"required":["collections","tests","evaluate"]}}
      ]
    }
  },
  "additionalProperties":false
}
