{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/assessment.schema.json",
  "title": "SCAP-NG Assessment v0.1.0",
  "description": "Pre-alpha structural schema using OVAL-aligned semantic node names. Capability-specific Object/State/Test/Variable schemas are generated separately.",
  "type": "object",
  "required": [
    "assessment"
  ],
  "properties": {
    "assessment": {
      "type": "object",
      "required": [
        "id",
        "version",
        "assessment_title",
        "mode",
        "class",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "assessment_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "automated"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "compliance",
            "vulnerability",
            "patch",
            "inventory",
            "miscellaneous"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "assessment",
            "applicability"
          ]
        },
        "objects": {
          "type": "object",
          "description": "Named authored Objects. An Object defines the effective observation population; collection is the runtime act of evaluating it.",
          "additionalProperties": {
            "type": "object"
          }
        },
        "variables": {
          "type": "object",
          "description": "Named Variables.",
          "additionalProperties": {
            "type": "object"
          }
        },
        "states": {
          "type": "object",
          "description": "Named authored States/predicates.",
          "additionalProperties": {
            "type": "object"
          }
        },
        "tests": {
          "type": "object",
          "description": "Named Tests. A Test references an Object and zero or more States and retains check_existence/check/state_operator semantics.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "test_title",
              "capability"
            ],
            "properties": {
              "test_title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "type": "string",
                "minLength": 1
              },
              "check_existence": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "minLength": 1
              },
              "state_operator": {
                "type": "string",
                "enum": [
                  "AND",
                  "OR"
                ]
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "evaluate": {
          "type": "object"
        },
        "procedure": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "description": "Named typed input contracts declared by the Assessment. Policy-layer bindings are supplied by the referring Rule/Assessment selection, not hard-coded here.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "datatype",
              "cardinality",
              "required"
            ],
            "properties": {
              "datatype": {
                "type": "string",
                "minLength": 1
              },
              "cardinality": {
                "type": "string",
                "enum": [
                  "one",
                  "zero_or_one",
                  "one_or_more",
                  "zero_or_more"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "constraints": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "evidence": {
          "type": "array"
        },
        "specification": {
          "type": "object",
          "description": "Exact automated assessment specification used by this Assessment. The current pre-alpha implementation identifier is provisional pending OVAL Board naming/ratification.",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "description": "Statically declared dependencies on other Assessments whose final Assessment truth/result may be consumed by this Assessment's evaluate expression. Keys are local aliases.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "assessment"
            ],
            "properties": {
              "assessment": {
                "type": "string",
                "minLength": 1,
                "description": "Explicit source reference to the dependent Assessment; compiled packages resolve this to an immutable packaged Assessment identity."
              },
              "expected_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expected_version": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "purpose": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "assessment",
                  "applicability",
                  null
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "applicability": {
          "type": [
            "object",
            "null"
          ],
          "description": "Intrinsic Assessment applicability expression. False yields Assessment outcome not_applicable; distinct from SCAP-NG Rule applicability."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "procedure"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "automated"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "specification",
              "objects",
              "states",
              "tests",
              "evaluate"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
