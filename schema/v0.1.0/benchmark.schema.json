{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/benchmark.schema.json",
  "title": "SCAP-NG Benchmark v0.1.0",
  "type": "object",
  "required": [
    "benchmark"
  ],
  "properties": {
    "benchmark": {
      "type": "object",
      "required": [
        "id",
        "ng_schema_version",
        "use_case",
        "assessment_specifications",
        "title",
        "description",
        "language",
        "status",
        "version",
        "metadata",
        "notices",
        "front_matter",
        "rear_matter",
        "references",
        "text_blocks",
        "platform",
        "applicability_catalog",
        "scoring",
        "parameters",
        "default_selection",
        "groups",
        "profiles",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ng_schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "use_case": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "description": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "version": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "front_matter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "rear_matter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "text_blocks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "platform": {
          "type": "object",
          "required": [
            "id",
            "title",
            "applicability"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "applicability": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "applicability_catalog": {
          "type": "string",
          "minLength": 1
        },
        "scoring": {
          "type": "array"
        },
        "parameters": {
          "type": "array"
        },
        "default_selection": {
          "type": "boolean"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessment_specifications": {
          "type": "array",
          "description": "External automated assessment specifications required by Assessments referenced from this Benchmark. Manual Assessment is native to SCAP-NG and is not listed here unless separately standardized in the future.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
