{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/benchmark-result.schema.json",
  "title": "SCAP-NG Benchmark Result v0.1.0 strawman",
  "description": "Run-level and policy-facing result for one Benchmark evaluation. Pre-alpha strawman.",
  "type": "object",
  "required": [
    "benchmark_result"
  ],
  "properties": {
    "benchmark_result": {
      "type": "object",
      "required": [
        "result_schema_version",
        "run_id",
        "started_at",
        "completed_at",
        "scanner",
        "target",
        "benchmark",
        "effective_policy",
        "summary",
        "rule_results"
      ],
      "properties": {
        "result_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scanner": {
          "type": "object",
          "description": "Scanner identity/version and implementation provenance.",
          "required": [
            "capabilities"
          ],
          "properties": {
            "capabilities": {
              "type": "object",
              "required": [
                "organizational_input"
              ],
              "properties": {
                "organizational_input": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "target": {
          "type": "object",
          "required": [
            "identifiers"
          ],
          "properties": {
            "identifiers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": [
                "string",
                "null"
              ]
            },
            "addresses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inventory": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "benchmark": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "integer"
              ]
            },
            "package_digest": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "effective_policy": {
          "type": "object",
          "required": [
            "profile",
            "tailoring",
            "selected_rules",
            "disabled_rules",
            "check_selectors",
            "parameters",
            "organizational_inputs"
          ],
          "properties": {
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "tailoring": {
              "type": [
                "object",
                "null"
              ]
            },
            "selected_rules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "disabled_rules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "check_selectors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "parameters": {
              "type": "object"
            },
            "organizational_inputs": {
              "type": "object",
              "description": "Run-local registry of effective Organizational Input assertions used by the run.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "parameter",
                  "value",
                  "source",
                  "provenance"
                ],
                "properties": {
                  "parameter": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {},
                  "source": {
                    "type": "string",
                    "enum": [
                      "organizational_input",
                      "interactive",
                      "api",
                      "integration",
                      "other"
                    ]
                  },
                  "input_set": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": [
                          "string",
                          "integer"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "provenance": {
                    "type": "object"
                  },
                  "scope": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "effective_from": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "redacted": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "required": [
            "total",
            "pass",
            "fail",
            "not_applicable",
            "not_evaluated",
            "error",
            "unknown"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "pass": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            },
            "not_applicable": {
              "type": "integer",
              "minimum": 0
            },
            "not_evaluated": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "rule_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "outcome",
              "assessment",
              "message",
              "expected_state",
              "instances"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "severity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "unknown",
                  "not_evaluated",
                  "not_applicable"
                ],
                "description": "Deterministic aggregate policy outcome derived from all Rule result instances."
              },
              "assessment": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Effective selected Assessment method/binding metadata for this Rule; per-invocation details live in instances and referenced Assessment Results."
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "type": "string",
                        "enum": [
                          "unexpected_existence",
                          "required_item_missing",
                          "required_match_missing",
                          "value_mismatch",
                          "cardinality_mismatch",
                          "unsupported_organizational_input",
                          "missing_organizational_input",
                          "invalid_organizational_input"
                        ]
                      },
                      "input": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "state_slot": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "message": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "organizational_inputs": {
                "type": "array",
                "description": "Effective organization-defined values that directly affected evaluation of this Rule.",
                "items": {
                  "type": "object",
                  "required": [
                    "input",
                    "value",
                    "organizational_input_ref"
                  ],
                  "properties": {
                    "input": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state_slot": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "value": {},
                    "redacted": {
                      "type": "boolean"
                    },
                    "organizational_input_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance_summary": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "organization": {
                          "type": [
                            "string",
                            "object",
                            "null"
                          ]
                        },
                        "authority_basis": {
                          "type": [
                            "string",
                            "object",
                            "null"
                          ]
                        },
                        "authorization_reference": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "effective_from": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "expires_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              },
              "expected_state": {
                "type": "array",
                "description": "Effective expected state used to evaluate this Rule. Always present; empty when no materialized expected State applies.",
                "items": {
                  "type": "object",
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "state": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "state_slot": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "datatype": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "operation": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "entity_check": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "var_check": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "value": {},
                    "redacted": {
                      "type": "boolean"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "publisher",
                        "publisher_profile",
                        "organizational_input",
                        "runtime_input",
                        "other"
                      ]
                    },
                    "source_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "provenance_summary": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "instances": {
                "type": "array",
                "minItems": 1,
                "description": "Explicit result instances contributing to this policy-facing Rule Result. Present even for the common single-invocation case.",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "outcome",
                    "assessment_result_ref"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "pass",
                        "fail",
                        "error",
                        "unknown",
                        "not_evaluated",
                        "not_applicable"
                      ]
                    },
                    "assessment_result_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "assessment_invocation_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "target_instance": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "check_instance": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "object",
                        "null"
                      ]
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "not_evaluated"
                    },
                    "reason": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "enum": [
                            "unsupported_organizational_input",
                            "missing_organizational_input",
                            "invalid_organizational_input"
                          ]
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "outcome",
                    "reason"
                  ]
                },
                "then": {
                  "properties": {
                    "expected_state": {
                      "type": "array"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
