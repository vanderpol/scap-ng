{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/capability-common.schema.json",
  "title": "SCAP-NG shared capability schema primitives v0.1.0",
  "description": "Pre-alpha reusable authored-Assessment primitives shared by generated capability schemas. Capability-specific schemas SHOULD reference these definitions instead of copying them. Base entity definitions intentionally leave closure to the capability schema via unevaluatedProperties so capability-specific fields can be composed without duplicating common properties.",
  "$defs": {
    "variable_reference": {
      "type": "object",
      "required": [
        "variable"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "entity_value": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        {
          "$ref": "#/$defs/variable_reference"
        }
      ]
    },
    "object_entity_base": {
      "type": "object",
      "required": [
        "value",
        "operation",
        "datatype",
        "mask"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/entity_value"
        },
        "operation": {
          "$ref": "#/$defs/comparison_operation"
        },
        "datatype": {
          "$ref": "#/$defs/native_datatype"
        },
        "var_check": {
          "$ref": "#/$defs/match_quantifier"
        },
        "mask": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "var_check"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/variable_reference"
              }
            }
          }
        }
      ]
    },
    "state_entity_base": {
      "type": "object",
      "required": [
        "value",
        "operation",
        "datatype",
        "mask",
        "entity_check",
        "entity_existence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/entity_value"
        },
        "operation": {
          "$ref": "#/$defs/comparison_operation"
        },
        "datatype": {
          "$ref": "#/$defs/native_datatype"
        },
        "var_check": {
          "$ref": "#/$defs/match_quantifier"
        },
        "entity_check": {
          "$ref": "#/$defs/match_quantifier"
        },
        "entity_existence": {
          "$ref": "#/$defs/existence_requirement"
        },
        "mask": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "var_check"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/variable_reference"
              }
            }
          }
        }
      ]
    },
    "state_filter": {
      "type": "object",
      "required": [
        "state",
        "action"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "include",
            "exclude"
          ]
        }
      },
      "additionalProperties": false
    },
    "test_reference_set": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "comparison_operation": {
      "type": "string",
      "enum": [
        "equal",
        "not_equal",
        "equal_ci",
        "not_equal_ci",
        "greater_than",
        "greater_or_equal",
        "less_than",
        "less_or_equal",
        "bit_and",
        "bit_or",
        "match",
        "subset",
        "superset"
      ]
    },
    "match_quantifier": {
      "type": "string",
      "enum": [
        "all",
        "any",
        "one",
        "none"
      ]
    },
    "existence_requirement": {
      "type": "string",
      "enum": [
        "all",
        "some",
        "none",
        "one",
        "optional"
      ]
    },
    "logical_operator": {
      "type": "string",
      "enum": [
        "all",
        "any",
        "one",
        "odd"
      ]
    },
    "native_datatype": {
      "type": "string",
      "enum": [
        "string",
        "boolean",
        "integer",
        "float",
        "binary",
        "version",
        "ipv4",
        "ipv6",
        "rpm_evr",
        "debian_evr",
        "fileset_revision",
        "ios_version",
        "record"
      ]
    },
    "file_traversal": {
      "type": "object",
      "required": [
        "max_depth",
        "follow_symlinks",
        "filesystem"
      ],
      "properties": {
        "max_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "follow_symlinks": {
          "type": "boolean"
        },
        "filesystem": {
          "type": "string",
          "enum": [
            "any",
            "local",
            "same"
          ]
        }
      },
      "additionalProperties": false
    },
    "file_selection": {
      "type": "object",
      "properties": {
        "full_path": {
          "$ref": "#/$defs/object_entity_base"
        },
        "directory": {
          "$ref": "#/$defs/object_entity_base"
        },
        "name": {
          "$ref": "#/$defs/object_entity_base"
        },
        "traversal": {
          "$ref": "#/$defs/file_traversal"
        }
      },
      "oneOf": [
        {
          "required": [
            "full_path"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "directory"
                ]
              },
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "traversal"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "directory",
            "name"
          ],
          "not": {
            "required": [
              "full_path"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "set_object_operand": {
      "type": "object",
      "required": [
        "object",
        "filters"
      ],
      "properties": {
        "object": {
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_filter"
          }
        }
      },
      "additionalProperties": false
    },
    "set_nested_operand": {
      "type": "object",
      "required": [
        "set"
      ],
      "properties": {
        "set": {
          "$ref": "#/$defs/set_expression"
        }
      },
      "additionalProperties": false
    },
    "set_operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/set_object_operand"
        },
        {
          "$ref": "#/$defs/set_nested_operand"
        }
      ]
    },
    "set_expression": {
      "type": "object",
      "required": [
        "operator",
        "operands"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "union",
            "intersection",
            "difference"
          ]
        },
        "operands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/set_operand"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "difference"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "operands": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
