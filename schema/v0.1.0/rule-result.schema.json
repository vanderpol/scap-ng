{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/rule-result.schema.json",
  "title": "SCAP-NG Rule Result v0.1.0 strawman",
  "description": "One policy-facing Rule Result per effectively selected Rule. Every Rule Result has a non-empty instances array; per-invocation Assessment references live only in instances.",
  "type": "object",
  "required": [
    "rule_id",
    "outcome",
    "assessment",
    "message",
    "expected_state",
    "instances"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unknown",
        "not_evaluated",
        "not_applicable"
      ],
      "description": "Deterministic aggregate policy outcome derived from all Rule result instances."
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ],
      "description": "Effective selected Assessment method/binding metadata for this Rule; per-invocation details live in instances and referenced Assessment Results."
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "unexpected_existence",
                "required_item_missing",
                "required_match_missing",
                "value_mismatch",
                "cardinality_mismatch",
                "unsupported_organizational_input",
                "missing_organizational_input",
                "invalid_organizational_input",
                "collection_error"
              ]
            },
            "input": {
              "type": [
                "string",
                "null"
              ]
            },
            "state_slot": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "organizational_inputs": {
      "type": "array",
      "description": "Effective organization-defined values that directly affected evaluation of this Rule.",
      "items": {
        "type": "object",
        "required": [
          "input",
          "value",
          "organizational_input_ref"
        ],
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1
          },
          "state_slot": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "redacted": {
            "type": "boolean"
          },
          "organizational_input_ref": {
            "type": "string",
            "minLength": 1
          },
          "provenance_summary": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "organization": {
                "type": [
                  "string",
                  "object",
                  "null"
                ]
              },
              "authority_basis": {
                "type": [
                  "string",
                  "object",
                  "null"
                ]
              },
              "authorization_reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effective_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "expected_state": {
      "type": "array",
      "description": "Effective expected state used to evaluate this Rule. Always present; empty when no materialized expected State applies.",
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "state_slot": {
            "type": [
              "string",
              "null"
            ]
          },
          "datatype": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_check": {
            "type": [
              "string",
              "null"
            ]
          },
          "var_check": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "redacted": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "publisher",
              "publisher_profile",
              "organizational_input",
              "runtime_input",
              "other"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_summary": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "description": "Explicit result instances contributing to this policy-facing Rule Result. Present even for the common single-invocation case.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "outcome",
          "assessment_result_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error",
              "unknown",
              "not_evaluated",
              "not_applicable"
            ]
          },
          "assessment_result_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessment_invocation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "check_instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "object",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Effective Rule weight used by the selected scoring model, when defined."
    },
    "check_selector": {
      "type": [
        "string",
        "null"
      ],
      "description": "Effective named Assessment/check selector chosen for this Rule."
    },
    "parameters": {
      "type": "object",
      "description": "Effective publisher/Profile/Tailoring Parameters materially relevant to this Rule result."
    },
    "applicability": {
      "type": [
        "object",
        "null"
      ],
      "description": "Aggregate Rule applicability plus the named applicability Assessment results that produced it.",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable",
            "unknown",
            "error",
            "not_evaluated"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "outcome"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "applicable",
                  "not_applicable",
                  "unknown",
                  "error",
                  "not_evaluated"
                ]
              },
              "assessment_result_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assessment_invocation_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "object",
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "outcome",
        "conditions"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "not_evaluated"
          },
          "reason": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "unsupported_organizational_input",
                  "missing_organizational_input",
                  "invalid_organizational_input"
                ]
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "outcome",
          "reason"
        ]
      },
      "then": {
        "properties": {
          "expected_state": {
            "type": "array"
          }
        }
      }
    }
  ]
}
