{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/tailoring.schema.json",
  "title": "SCAP-NG Tailoring v0.1.0 strawman",
  "description": "External local-policy modification bound to an exact Benchmark publication. Pre-alpha strawman; policy-resolution semantics are defined in the specification.",
  "type": "object",
  "required": ["tailoring"],
  "properties": {
    "tailoring": {
      "type": "object",
      "required": [
        "id","version","purpose","benchmark","profile","extends",
        "enabled_rules","disabled_rules","group_operations","parameters",
        "check_selectors","provenance"
      ],
      "properties": {
        "id": {"type":"string","minLength":1,"description":"Stable logical identity of this Tailoring artifact."},
        "version": {"type":["integer","string"],"description":"Tailoring version/revision."},
        "purpose": {"type":"string","minLength":1,"description":"Human-readable reason the Tailoring exists."},
        "benchmark": {
          "type":"object",
          "required":["id","version"],
          "properties":{
            "id":{"type":"string","minLength":1},
            "version":{"type":["string","integer"]}
          },
          "additionalProperties":false
        },
        "profile": {"type":["string","null"],"description":"Optional publisher Profile resolved before this Tailoring."},
        "extends": {"type":["string","null"],"description":"Optional parent Tailoring identity/path; cycles are semantically invalid."},
        "enabled_rules": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "disabled_rules": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "group_operations": {
          "type":"array",
          "items":{
            "type":"object",
            "required":["group","selected"],
            "properties":{
              "group":{"type":"string","minLength":1},
              "selected":{"type":"boolean"},
              "justification":{"type":["string","null"]}
            },
            "additionalProperties":false
          }
        },
        "parameters": {"type":"object","additionalProperties":true},
        "check_selectors": {
          "type":"object",
          "description":"Rule ID to published Assessment/check selector.",
          "additionalProperties":{"type":"string","minLength":1}
        },
        "provenance": {
          "type":"object",
          "required":[
            "organization","created_by","created_at","modified_by","modified_at",
            "authorized_by","authorized_at","authorization_reference",
            "authorization_status"
          ],
          "properties":{
            "organization":{"type":["string","object","null"]},
            "created_by":{"type":["string","object","null"]},
            "created_at":{"type":["string","null"],"format":"date-time"},
            "modified_by":{"type":["string","object","null"]},
            "modified_at":{"type":["string","null"],"format":"date-time"},
            "authorized_by":{"type":["string","object","null"]},
            "authorized_at":{"type":["string","null"],"format":"date-time"},
            "authorization_reference":{"type":["string","null"]},
            "authorization_status":{"type":["string","null"]}
          },
          "additionalProperties":true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
