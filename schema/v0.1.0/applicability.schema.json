{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/applicability.schema.json",
  "title": "SCAP-NG Applicability Catalog v0.1.0",
  "type": "object",
  "required": ["applicability"],
  "properties": {
    "applicability": {
      "type":"object",
      "required":["id","conditions"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "conditions":{
          "type":"object",
          "additionalProperties":{
            "type":"object",
            "required":["assessment"],
            "properties":{"assessment":{"type":"string","minLength":1}},
            "additionalProperties":false
          }
        }
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
