{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.1.0/scan-result.schema.json",
  "title": "SCAP-NG Scan Result v0.1.0 strawman",
  "description": "Run-level index for one scanner execution. Detailed Benchmark and Assessment results remain normalized package members referenced by identity/path.",
  "type": "object",
  "required": [
    "scan_result"
  ],
  "properties": {
    "scan_result": {
      "type": "object",
      "required": [
        "result_schema_version",
        "run_id",
        "started_at",
        "scanner",
        "targets",
        "benchmark_results"
      ],
      "properties": {
        "result_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scanner": {
          "type": "object"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "hostname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "benchmark_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "benchmark_result_ref",
              "benchmark_id",
              "target_ref"
            ],
            "properties": {
              "benchmark_result_ref": {
                "type": "string",
                "minLength": 1
              },
              "benchmark_id": {
                "type": "string",
                "minLength": 1
              },
              "benchmark_version": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "target_ref": {
                "type": "string",
                "minLength": 1
              },
              "profile_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tailoring_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "assessment_result_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signature_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
