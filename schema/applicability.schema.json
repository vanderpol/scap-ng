{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/schema/v0.4.1/applicability.schema.json",
  "x-scap-ng-version": "0.4.1",
  "x-last-modified": "2026-10-06",
  "title": "SCAP-NG Applicability Catalog v0.4.1",
  "type": "object",
  "required": [
    "applicability"
  ],
  "properties": {
    "applicability": {
      "type": "object",
      "required": [
        "id",
        "conditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [],
            "properties": {
              "assessment": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "description": "Source identity and digest for the condition; provenance is not executable semantics.",
                "required": [
                  "kind",
                  "id",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "xccdf_platform",
                      "cpe_platform",
                      "cpe_logical_test",
                      "converter_derived"
                    ],
                    "description": "Source provenance kind, not an evaluation operator."
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Source platform or CPE identity."
                  },
                  "href": {
                    "type": "string",
                    "description": "Optional original component href."
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "SHA-256 of the source platform element identity."
                  },
                  "idref": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Original XCCDF platform idref, including its leading fragment marker when present."
                  },
                  "expression_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "SHA-256 of the normalized CPE Boolean tree when one is available."
                  },
                  "cpe_expression": {
                    "type": "object",
                    "description": "Normalized CPE logical-test tree retaining operator and negation semantics.",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "One condition reference. assessment is optional only when no qualified executable mapping exists; the RI reports applicability ERROR rather than treating the condition as FALSE."
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "description": "Boolean applicability expression. A condition names one catalog condition; all_of/any_of preserve source Boolean structure; not preserves negation.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "condition"
          ],
          "properties": {
            "condition": {
              "type": "string",
              "minLength": 1,
              "description": "Catalog condition identifier. The condition is evaluated through the referenced applicability Assessment."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all_of"
          ],
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "All child expressions must be TRUE; ancestor levels use this operator to preserve inherited restrictions."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "any_of"
          ],
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              },
              "description": "At least one child expression must be TRUE; same-item source platform alternatives use this operator."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
