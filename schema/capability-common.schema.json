              "title": "Traversal kind",
              "description": "Explicit new-authoring selection for traversal kind; applies only in present traversal. Preserve source-effective values and visible overrides; no runtime fallback."
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "Independent/Unix file traversal. Preserves the complete non-deprecated OVAL recurse vocabulary."
    },
    "file_selection": {
      "type": "object",
      "properties": {
        "full_path": {
          "$ref": "#/$defs/object_entity_base"
        },
