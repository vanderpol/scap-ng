            "source_path": "third_party/scap-1.4-schemas/oval_5.12.3/oval-definitions-schema.xsd",
            "source_line": 464,
            "source_xpath": "/xsd:schema/xsd:element[7]/xsd:complexType/xsd:simpleContent/xsd:extension/xsd:attribute",
            "attribute": "action",
            "declaration_kind": "attribute",
            "source_type": "oval-def:FilterActionEnumeration",
            "source_default": "exclude",
            "declaration_context": [
              "filter"
            ],
            "source_sha256": "06b79e8683d6b9dcaad3ab074a456588ed82c4edd2e8fff209def10aa0a366cc",
            "reachability_limit": "QName dependency census; occurrence-specific overrides require review",
            "origin": "XSD_DECLARED_DEFAULT",
            "omission": "Use effective default after occurrence/restriction resolution; not native editor authority",
            "oval_qname": "{http://oval.mitre.org/XMLSchema/oval-definitions-5}filter/@action",
            "documentation": ""
