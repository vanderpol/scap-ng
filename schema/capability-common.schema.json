                "preserve_overrides": true,
                "authority": "https://github.com/vanderpol/scap-ng/issues/269"
              },
              "default": "directories",
              "title": "Traversal kind",
              "description": "Explicit new-authoring selection for traversal kind; applies only in present traversal. Preserve source-effective values and visible overrides; no runtime fallback."
            }
