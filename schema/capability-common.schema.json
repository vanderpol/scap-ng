    "file_traversal_base": {
      "type": "object",
      "required": [
        "max_depth",
        "recurse"
      ],
      "properties": {
        "max_depth": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "unlimited"
            }
          ],
          "description": "Maximum downward recursion depth: 0 means starting directory only, positive integers bound descendant depth, and unlimited has no depth limit. OVAL -1 imports as unlimited.",
          "x-scap-ng-authoring": {
            "version": 1,
            "control_id": "traversal_depth",
            "group": "traversal",
            "representation": "value",
            "hide_when_default": false,
