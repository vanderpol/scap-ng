    "object_record_field": {
      "$ref": "assessment-language.schema.json#/$defs/object_record_field_predicate",
      "description": "Collector Object record field. Required selection_match is independent from expected-value value_match and Test/State require; legacy match/value/operation not accepted."
    },
    "object_record": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/object_record_field"
          }
        },
        "redact_result": {
          "type": "boolean",
          "description": "When present, this value requests omission/redaction of the corresponding collected value from emitted result/evidence payloads. The only valid authored value is true; omit the property when redaction is not requested. This directive does not alter collection, comparison, aggregation, or technical truth.",
          "const": true
        }
      },
      "additionalProperties": false,
      "description": "Authored WMI/cmdlet collector input record. Named fields use one comparator-as-key and explicit selection_match, not the old match/value/operation syntax. Record names are structurally unique."
    },
    "filesystem_scope": {
      "type": "string",
      "enum": [
        "all",
        "local",
        "same"
      ],
      "default": "local",
      "x-scap-ng-authoring": {
        "group": "acquisition",
        "hide_when_default": true,
        "version": 1,
        "control_id": "filesystem",
        "representation": "value",
        "aggressive_preview": false,
        "context": "file_object",
        "new_authoring_only": true,
        "serialize_explicitly": true,
        "preserve_overrides": true,
        "authority": "https://github.com/vanderpol/scap-ng/issues/269",
        "oval_source": [
          {
            "source_path": "third_party/scap-1.4-schemas/oval_5.12.3/independent-definitions-schema.xsd",
            "source_line": 2932,
            "source_xpath": "/xsd:schema/xsd:complexType[6]/xsd:attribute[4]",
            "attribute": "recurse_file_system",
            "declaration_kind": "attribute",
            "source_type": null,
            "source_default": "all",
            "declaration_context": [
              "FileBehaviors"
            ],
            "source_sha256": "fdb8ab59e6f7c72c4c96666c84ce73603c6172d1cba6d3b2e168bb77ef6df566",
            "reachability_limit": "QName dependency census; occurrence-specific overrides require review",
            "origin": "XSD_DECLARED_DEFAULT",
            "omission": "Use effective default after occurrence/restriction resolution; not native editor authority",
            "oval_qname": "{http://oval.mitre.org/XMLSchema/oval-definitions-5#independent}FileBehaviors/@recurse_file_system",
            "documentation": "'recurse_file_system' defines the file system limitation of any searching and applies to all operations as specified on the path or filepath entity. The value of 'local' limits the search scope to local file systems (as opposed to file systems mounted from an external system). The value of 'defined' keeps any recursion within the file system that the file_object (path+filename or filepath) has specified. For example, on Windows, if the path specified was \"C:\\\", you would search only the C: drive, not other filesystems mounted to descendant paths. Similarly, on UNIX, if the path specified was \"/\", you would search only the filesystem mounted there, not other filesystems mounted to descendant paths. The value of 'defined' only applies when an equality operation is used for searching because the path or filepath entity must explicitly define a file system. The default value is 'all' meaning to search all available file systems for data collection. Note that in most cases it is recommended that the value of 'local' be used to ensure that file system searching is limited to only the local file systems. Searching 'all' file systems may have performance implications."
          }
        ]
      },
      "description": "For newly authored NG file Objects, editors suggest local and serialize it explicitly (optionally hidden in the editor). This annotation is not a scanner/runtime default. Source conversion must retain the effective OVAL recurse_file_system value: omitted OVAL means all, explicitly local means local, and defined maps to same. Filesystem scope is independent of recursion and applies to full_path as well as directory/name selection.",
      "title": "Filesystem"
    },
    "foreach_binding": {
      "type": "object",
      "required": [
        "item",
        "in"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Lexical name for one Item produced by the source Object."
        },
        "in": {
          "$ref": "#/$defs/object_reference"
        }
      },
      "additionalProperties": false,
      "description": "Native 0.4 collection-expansion foreach binding. The source is one named shared/referenceable Object. Chaining is permitted: a source Object may itself use for_each, creating correlated lexical lineage. Independent multi-source Cartesian expansion is not implicit."
    },
    "foreach_selector_binding": {
      "type": "object",
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Bind this target selector from one field of the current foreach Item, e.g. user.home_dir."
        }
      },
      "additionalProperties": false,
      "description": "Bind this selector from one field of a visible foreach lineage alias, e.g. user.home_dir. In a chained foreach, aliases inherited from the source Object remain correlated and visible."
    },
    "object_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-object$"
    },
    "inline_object": {
      "type": "object",
      "required": [],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "title": "Collection capability",
          "description": "Optional for inline Objects only, whose capability is inherited from the enclosing Test; when supplied it must agree with the Test capability."
        },
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_filter"
          },
          "description": "Leaf Object post-collection Filters; observed Items, not selectors or compliance States."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "result"
            ]
          },
          {
            "required": [
              "collect"
            ]
          }
        ]
      },
      "additionalProperties": true,
      "description": "Inline native Object. Capability-specific resource selectors and acquisition parameters are direct Object fields; generic select/collect wrappers are not part of the 0.4.1 grammar. The capability-specific generated schema validates each direct field, including native windows.cmdlet select. Filters and Set operations retain their own semantic boundaries.",
      "title": "Inline collection Object",
      "allOf": [
        {
          "not": {
            "required": [
              "set",
              "filters"
            ]
          }
        }
      ]
    },
    "object_use": {
      "oneOf": [
        {
          "$ref": "#/$defs/object_reference"
        },
        {
          "$ref": "#/$defs/inline_object"
        }
      ],
      "title": "Object declaration or reference",
      "description": "Use an inline Object or an existing shared Object."
    },
