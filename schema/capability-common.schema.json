        },
        {
          "type": "object",
          "properties": {
            "recurse": {
              "type": "string",
              "enum": [
                "directories",
                "symlinks",
                "symlinks_and_directories"
              ],
              "x-scap-ng-authoring": {
                "version": 1,
                "control_id": "traversal_kind",
                "group": "traversal",
                "representation": "value",
                "hide_when_default": false,
                "aggressive_preview": true,
                "context": "present_traversal",
                "new_authoring_only": true,
                "serialize_explicitly": true,
                "preserve_overrides": true,
                "authority": "https://github.com/vanderpol/scap-ng/issues/269"
              },
