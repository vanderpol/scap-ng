{
  "assessment": {
    "id": "ng.shared.home-is-mounted-with-the-nosuid-option",
    "version": 1,
    "assessment_title": "Linux must prevent files with the setuid and setgid bit set from being executed on file systems that contain user home directories.",
    "mode": "automated",
    "class": "compliance",
    "purpose": "assessment",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "tests": {
      "home-mounted-nosuid-option-test": {
        "test_title": "/home is mounted with the nosuid option.",
        "capability": "linux.partition",
        "object": {
          "capability": "linux.partition",
          "select": {
            "mount_point": {
              "matches_regex": ".*\\/home"
            }
          },
          "object_title": null
        },
        "states": [
          {
            "mount_options": {
              "require": "at_least_one_exists_and_some_match",
              "equals": "nosuid"
            }
          }
        ],
        "reported_elements": "all",
        "require": "at_least_one_exists_and_all_match"
      }
    },
    "evaluate": {
      "test": "home-mounted-nosuid-option-test"
    }
  }
}
