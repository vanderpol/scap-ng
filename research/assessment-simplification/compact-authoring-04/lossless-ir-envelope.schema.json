{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/research/0.4-a/lossless-ir-envelope-0.2.schema.json",
  "title": "SCAP-NG 0.4-A lossless research compiler source envelope v0.2 (NOT EXECUTABLE)",
  "description": "Non-executable v0.1 transport/index over complete validated base-authoring ASTs; source_ast is losslessly preserved, not evaluated. This research JSON Schema is not a versioned normative SCAP-NG schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "source_graph_sha256",
    "version_inventory",
    "document_count",
    "automated_assessment_count",
    "automated_test_count",
    "rule_choice_link_count",
    "documents",
    "not_proven"
  ],
  "properties": {
    "format": {
      "const": "scap-ng-0.4-a-lossless-source-envelope/0.2"
    },
    "status": {
      "const": "RESEARCH_NOT_EXECUTABLE"
    },
    "source_graph_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "version_inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "document_count": {
      "type": "integer",
      "minimum": 1
    },
    "automated_assessment_count": {
      "type": "integer",
      "minimum": 0
    },
    "automated_test_count": {
      "type": "integer",
      "minimum": 0
    },
    "rule_choice_link_count": {
      "type": "integer",
      "minimum": 0
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "not_proven": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "source_path",
        "source_sha256",
        "source_ast"
      ],
      "properties": {
        "kind": {
          "enum": [
            "assessment",
            "rule",
            "benchmark",
            "applicability"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "pattern": "^authoring/.+\\.json$"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_ast": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "description": "Complete canonical parsed source document, including every unrecognized-but-validated subtree and all provenance. Never discard a member."
        },
        "assessment_index": {
          "$ref": "#/$defs/assessment_index"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assessment"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "assessment_index"
            ]
          },
          "else": {
            "not": {
              "required": [
                "assessment_index"
              ]
            }
          }
        }
      ]
    },
    "assessment_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "assessment_dependencies",
        "tests"
      ],
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "automated"
          ]
        },
        "assessment_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "target",
              "expected_version",
              "purpose"
            ],
            "properties": {
              "alias": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "expected_version": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "purpose": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "capability",
              "item_requirement",
              "source_sha256",
              "collection_reference_hints"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "item_requirement": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "collection_reference_hints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "path",
                    "target"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "variable",
                        "shared_object"
                      ]
                    },
                    "path": {
                      "type": "array",
                      "items": {
                        "type": [
                          "integer",
                          "string"
                        ]
                      }
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "specification": {
          "type": "object",
          "additionalProperties": {
            "description": "Full source declaration retained, with identity checked again by decoder."
          },
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_dataflow": {
          "$ref": "#/$defs/source_dataflow"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "automated"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "specification",
              "source_dataflow"
            ],
            "properties": {
              "tests": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "specification"
                  ]
                },
                {
                  "required": [
                    "source_dataflow"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "source_dataflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "nodes",
        "edges",
        "sites",
        "dependency_first_source_order",
        "edge_count",
        "unverified"
      ],
      "properties": {
        "status": {
          "const": "SOURCE_DATAFLOW_ONLY_NOT_EXECUTABLE"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_edge"
          }
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_site"
          }
        },
        "dependency_first_source_order": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "object",
                  "variable"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_path": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "integer"
        ]
      }
    },
    "source_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path",
        "source_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "object",
            "variable",
            "test"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/source_path"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_kind",
        "from_id",
        "to_kind",
        "to_id",
        "role",
        "path"
      ],
      "properties": {
        "from_kind": {
          "enum": [
            "object",
            "variable",
            "test"
          ]
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_kind": {
          "enum": [
            "object",
            "variable"
          ]
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "variable_value",
            "object_acquisition",
            "for_each_source"
          ]
        },
        "path": {
          "$ref": "#/$defs/source_path"
        }
      }
    },
    "source_site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "source_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "for_each",
            "set",
            "filter",
            "projection"
          ]
        },
        "path": {
          "$ref": "#/$defs/source_path"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
