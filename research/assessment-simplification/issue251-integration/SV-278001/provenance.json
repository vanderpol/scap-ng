    {
      "id": "oval:navy.navwar.niwcatlantic.scc.windows:obj:27800101",
      "type": "shellcommand_object",
      "attributes": {
        "id": "oval:navy.navwar.niwcatlantic.scc.windows:obj:27800101",
        "version": "1",
        "comment": "Gather permissions for the HKEY_LOCAL_MACHINE\\SECURITY registry"
      },
      "entities": [
        {
          "type": "shell",
          "attributes": {},
          "text": "powershell"
        },
        {
          "type": "command",
          "attributes": {},
          "text": "([Microsoft.Win32.Registry]::LocalMachine.OpenSubKey(\"Security\", [System.Security.AccessControl.RegistryRights]::ReadPermissions)).GetAccessControl().Access |  Where-Object { $_.RegistryRights -notmatch '\\d+' } | ForEach-Object { \"Identity:$($_.IdentityReference), Rights: $($_.RegistryRights), Access: $($_.AccessControlType), IsInherited: $($_.IsInherited), InheritanceFlags: $($_.InheritanceFlags), PropagationFlags: $($_.PropagationFlags)\" }"
        }
      ]
    },
