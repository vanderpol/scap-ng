      "entities": [
        {
          "type": "concat",
          "attributes": {},
          "text": ""
        },
        {
          "type": "literal_component",
          "attributes": {},
          "text": "try {Get-DnsServerZone -Name"
        },
        {
          "type": "object_component",
          "attributes": {
            "object_ref": "oval:navy.navwar.niwcatlantic.scc.windows:obj:25934502",
            "item_field": "stdout_line"
          },
          "text": ""
        },
        {
          "type": "literal_component",
          "attributes": {},
          "text": "| ForEach-Object {$_.IsSigned}} catch {}"
        }
      ]
    },
    {
      "id": "oval:navy.navwar.niwcatlantic.scc.windows:var:25934503",
      "type": "local_variable",
      "attributes": {
        "id": "oval:navy.navwar.niwcatlantic.scc.windows:var:25934503",
        "version": "8",
        "datatype": "string",
        "comment": "The command to get the list of DNS key signature validity periods for the zone signing keys"
      },
      "entities": [
        {
          "type": "concat",
          "attributes": {},
          "text": ""
        },
        {
          "type": "literal_component",
          "attributes": {},
          "text": "try {Get-DNSServerSigningKey -ZoneName"
        },
        {
          "type": "object_component",
          "attributes": {
            "object_ref": "oval:navy.navwar.niwcatlantic.scc.windows:obj:25934502",
            "item_field": "stdout_line"
          },
          "text": ""
        },
        {
          "type": "literal_component",
          "attributes": {},
          "text": "| Where-Object KeyType -eq 'ZoneSigningKey' | ForEach-Object {$_.DnsKeySignatureValidityPeriod.Days * 24 + $_.DnsKeySignatureValidityPeriod.Hours}} catch {Write-Output '0'}"
        }
      ]
    },
