          "text": "| Where-Object KeyType -eq 'KeySigningKey' | ForEach-Object {$_.DnsKeySignatureValidityPeriod.Days * 24 + $_.DnsKeySignatureValidityPeriod.Hours}} catch {Write-Output '0'}"
        }
