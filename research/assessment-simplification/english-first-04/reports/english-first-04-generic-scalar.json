      "candidate": {
        "check": "Gather all installation directories from running apache httpd processes",
        "collect": {
          "command": "ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq",
          "error_if_exit_status_not_0": false,
          "error_if_stderr_exists": false,
          "pattern": "^\\/\\S+(\\/httpd|\\/apache2)\\s*",
          "shell": "bash"
        },
        "inspect": "independent.shellcommand",
        "report_elements": "all",
        "require": {
          "at_least_one_item_exists": true,
          "every_collected_item": {
            "stdout_line": {
              "has_only_values_matching_regex": "^/"
            }
          }
        }
      },
      "source": "authoring/apache_server_2-4_unix_server/assessments/applicability/platform.cpe-apache-http-server-2-4.yaml",
