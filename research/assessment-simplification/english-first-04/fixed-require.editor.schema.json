      "description": "A windows.registry State with capability-constrained field completion",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "scope",
            "and"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "fields",
              "description": "fields must be chosen explicitly to avoid changing which observations are combined"
            },
            "and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/capStateNode__windows_registry"
              }
            },
            "all_fields_must_exist": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "scope",
            "or"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "fields",
              "description": "fields must be chosen explicitly to avoid changing which observations are combined"
            },
            "or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/capStateNode__windows_registry"
              }
            },
            "all_fields_must_exist": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "hive": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'hive'; operator/value semantics validated separately"
            },
            "key": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'key'; operator/value semantics validated separately"
            },
            "name": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'name'; operator/value semantics validated separately"
            },
            "last_write_time": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'last_write_time'; operator/value semantics validated separately"
            },
            "type": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'type'; operator/value semantics validated separately"
            },
            "value": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'value'; operator/value semantics validated separately"
            },
            "expanded_value": {
              "type": "object",
              "minProperties": 1,
              "description": "windows.registry observed field 'expanded_value'; operator/value semantics validated separately"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "capCondition__windows_registry": {
      "description": "Condition on windows.registry, with explicit grouped-scope requirements",
      "oneOf": [
        {
          "$ref": "#/$defs/capStateNode__windows_registry"
        },
        {
          "type": "object",
          "required": [
            "scope",
            "and"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "states",
              "description": "states must be chosen explicitly to avoid changing which observations are combined"
            },
            "and": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/capStateNode__windows_registry"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "scope",
            "or"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "states",
              "description": "states must be chosen explicitly to avoid changing which observations are combined"
            },
            "or": {
