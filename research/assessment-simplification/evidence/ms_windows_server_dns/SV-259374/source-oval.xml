        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937401" version="8" comment="The list of online network adapter interface indexes">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Get-NetAdapter | Where-Object Status -EQ 'Up' | ForEach-Object {$_.ifIndex}</independent-def:command>
        </independent-def:shellcommand_object>
        <independent-def:variable_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937402" version="8" comment="The number of online network adapter interface indexes">
