        </independent-def:shellcommand_object>
        </objects><states><independent-def:variable_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25937401" version="8" comment="The number of online network adapter interface indexes is 0">
          <independent-def:value operation="equals" entity_check="all" check_existence="only_one_exists">0</independent-def:value>
        </independent-def:variable_state>
