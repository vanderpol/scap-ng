        </independent-def:shellcommand_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25937401" version="8" datatype="int" comment="The number of online network adapter interface indexes">
          <count>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937401" item_field="stdout_line"/>
          </count>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25937402" version="8" datatype="string" comment="The command to get the IPv4 address for each online network adapter">
          <concat>
            <literal_component>try {Get-NetIPConfiguration -InterfaceIndex </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937401" item_field="stdout_line"/>
            <literal_component> | ForEach-Object {$_.IPv4Address.IPAddress}} catch {}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25937403" version="8" datatype="string" comment="The command to get the prefix length (subnet mask) for each online network adapter">
          <concat>
            <literal_component>try {Get-NetIPConfiguration -InterfaceIndex </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937401" item_field="stdout_line"/>
            <literal_component> | ForEach-Object {$_.IPv4Address.PrefixLength}} catch {}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25937404" version="8" datatype="string" comment="The command to get the default gateway for each online network adapter">
          <concat>
            <literal_component>try {Get-NetIPConfiguration -InterfaceIndex </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937401" item_field="stdout_line"/>
            <literal_component> | ForEach-Object {$_.IPv4DefaultGateway.NextHop}} catch {}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25937405" version="8" datatype="string" comment="The command to get the suffix origin for each online network adapter">
