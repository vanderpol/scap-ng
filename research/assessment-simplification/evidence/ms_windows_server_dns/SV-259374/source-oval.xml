          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:25937402"/>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25937404" version="8" comment="The prefix length (subnet mask) for each online network adapter">
