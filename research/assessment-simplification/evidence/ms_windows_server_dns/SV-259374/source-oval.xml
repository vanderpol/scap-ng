      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:259374" version="8" class="compliance">
          <metadata>
            <title>The Windows DNS Server's IP address must be statically defined and configured locally on the server.</title>
            <description>The Windows DNS Server's IP address must be statically defined and configured locally on the server.</description>
          </metadata>
          <criteria operator="OR">
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25937401" comment="There are no online network adapters"/>
            <criteria operator="AND" comment="There are online network adapters">
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25937402" comment="All online network adapters have an IPv4 address"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25937403" comment="All online network adapters have a prefix length (subnet mask"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25937404" comment="All online network adapters have a default gateway"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25937405" comment="All online network adapters have a suffix origin equal to 'Manual'"/>
            </criteria>
          </criteria>
        </definition>
        </definitions><tests><independent-def:variable_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25937401" version="8" comment="There are no online network adapters" check_existence="at_least_one_exists" check="all">
