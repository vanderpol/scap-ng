      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:259350" version="8" class="compliance">
          <metadata>
            <title>The Windows DNS Server must enforce approved authorizations between DNS servers using digital signatures in the Resource Record Set (RRSet).</title>
            <description>Zones are DNSSEC signed and contain the appropriate security records.</description>
          </metadata>
          <criteria operator="OR">
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935002" comment="DNS server is caching only (there are no forward or reverse lookup zones)"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935003" comment="All forward lookup zones (if any) are integrated with Active Directory"/>
            <criteria operator="AND">
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935005" comment="All forward lookup zones are DNSSEC signed"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935006" comment="All forward lookup zones have at least one Resource Record Signature (RRSIG)"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935007" comment="All forward lookup zones have at least one NSEC3 record"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935008" comment="All forward lookup zones have at least one DNSKEY record"/>
            </criteria>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935002" version="8" comment="DNS server is caching only (there are no forward or reverse lookup zones)" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935003"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935002"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935003" version="8" comment="All forward lookup zones (if any) are integrated with Active Directory" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935006"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935003"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935005" version="8" comment="All forward lookup zones are DNSSEC signed" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935008"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935006"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935006" version="8" comment="All forward lookup zones have at least one Resource Record Signature (RRSIG)" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935010"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935007"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935007" version="8" comment="All forward lookup zones have at least one NSEC3 record" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935011"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935008"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25935008" version="8" comment="All forward lookup zones have at least one DNSKEY record" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935012"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935009"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935004" version="8" comment="The list of all forward lookup zones">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Get-DnsServerZone | Where-Object {$_.ZoneType -notin @('Forwarder') -and $_.ZoneName -notin @('TrustAnchors') -and (-Not $_.IsAutoCreated) -and -Not($_.IsReverseLookupZone)} | ForEach-Object {$_.ZoneName}</independent-def:command>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935008" version="8" comment="The 'IsSigned' setting for each forward lookup zone">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:25935003"/>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935010" version="8" comment="The number of Resource Record Signatures (RRSIG) for a given zone">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:25935004"/>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935011" version="8" comment="The number of NSEC3 records for a given zone">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:25935005"/>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935012" version="8" comment="The number of DNSKEY records for a given zone">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:25935006"/>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935003" version="8" comment="The list of all forward and reverse lookup zones">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Get-DnsServerZone | Where-Object {$_.ZoneType -notin @('Forwarder') -and $_.ZoneName -notin @('TrustAnchors') -and (-Not $_.IsAutoCreated)} | ForEach-Object {$_.ZoneName}</independent-def:command>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935006" version="8" comment="The list of all forward lookup zones that are not integrated with Active Directory">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Get-DnsServerZone | Where-Object {$_.ZoneType -notin @('Forwarder') -and $_.ZoneName -notin @('TrustAnchors') -and (-Not $_.IsAutoCreated) -and -Not($_.IsReverseLookupZone) -and (-Not $_.IsDsIntegrated)} | ForEach-Object {$_.ZoneName}</independent-def:command>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935002" version="8" comment="There are no forward or reverse lookup zones">
          <independent-def:stdout_line check_existence="none_exist"/>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935003" version="8" comment="There are no forward lookup zones that are not integrated with Active Directory">
          <independent-def:stdout_line check_existence="none_exist"/>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935006" version="8" comment="The 'IsSigned' setting for each forward lookup zone is set to 'True'">
          <independent-def:stdout_line operation="equals" entity_check="all" check_existence="only_one_exists">True</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935007" version="8" comment="The number of RRSIGs (Resource Record Signatures) associated with a zone is greater than 0">
          <independent-def:stdout_line operation="greater than" entity_check="all" check_existence="only_one_exists" datatype="int">0</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935008" version="8" comment="The number of NSEC3 records associated with a zone is greater than 0">
          <independent-def:stdout_line operation="greater than" entity_check="all" check_existence="only_one_exists" datatype="int">0</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25935009" version="8" comment="The number of DNSKEY records associated with a zone is greater than 0">
          <independent-def:stdout_line operation="greater than" entity_check="all" check_existence="only_one_exists" datatype="int">0</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25935003" version="8" datatype="string" comment="The command to get the 'IsSigned' setting for each forward lookup zone">
          <concat>
            <literal_component>try {Get-DnsServerZone -Name </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935004" item_field="stdout_line"/>
            <literal_component> | ForEach-Object {$_.IsSigned}} catch {}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25935004" version="8" datatype="string" comment="The command to get the number of Resource Record Signatures (RRSIGs) for a given zone">
          <concat>
            <literal_component>try {Get-DNSServerResourceRecord -ComputerName $env:COMPUTERNAME -ZoneName </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935004" item_field="stdout_line"/>
            <literal_component> -RRType RRSig | Measure-Object | Select-Object -ExpandProperty Count} catch {Write-Output '0'}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25935005" version="8" datatype="string" comment="The command to get the number of NSEC3 records for a given zone">
          <concat>
            <literal_component>try {Get-DNSServerResourceRecord -ComputerName $env:COMPUTERNAME -ZoneName </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935004" item_field="stdout_line"/>
            <literal_component> -RRType NSec3 | Measure-Object | Select-Object -ExpandProperty Count} catch {Write-Output '0'}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25935006" version="8" datatype="string" comment="The command to get the number of DNSKEY records for a given zone">
          <concat>
            <literal_component>try {Get-DNSServerResourceRecord -ComputerName $env:COMPUTERNAME -ZoneName </literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25935004" item_field="stdout_line"/>
            <literal_component> -RRType DnsKey | Measure-Object | Select-Object -ExpandProperty Count} catch {Write-Output '0'}</literal_component>
          </concat>
        </local_variable>
        </variables></oval_definitions>
