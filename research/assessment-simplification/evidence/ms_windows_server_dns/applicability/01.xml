          </criteria>
        </definition>
        </definitions><tests><win-def:file_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:201" version="8" comment="The %ALLUSERSPROFILE%\Microsoft\Crypto folder exists" check_existence="at_least_one_exists" check="all">
