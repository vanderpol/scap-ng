      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.unix.apache:def:214228" version="2" class="compliance">
          <metadata>
            <title>The Apache web server must limit the number of allowed simultaneous session requests.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422801" comment="Verify that KeepAlive directive is defined, and configured to On in httpd.conf/apache2.conf or included conf files"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422802" comment="If the KeepAlive directive is defined in other loaded configuration files, verify it is configured to On"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422803" comment="Verify that MaxKeepAliveRequests is defined and is configured to 100 or greater httpd.conf/apache2.conf or included conf files"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422804" comment="If the MaxKeepAliveRequests directive is defined in other loaded configuration files, verify it is configured to 100 or greater"/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422801" version="2" comment="Verify that KeepAlive directive is defined, and configured to On in httpd.conf/apache2.conf or included conf files" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422801"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422801"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422802" version="2" comment="If the KeepAlive directive is defined in other loaded configuration files, verify it is configured to On" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422802"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422802"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422803" version="2" comment="Verify that MaxKeepAliveRequests is defined and is configured to 100 or greater httpd.conf/apache2.conf or included conf files" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422803"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422803"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21422804" version="2" comment="If the MaxKeepAliveRequests directive is defined in other loaded configuration files, verify it is configured to 100 or greater" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422804"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422804"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422801" version="2" comment="Gather all KeepAlive data from httpd and all Include conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422809"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422802" version="2" comment="Gather all KeepAlive data from all loaded conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422808"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422803" version="2" comment="Gather all MaxKeepAliveRequests data from httpd and all Include conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422814"/>
          <independent-def:pattern>MaxKeepAliveRequests (\d+)</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422804" version="2" comment="Gather all MaxKeepAliveRequests data from all loaded conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422813"/>
          <independent-def:pattern>MaxKeepAliveRequests (\d+)</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422810" version="2" comment="Gather unique apache http installation paths">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq</independent-def:command>
          <independent-def:pattern>^\/\S+(\/httpd|\/apache2)\s*</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422820" version="2" comment="Gather HTTPD_ROOT files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422802"/>
          <independent-def:pattern>HTTPD_ROOT</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422830" version="2" comment="Gather SERVER_CONFIG_FILE files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422803"/>
          <independent-def:pattern>SERVER_CONFIG_FILE</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422840" version="2" comment="Gather Include statements from httpd.conf">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422820"/>
          <independent-def:pattern>\S+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422850" version="2" comment="Gather all loaded config files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422850"/>
          <independent-def:pattern> \(</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422801" version="2" comment="KeepAlive is On">
          <independent-def:stdout_line entity_check="all" operation="pattern match">\s*KeepAlive On</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422802" version="2" comment="KeepAlive is On (if found)">
          <independent-def:stdout_line check_existence="any_exist" entity_check="all" operation="pattern match">\s*KeepAlive On</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422803" version="2" comment="MaxKeepAliveRequests not less than 100">
          <independent-def:subexpression entity_check="all" datatype="int" operation="greater than or equal">100</independent-def:subexpression>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21422804" version="2" comment="MaxKeepAliveRequests is not less than 100 (if found)">
          <independent-def:subexpression check_existence="any_exist" entity_check="all" datatype="int" operation="greater than or equal">100</independent-def:subexpression>
        </independent-def:shellcommand_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422801" datatype="string" version="2" comment="Apache base install directories (unix)">
          <regex_capture pattern="(^\/.+\/)httpd|(^\/.+/)apache2">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422810" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422802" datatype="string" version="2" comment="httpd_root to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422801"/>
            <literal_component datatype="string">apachectl -V | grep -i 'httpd_root'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422803" datatype="string" version="2" comment="server_config_file to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422801"/>
            <literal_component datatype="string">apachectl -V | grep -i 'server_config_file'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422804" datatype="string" version="2" comment="Filepath to HTTPD_ROOT">
          <regex_capture pattern=" -D HTTPD_ROOT=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422820" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422805" datatype="string" version="2" comment="relative to SERVER_CONFIG_FILE">
          <regex_capture pattern=" -D SERVER_CONFIG_FILE=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422830" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422806" datatype="string" version="2" comment="Filepath to http conf file">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422804"/>
            <literal_component datatype="string">/</literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422805"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422808" datatype="string" version="2" comment="shell command to check KeepAlive in all loaded conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*KeepAlive' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422852"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422809" datatype="string" version="2" comment="shell command to check KeepAlive in httpd.conf and all Include conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*KeepAlive' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422843"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422813" datatype="string" version="2" comment="shell command to check MaxKeepAliveRequests in all loaded conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*MaxKeepAliveRequests' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422852"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422814" datatype="string" version="2" comment="shell command to check MaxKeepAliveRequests in httpd.conf and all Include conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*MaxKeepAliveRequests' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422843"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422810" datatype="string" version="2" comment="Apache path to httpd or apache2">
          <regex_capture pattern="(^\/.+\/httpd|^\/.+\/apache2) ">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422810" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422820" datatype="string" version="2" comment="shell command to check for all Include and Include Optional files">
          <concat>
            <literal_component datatype="string">grep -iEHn '^\s*Include\s+|^\s*IncludeOptional\s+' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422806"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422841" datatype="string" version="2" comment="All included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422804"/>
            <literal_component datatype="string">/</literal_component>
            <regex_capture pattern="\S+\s+(\S+)\s*">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422840" item_field="stdout_line"/>
            </regex_capture>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422842" datatype="string" version="2" comment="merged included conf files from Include refernces in httd.conf">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422841"/>
          </merge>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422843" datatype="string" version="2" comment="httpd.conf and merged included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422806"/>
            <literal_component> </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422842"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422850" datatype="string" version="2" comment="command to gather httpd/apache2 list of all loaded configuration files">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422810"/>
            <literal_component datatype="string"> -t -D DUMP_INCLUDES</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422851" datatype="string" version="2" comment="All loaded configuration filepaths">
          <unique>
            <regex_capture pattern="\(.*\) (/.*)">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21422850" item_field="stdout_line"/>
            </regex_capture>
          </unique>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422852" datatype="string" version="2" comment="Merged list of all loaded config files">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21422851"/>
          </merge>
        </local_variable>
        </variables></oval_definitions>
