        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426831" version="2" comment="SessionCookieName is configured with Secure">
          <independent-def:stdout_line entity_check="all" operation="pattern match">(?i)Secure</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426804" version="2" comment="If the SessionCookieName directive is found, it is is configured with HttpOnly">
          <independent-def:stdout_line check_existence="any_exist" entity_check="all" operation="pattern match">(?i)HttpOnly</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426841" version="2" comment="If the SessionCookieName directive is found, it is configured with Secure">
          <independent-def:stdout_line check_existence="any_exist" entity_check="all" operation="pattern match">(?i)Secure</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426805" version="2" comment="session_cookie_module must be enabled">
          <independent-def:stdout_line entity_check="at least one" datatype="string" operation="pattern match">session_cookie_module</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426801" datatype="string" version="2" comment="Apache base install directories (unix)">
          <regex_capture pattern="(^\/.+\/)httpd|(^\/.+/)apache2">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426810" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426802" datatype="string" version="2" comment="httpd_root to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426801"/>
            <literal_component datatype="string">apachectl -V | grep -i 'httpd_root'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426803" datatype="string" version="2" comment="server_config_file to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426801"/>
            <literal_component datatype="string">apachectl -V | grep -i 'server_config_file'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426804" datatype="string" version="2" comment="Filepath to HTTPD_ROOT">
          <regex_capture pattern=" -D HTTPD_ROOT=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426820" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426805" datatype="string" version="2" comment="relative to SERVER_CONFIG_FILE">
          <regex_capture pattern=" -D SERVER_CONFIG_FILE=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426830" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426806" datatype="string" version="2" comment="Filepath to http conf file">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426804"/>
            <literal_component datatype="string">/</literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426805"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426808" datatype="string" version="2" comment="shell command to check Session in all loaded conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*Session ' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426852"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426809" datatype="string" version="2" comment="shell command to check Session in httpd.conf and all Include conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*Session ' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426843"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426813" datatype="string" version="2" comment="shell command to check SessionCookieName in all loaded conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*SessionCookieName' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426852"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426814" datatype="string" version="2" comment="shell command to check SessionCookieName in httpd.conf and all Include conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*SessionCookieName' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426843"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426810" datatype="string" version="2" comment="Apache path to httpd or apache2">
          <regex_capture pattern="(^\/.+\/httpd|^\/.+\/apache2) ">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426810" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426811" datatype="string" version="2" comment="command to gather httpd/apache2 modules">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426810"/>
            <literal_component datatype="string"> -M</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426820" datatype="string" version="2" comment="shell command to check for all Include and Include Optional files">
          <concat>
            <literal_component datatype="string">grep -iEHn '^\s*Include\s+|^\s*IncludeOptional\s+' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426806"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426841" datatype="string" version="2" comment="All included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426804"/>
            <literal_component datatype="string">/</literal_component>
            <regex_capture pattern="\S+\s+(\S+)\s*">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426840" item_field="stdout_line"/>
            </regex_capture>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426842" datatype="string" version="2" comment="merged included conf files from Include refernces in httd.conf">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426841"/>
          </merge>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426843" datatype="string" version="2" comment="httpd.conf and merged included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426806"/>
            <literal_component> </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426842"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426850" datatype="string" version="2" comment="command to gather httpd/apache2 list of all loaded configuration files">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426810"/>
            <literal_component datatype="string"> -t -D DUMP_INCLUDES</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426851" datatype="string" version="2" comment="All loaded configuration filepaths">
          <unique>
            <regex_capture pattern="\(.*\) (/.*)">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426850" item_field="stdout_line"/>
            </regex_capture>
          </unique>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426852" datatype="string" version="2" comment="Merged list of all loaded config files">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426851"/>
          </merge>
        </local_variable>
        </variables></oval_definitions>
