      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.unix.apache:def:214268" version="2" class="compliance">
          <metadata>
            <title>Cookies exchanged between the Apache web server and the client, such as session cookies, must have cookie properties set to prohibit client-side scripts from reading the cookie data.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21426801" comment="Verify the Session directive exists and is configured to On for all httpd.conf/apache2.conf or included conf files"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21426802" comment="If the Session directive exists in other loaded configuration files, verify is is configured to On"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21426803" comment="Verify that SessionCookieName directive exists and is configured with HttpOnly and Secure in httpd.conf/apache2.conf or included conf files"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21426804" comment="If the SessionCookieName directive exists in other loaded configuration files, verify it is configured with HttpOnly"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21426805" comment="The Apache session_cookie_module must be enabled"/>
          </criteria>
        </definition>
