          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426802"/>
          <independent-def:pattern>HTTPD_ROOT</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426830" version="2" comment="Gather SERVER_CONFIG_FILE files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426803"/>
          <independent-def:pattern>SERVER_CONFIG_FILE</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426840" version="2" comment="Gather Include statements from httpd.conf">
