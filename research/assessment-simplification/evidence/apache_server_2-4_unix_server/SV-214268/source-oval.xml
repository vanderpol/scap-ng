        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426802" version="2" comment="Gather all Session data from all loaded conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426808"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426803" version="2" comment="Gather all SessionCookieName data from httpd and all Include conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426814"/>
          <independent-def:pattern>SessionCookieName .+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426804" version="2" comment="Gather all SessionCookieName data from all loaded conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426813"/>
          <independent-def:pattern>SessionCookieName .+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426805" version="2" comment="Gather all installed modules and filter on session_cookie_module">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426811"/>
          <independent-def:pattern>session_cookie_module</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426810" version="2" comment="Gather unique apache http installation paths">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq</independent-def:command>
          <independent-def:pattern>^\/\S+(\/httpd|\/apache2)\s*</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426820" version="2" comment="Gather HTTPD_ROOT files via apachectl">
