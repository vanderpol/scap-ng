        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426802" version="2" comment="Session is On (if found)">
          <independent-def:stdout_line check_existence="any_exist" entity_check="all" operation="pattern match">(?i)Session On</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426803" version="2" comment="SessionCookieName is configured with HttpOnly">
          <independent-def:stdout_line entity_check="all" operation="pattern match">(?i)HttpOnly</independent-def:stdout_line>
