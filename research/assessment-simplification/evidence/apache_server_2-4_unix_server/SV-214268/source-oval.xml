          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426820"/>
          <independent-def:pattern>\S+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21426850" version="2" comment="Gather all loaded config files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21426850"/>
          <independent-def:pattern> \(</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21426801" version="2" comment="Session is On">
          <independent-def:stdout_line entity_check="all" operation="pattern match">(?i)Session On</independent-def:stdout_line>
