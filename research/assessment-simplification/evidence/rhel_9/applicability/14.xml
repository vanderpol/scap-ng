      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.rhel9os:def:201" version="13" class="compliance">
          <metadata>
            <title>Platform specification check to determine if a machine appears to be virtual or bare metal.</title>
            <description>Platform specification check to determine if a machine appears to be virtual or bare metal.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.rhel9os:tst:201" comment="Return 'true' if host appears to be bare metal, not virtual."/>
