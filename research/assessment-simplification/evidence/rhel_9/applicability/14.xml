      </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.rhel9os:tst:201" check_existence="at_least_one_exists" check="at least one" version="13" comment="Query lscpu for indication of a hypervisor vendor.">
