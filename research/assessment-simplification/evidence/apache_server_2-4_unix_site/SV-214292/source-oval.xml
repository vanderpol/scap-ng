      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.unix.apache:def:214292" version="2" class="compliance">
          <metadata>
            <title>The Apache web server must display a default hosted application web page, not a directory listing, when a requested web page cannot be found.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21429203" comment="Index.html must exist for any DocumentRoot defined in httpd.conf and included conf files"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21429204" comment="Index.html must exist for any DocumentRoot defined in any loaded config file"/>
          </criteria>
        </definition>
        </definitions><tests><unix-def:file_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21429203" version="2" comment="Index.html must exist for any DocumentRoot defined in httpd.conf and included conf files" check_existence="at_least_one_exists" check="all">
          <unix-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429203"/>
        </unix-def:file_test>
        <unix-def:file_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21429204" version="2" comment="Index.html must exist for any DocumentRoot defined in any loaded config file" check_existence="any_exist" check="all">
          <unix-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429204"/>
        </unix-def:file_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429201" version="2" comment="Gather all DocumentRoot data from httpd and all Include conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429209"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429202" version="2" comment="Gather all DocumentRoot data from all loaded config files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429208"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <unix-def:file_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429203" version="2" comment="Index.html for httpd.conf and all Include conf files ">
          <unix-def:path var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429260"/>
          <unix-def:filename operation="case insensitive equals">index.html</unix-def:filename>
        </unix-def:file_object>
        <unix-def:file_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429204" version="2" comment="Index.html for all loaded conf files">
          <unix-def:path var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429261"/>
          <unix-def:filename operation="case insensitive equals">index.html</unix-def:filename>
        </unix-def:file_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429210" version="2" comment="Gather unique apache http installation paths">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq</independent-def:command>
          <independent-def:pattern>^\/\S+(\/httpd|\/apache2)\s*</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429220" version="2" comment="Gather HTTPD_ROOT files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429202"/>
          <independent-def:pattern>HTTPD_ROOT</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429230" version="2" comment="Gather SERVER_CONFIG_FILE files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429203"/>
          <independent-def:pattern>SERVER_CONFIG_FILE</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429240" version="2" comment="Gather Include statements from httpd.conf">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429220"/>
          <independent-def:pattern>\S+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429250" version="2" comment="Gather all loaded config files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429250"/>
          <independent-def:pattern> \(</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429201" datatype="string" version="2" comment="Apache base install directories (unix)">
          <regex_capture pattern="(^\/.+\/)httpd|(^\/.+/)apache2">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429210" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429202" datatype="string" version="2" comment="httpd_root to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429201"/>
            <literal_component datatype="string">apachectl -V | grep -i 'httpd_root'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429203" datatype="string" version="2" comment="server_config_file to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429201"/>
            <literal_component datatype="string">apachectl -V | grep -i 'server_config_file'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429204" datatype="string" version="2" comment="Filepath to HTTPD_ROOT">
          <regex_capture pattern=" -D HTTPD_ROOT=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429220" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429205" datatype="string" version="2" comment="relative to SERVER_CONFIG_FILE">
          <regex_capture pattern=" -D SERVER_CONFIG_FILE=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429230" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429206" datatype="string" version="2" comment="Filepath to http conf file">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429204"/>
            <literal_component datatype="string">/</literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429205"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429208" datatype="string" version="2" comment="shell command to check DocumentRoot in all loaded conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*DocumentRoot' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429252"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429209" datatype="string" version="2" comment="shell command to check DocumentRoot in httpd.conf and all Include conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*DocumentRoot' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429243"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429210" datatype="string" version="2" comment="Apache path to httpd or apache2">
          <regex_capture pattern="(^\/.+\/httpd|^\/.+\/apache2) ">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429210" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429220" datatype="string" version="2" comment="shell command to check for all Include and Include Optional files">
          <concat>
            <literal_component datatype="string">grep -iEHn '^\s*Include\s+|^\s*IncludeOptional\s+' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429206"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429241" datatype="string" version="2" comment="All included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429204"/>
            <literal_component datatype="string">/</literal_component>
            <regex_capture pattern="\S+\s+(\S+)\s*">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429240" item_field="stdout_line"/>
            </regex_capture>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429242" datatype="string" version="2" comment="merged included conf files from Include refernces in httd.conf">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429241"/>
          </merge>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429243" datatype="string" version="2" comment="httpd.conf and merged included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429206"/>
            <literal_component> </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429242"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429250" datatype="string" version="2" comment="command to gather httpd/apache2 list of all loaded configuration files">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429210"/>
            <literal_component datatype="string"> -t -D DUMP_INCLUDES</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429251" datatype="string" version="2" comment="All loaded configuration filepaths">
          <unique>
            <regex_capture pattern="\(.*\) (/.*)">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429250" item_field="stdout_line"/>
            </regex_capture>
          </unique>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429252" datatype="string" version="2" comment="Merged list of all loaded config files">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429251"/>
          </merge>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429260" datatype="string" version="2" comment="Document root for httpd and included conf files">
          <regex_capture pattern="DocumentRoot &quot;(.*)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429201" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21429261" datatype="string" version="2" comment="Document root for all loaded conf files">
          <regex_capture pattern="DocumentRoot &quot;(.*)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21429202" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        </variables></oval_definitions>
