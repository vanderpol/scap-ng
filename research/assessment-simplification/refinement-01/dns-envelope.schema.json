{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXPERIMENTAL DNS query envelope; not SCAP-NG normative schema",
  "description": "Key membership, key uniqueness across rows and scope completeness require the decoder. No policy Boolean from the collector.",
  "type": "object",
  "properties": {
    "format": {
      "const": "research.dns-rr.v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "inventory": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "error",
            "not_collected"
          ]
        },
        "keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "keys"
      ],
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "integrated": {
            "type": "boolean"
          },
          "signed": {
            "type": "boolean"
          },
          "rr": {
            "type": "object",
            "properties": {
              "RRSIG": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "complete",
                          "incomplete"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "status",
                      "count"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "error",
                          "not_collected"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "DNSKEY": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "complete",
                          "incomplete"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "status",
                      "count"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "error",
                          "not_collected"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "NSEC3": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "complete",
                          "incomplete"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "status",
                      "count"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "error",
                          "not_collected"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "RRSIG",
              "DNSKEY",
              "NSEC3"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "integrated",
          "signed",
          "rr"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "snapshot_id",
    "inventory",
    "zones"
  ],
  "additionalProperties": false
}
