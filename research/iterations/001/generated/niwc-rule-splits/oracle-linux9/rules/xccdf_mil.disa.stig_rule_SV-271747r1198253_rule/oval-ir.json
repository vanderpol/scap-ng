      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "OL09-00-002408 - OL 9 must restrict exposed kernel pointer addresses access."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
                "text": "Oracle Linux 9"
              }
            ],
            "name": "affected",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Exposing kernel pointers (through procfs or \"seq_printf()\") exposes kernel writeable structures, which may contain functions pointers. If a write vulnerability occurs in the kernel, allowing write access to any of this structure, the kernel can be compromised. This option disallows any program without the CAP_SYSLOG capability to get the addresses of kernel pointers by replacing them with \"0\".\n\n\tSatisfies: SRG-OS-000132-GPOS-00067, SRG-OS-000433-GPOS-00192"
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
      "version": "2"
    },
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "kernel.kptr_restrict is set to 1",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:mil.disa.stig.unix:tst:25780000"
          }
        ],
        "comment": null,
        "kind": "boolean",
        "negate": false,
        "operator": "AND"
      },
