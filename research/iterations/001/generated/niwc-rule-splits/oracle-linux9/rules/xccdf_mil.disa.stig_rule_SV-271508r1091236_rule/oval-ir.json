      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "OL09-00-000350 - OL 9 must have the rsyslog package installed."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
                "text": "Oracle Linux 9"
              }
            ],
            "name": "affected",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "rsyslogd is a system utility providing support for message logging. Support for both internet and Unix domain sockets enables this utility to support both local and remote logging. Couple this utility with \"gnutls\" (which is a secure communications library implementing the SSL, TLS, and DTLS protocols), to create a method to securely encrypt and offload auditing.\n\n\tSatisfies: SRG-OS-000479-GPOS-00224, SRG-OS-000051-GPOS-00024"
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
      "version": "1"
    },
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "The rsyslog package is installed.",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:mil.disa.stig.linux:tst:23047700"
          }
        ],
        "comment": null,
        "kind": "boolean",
        "negate": false,
        "operator": "AND"
      },
      "deprecated": null,
      "id": "oval:mil.disa.stig.defs:def:230477",
      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The operating system must have the packages required for offloading audit logs installed."
          },
          {
