  "definitions": [
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "All system-wide library directories must be owned by root",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:navy.navwar.niwcatlantic.scc.linux:tst:27178701"
          }
        ],
        "comment": null,
        "kind": "boolean",
        "negate": false,
