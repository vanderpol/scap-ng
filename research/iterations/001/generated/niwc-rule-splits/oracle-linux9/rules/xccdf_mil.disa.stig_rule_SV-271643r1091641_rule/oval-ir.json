          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The operating system must prevent files with the setuid and setgid bit set from being executed on file systems that are imported via Network File System (NFS)."
          },
          {
