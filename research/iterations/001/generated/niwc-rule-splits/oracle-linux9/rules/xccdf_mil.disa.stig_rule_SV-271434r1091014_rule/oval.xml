      <definitions><definition id="oval:mil.disa.stig.ol9os:def:271434" version="1" class="compliance">
          <metadata>
            <title>OL09-00-000004 - OL 9 must use a separate file system for /tmp.</title>
            <affected family="unix">
              <platform>Oracle Linux 9</platform>
            </affected>
            <description>The "/tmp" partition is used as temporary storage by many programs. Placing "/tmp" in its own partition enables the setting of more restrictive mount options, which can help protect programs that use it.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:230295"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:230295" version="2" class="compliance">
          <metadata>
            <title>A separate the operating system filesystem must be used for the /tmp directory.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.linux:tst:23029500" comment="There is a separate file system for /tmp."/>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:23029500" comment="There is a separate file system configured for /tmp."/>
          </criteria>
        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:23029500" version="1" check_existence="all_exist" check="all" comment="There is a separate file system configured for /tmp.">
          <object object_ref="oval:mil.disa.stig.ind:obj:23029500"/>
        </textfilecontent54_test>
        <partition_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux" id="oval:mil.disa.stig.linux:tst:23029500" version="1" check_existence="all_exist" check="all" comment="There is a separate file system for /tmp.">
          <object object_ref="oval:mil.disa.stig.linux:obj:23029500"/>
        </partition_test>
        </tests><objects><textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:23029500" version="1">
          <filepath>/etc/fstab</filepath>
          <pattern datatype="string" operation="pattern match">^[^# \t]+\s+/tmp\s+</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        <partition_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux" id="oval:mil.disa.stig.linux:obj:23029500" version="1">
