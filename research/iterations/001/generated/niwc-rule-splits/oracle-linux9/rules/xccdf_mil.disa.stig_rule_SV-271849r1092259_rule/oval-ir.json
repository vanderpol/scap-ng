      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The operating system account identifiers (individuals, groups, roles, and devices) must be disabled after 35 days of inactivity."
          },
          {
