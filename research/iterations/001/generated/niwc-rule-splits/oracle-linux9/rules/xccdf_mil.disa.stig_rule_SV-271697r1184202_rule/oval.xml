      <definitions><definition id="oval:mil.disa.stig.ol9os:def:271697" version="1" class="compliance">
          <metadata>
            <title>OL09-00-002320 - OL 9 must disable the chrony daemon from acting as a server.</title>
            <affected family="unix">
              <platform>Oracle Linux 9</platform>
            </affected>
            <description>Minimizing the exposure of the server functionality of the chrony daemon diminishes the attack surface.

	Satisfies: SRG-OS-000096-GPOS-00050, SRG-OS-000095-GPOS-00049</description>
          </metadata>
          <criteria>
