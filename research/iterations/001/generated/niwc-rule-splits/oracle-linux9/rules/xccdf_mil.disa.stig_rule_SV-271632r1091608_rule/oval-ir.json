      },
      "deprecated": null,
      "id": "oval:mil.disa.stig.defs:def:230367",
      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The operating system user account passwords must be configured so that existing passwords are restricted to a 60-day maximum lifetime."
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          }
        ],
