  "definitions": [
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "No password in /etc/shadow has a maximum password age of 0 or greater than 60",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:mil.disa.stig.unix:tst:23036700"
          },
          {
