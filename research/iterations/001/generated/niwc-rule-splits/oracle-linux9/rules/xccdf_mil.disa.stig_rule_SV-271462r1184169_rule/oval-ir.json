      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "OL09-00-000130 - OL 9 must not have a File Transfer Protocol (FTP) server package installed."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
                "text": "Oracle Linux 9"
              }
            ],
            "name": "affected",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The FTP service provides an unencrypted remote access that does not provide for the confidentiality and integrity of user passwords or the remote session. If a privileged user were to log on using this service, the privileged user password could be compromised. SSH or other encrypted file transfer methods must be used in place of this service.\n\n\tRemoving the \"vsftpd\" package decreases the risk of accidental activation.\n\n\tSatisfies: SRG-OS-000074-GPOS-00042, SRG-OS-000095-GPOS-00049"
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
      "version": "1"
    },
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": null,
            "kind": "test_ref",
            "negate": false,
