            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:27172000" comment="Check to see if PermitUserEnvironment is set to no in /etc/ssh/sshd_config and /etc/ssh/sshd_config.d/*.conf"/>
