      <definitions><definition id="oval:mil.disa.stig.defs:def:258145" version="1" class="compliance">
          <metadata>
            <title>The operating system must be configured to offload audit records onto a different system from the system being audited via syslog.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:25814500"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.ol9os:def:271597" version="1" class="compliance">
          <metadata>
            <title>OL09-00-000855 - OL 9 must be configured to offload audit records onto a different system from the system being audited via syslog.</title>
            <affected family="unix">
              <platform>Oracle Linux 9</platform>
            </affected>
            <description>The auditd service does not include the ability to send audit records to a centralized server for management directly. However, it can use a plug-in for audit event multiplexor (audispd) to pass audit records to the local syslog server.

	Satisfies: SRG-OS-000342-GPOS-00133, SRG-OS-000479-GPOS-00224</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:258145"/>
          </criteria>
        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:25814500" version="1" check="all" comment="/etc/audit/plugins.d/syslog.conf: active = yes">
          <object object_ref="oval:mil.disa.stig.ind:obj:25814500"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:20000023"/>
        </textfilecontent54_test>
        </tests><objects><textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:25814500" version="1">
          <filepath>/etc/audit/plugins.d/syslog.conf</filepath>
          <pattern operation="pattern match">^\s*active\s*=\s*(\w+)\s*$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        </objects><states><textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:20000023" version="1">
