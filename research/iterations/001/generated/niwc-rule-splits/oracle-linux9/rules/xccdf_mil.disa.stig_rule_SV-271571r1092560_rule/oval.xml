          <pattern operation="pattern match">^\s*-w\s+/var/log/faillock(\s+-p\s*([rx]*w[rx]*a[rx]*|[rx]*a[rx]*w[rx]*))?(\s+(-k\s+|-F\s+key=)[\w-]+)?\s*$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
