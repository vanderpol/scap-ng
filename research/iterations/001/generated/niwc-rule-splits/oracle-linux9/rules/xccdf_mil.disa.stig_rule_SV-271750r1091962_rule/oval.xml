          <metadata>
            <title>The operating system must automatically exit interactive command shell user sessions after 15 minutes of inactivity.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:27175000" comment="TMOUT is set to 900 or less in /etc/profile and /etc/profile.d/*.sh"/>
