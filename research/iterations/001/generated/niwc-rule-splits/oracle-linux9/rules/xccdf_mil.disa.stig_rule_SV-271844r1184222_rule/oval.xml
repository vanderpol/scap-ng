      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.rhel8:def:271844" version="5" class="compliance">
          <metadata>
            <title>OL 9 local interactive user home directories defined in the /etc/passwd file must exist.</title>
            <affected family="unix">
              <platform>Red Hat Enterprise Linux 8 and SLES 15</platform>
            </affected>
            <description>All Linux local interactive user home directories defined in the /etc/passwd file must exist.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.rhel8:tst:27184401" comment="Retrieve list of interactive user home directories."/>
          </criteria>
        </definition>
      </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.rhel8:tst:27184401" version="5" comment="Confirm interactive user's home directories exist." check_existence="any_exist" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.rhel8:obj:27184401"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.rhel8:ste:27184401"/>
        </independent-def:shellcommand_test>
      </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.rhel8:obj:27184401" version="5" comment="Retrieve array of users from passwd file with UID &gt;=1000 and 'nologin'.">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>ls -d $(awk -F: '($3&gt;=1000)&amp;&amp;($7 !~ /nologin/){print $6}' /etc/passwd)</independent-def:command>
          <independent-def:pattern operation="pattern match"/>
        </independent-def:shellcommand_object>
      </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.rhel8:ste:27184401" version="5" comment="Check that no directories produce 'cannot access' errors.">
          <independent-def:stderr_line check_existence="none_exist" operation="pattern match">.*</independent-def:stderr_line>
        </independent-def:shellcommand_state>
      </states></oval_definitions>
