      <definitions><definition id="oval:mil.disa.stig.ol9os:def:271691" version="1" class="compliance">
          <metadata>
            <title>OL09-00-002161 - OL 9 must not allow unattended or automatic logon via the graphical user interface.</title>
            <affected family="unix">
              <platform>Oracle Linux 9</platform>
            </affected>
            <description>Failure to restrict system access to authenticated users negatively impacts operating system security.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:230329"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:230329" version="1" class="compliance">
          <metadata>
            <title>Unattended or automatic logon via the operating system graphical user interface must not be allowed.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:23032900" comment="AutomaticLoginEnable is set to false"/>
          </criteria>
        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:23032900" version="2" check="all" comment="AutomaticLoginEnable is set to false in /etc/gdm/custom.conf.">
          <object object_ref="oval:mil.disa.stig.ind:obj:23032900"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:20000000"/>
        </textfilecontent54_test>
        </tests><objects><textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:23032900" version="2">
          <filepath>/etc/gdm/custom.conf</filepath>
          <pattern operation="pattern match">^\s*\[daemon\]\s+[#\s\w=]*^\s*AutomaticLoginEnable=(\w+)\s*$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        </objects><states><textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:20000000" version="1">
          <subexpression>false</subexpression>
        </textfilecontent54_state>
