            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "OL09-00-002582 - OL 9 cron configuration files directory must be owned by root."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
