      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.linux:def:271779" version="5" class="compliance">
          <metadata>
            <title>OL 9 must be configured so that a sticky bit must be set on all public directories.</title>
            <description>A sticky bit must be set on all public directories to prevent unauthorized and unintended information transferred via shared system resources.</description>
          </metadata>
          <criteria>
