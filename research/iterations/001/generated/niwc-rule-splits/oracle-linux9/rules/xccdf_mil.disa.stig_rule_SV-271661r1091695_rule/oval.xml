        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:23051901" version="1" check="all" comment="/var/log/audit is configured with the noexec option in /etc/fstab">
