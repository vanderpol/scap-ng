      },
      "deprecated": null,
      "id": "oval:mil.disa.stig.defs:def:244519",
      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The operating system must display a banner before granting local or remote access to the system via a graphical user logon."
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          }
        ],
        "name": "metadata",
