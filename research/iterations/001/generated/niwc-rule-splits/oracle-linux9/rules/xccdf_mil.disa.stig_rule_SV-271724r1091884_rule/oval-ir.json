          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Without reauthentication, users may access resources or perform tasks for which they do not have authorization.\n\n\tWhen operating systems provide the capability to escalate a functional capability, it is critical that the user reauthenticate."
          }
        ],
