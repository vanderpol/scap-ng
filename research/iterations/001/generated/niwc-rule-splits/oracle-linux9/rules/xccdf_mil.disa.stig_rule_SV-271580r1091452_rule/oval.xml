      <definitions><definition id="oval:mil.disa.stig.ol9os:def:271580" version="1" class="compliance">
          <metadata>
            <title>OL09-00-000765 - OL 9 audit system must take appropriate action when the audit storage volume is full.</title>
            <affected family="unix">
              <platform>Oracle Linux 9</platform>
            </affected>
            <description>It is critical that when the operating system is at risk of failing to process audit logs as required, it takes action to mitigate the failure. Audit processing failures include software/hardware errors; failures in the audit capturing mechanisms; and audit storage capacity being reached or exceeded. Responses to audit failure depend upon the nature of the failure mode.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:230392"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:230392" version="1" class="compliance">
          <metadata>
            <title>The operating system audit system must take appropriate action when the audit storage volume is full.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:23039200"/>
          </criteria>
        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:23039200" version="1" check="all" state_operator="OR" comment="/etc/audit/auditd.conf: disk_full_action = SYSLOG, SINGLE, or HALT">
          <object object_ref="oval:mil.disa.stig.ind:obj:23039200"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:23039200"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:23039201"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:23039202"/>
        </textfilecontent54_test>
        </tests><objects><textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:23039200" version="1">
          <filepath>/etc/audit/auditd.conf</filepath>
          <pattern operation="pattern match">(?i)^\s*disk_full_action\s*=\s*(\w+)\s*(?:#.*)?$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        </objects><states><textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:23039200" version="1">
          <subexpression operation="pattern match">(?i)^syslog$</subexpression>
        </textfilecontent54_state>
        <textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:23039201" version="1">
          <subexpression operation="pattern match">(?i)^single$</subexpression>
        </textfilecontent54_state>
        <textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:23039202" version="1">
          <subexpression operation="pattern match">(?i)^halt$</subexpression>
        </textfilecontent54_state>
        </states></oval_definitions>
