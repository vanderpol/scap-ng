          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Inappropriately granting user rights provides system, administrative, and other high-level capabilities.\n\n  The \"Deny log on as a service\" user right defines accounts that are denied logon as a service.\n\n  Incorrect configurations could prevent services from starting and result in a denial of service."
          }
        ],
