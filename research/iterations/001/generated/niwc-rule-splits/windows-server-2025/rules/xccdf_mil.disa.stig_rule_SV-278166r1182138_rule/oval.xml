      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278166" version="1" class="compliance">
          <metadata>
            <title>WN25-DC-000350 - The Windows Server 2025 "Add workstations to domain" user right must only be assigned to the Administrators group on domain controllers.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Inappropriately granting user rights provides system, administrative, and other high-level capabilities.

  Accounts with the "Add workstations to domain" right may add computers to a domain. This could result in unapproved or incorrectly configured systems being added to a domain.</description>
          </metadata>
