      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278016" version="1" class="compliance">
          <metadata>
            <title>WN25-00-000330 - Windows Server 2025 must not have the Microsoft FTP service installed unless required by the organization.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Unnecessary services increase the attack surface of a system. Some of these services may not support required levels of authentication or encryption.</description>
