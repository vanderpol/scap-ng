      <definitions><definition id="oval:mil.disa.stig.windows2025:def:285315" version="2" class="compliance">
          <metadata>
            <title>WN25-SH-000030 - Windows Server 2025 OpenSSH must accept public key authentication.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Without the use of multifactor authentication, the ease of access to privileged functions is greatly increased. Multifactor authentication requires using two or more factors to achieve authentication. A privileged account is defined as an information system account with authorizations of a privileged user. A DoW common access card (CAC) with DoW-approved PKI is an example of multifactor authentication.

Satisfies: SRG-OS-000105-GPOS-00052, SRG-OS-000106-GPOS-00053, SRG-OS-000107-GPOS-00054, SRG-OS-000108-GPOS-00056</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:285315"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:285315" version="2" class="compliance">
          <metadata>
            <title>The operating system OpenSSH must accept public key authentication.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.ind:tst:28531500" comment="C:\ProgramData\ssh\sshd_config:PubkeyAuthentication==yes"/>
          </criteria>
        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:28531500" version="1" check="all" comment="C:\ProgramData\ssh\sshd_config:PubkeyAuthentication==yes">
          <object object_ref="oval:mil.disa.stig.ind:obj:28531500"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:20000016"/>
        </textfilecontent54_test>
        </tests><objects><textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:28531500" version="1">
          <behaviors ignore_case="true"/>
          <filepath>C:\ProgramData\ssh\sshd_config</filepath>
          <pattern operation="pattern match">^\s*(?i)PubkeyAuthentication(?-i)[ \t]+([\w\"]+)[\s]*(?:|(?:#.*))?$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        </objects><states><textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:20000016" version="1">
