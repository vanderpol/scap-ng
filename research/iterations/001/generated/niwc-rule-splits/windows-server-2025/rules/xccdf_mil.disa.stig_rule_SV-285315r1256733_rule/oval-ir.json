            "text": "WN25-SH-000030 - Windows Server 2025 OpenSSH must accept public key authentication."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
