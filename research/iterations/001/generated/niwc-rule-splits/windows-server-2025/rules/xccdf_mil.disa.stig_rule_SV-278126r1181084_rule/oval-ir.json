          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Unencrypted remote access to a system can allow sensitive information to be compromised. Windows remote management connections must be encrypted to prevent this.\n\n  Satisfies: SRG-OS-000393-GPOS-00173, SRG-OS-000394-GPOS-00174"
          }
        ],
