      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278139" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 Active Directory SYSVOL directory must have the proper access control permissions.</title>
            <description>Windows Server Active Directory SYSVOL directory must have the proper access control permissions.</description>
          </metadata>
          <criteria>
            <criterion comment="Permissions must conform to minimum requirements for SYSVOL directory." test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27813901"/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27813901" version="1" comment="Permissions must conform to minimum requirements." check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27813901"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27813901"/>
        </independent-def:shellcommand_test>
        </tests><objects><win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27813902" version="1" comment="Filepath to SysVol">
          <win-def:hive>HKEY_LOCAL_MACHINE</win-def:hive>
          <win-def:key>SYSTEM\CurrentControlSet\Services\Netlogon\Parameters</win-def:key>
          <win-def:name>SysVol</win-def:name>
        </win-def:registry_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27813901" version="1" comment="Run Icacls command against SYSVOL Directory">
          <independent-def:shell>cmd</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:27813902"/>
          <independent-def:pattern>:</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27813901" version="1" comment="Permissions must equal expected output">
          <independent-def:exit_status datatype="int">0</independent-def:exit_status>
          <independent-def:stdout_line var_check="at least one" operation="pattern match" var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:27813901"/>
          <independent-def:stderr_line check_existence="none_exist"/>
        </independent-def:shellcommand_state>
        </states><variables><constant_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:27813901" version="1" datatype="string" comment="Required Permissions">
          <value>(?i)NT AUTHORITY\\Authenticated Users:\(RX\)</value>
          <value>(?i)NT AUTHORITY\\Authenticated Users:\(OI\)\(CI\)\(IO\)\(GR,GE\)</value>
          <value>(?i)BUILTIN\\Server Operators:\(RX\)</value>
          <value>(?i)BUILTIN\\Server Operators:\(OI\)\(CI\)\(IO\)\(GR,GE\)</value>
          <value>(?i)BUILTIN\\Administrators:\(M,WDAC,WO\)</value>
          <value>(?i)BUILTIN\\Administrators:\(OI\)\(CI\)\(IO\)\(F\)</value>
          <value>(?i)NT AUTHORITY\\SYSTEM:\(F\)</value>
          <value>(?i)NT AUTHORITY\\SYSTEM:\(OI\)\(CI\)\(IO\)\(F\)</value>
          <value>(?i)CREATOR OWNER:\(OI\)\(CI\)\(IO\)\(F\)</value>
        </constant_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:27813902" datatype="string" version="1" comment="icacls and Path to SYSVOL directory">
          <concat>
            <literal_component datatype="string">icacls </literal_component>
            <regex_capture pattern="(^[a-zA-Z]:\\.+)\\sysvol">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27813902" item_field="value"/>
            </regex_capture>
          </concat>
        </local_variable>
        </variables></oval_definitions>
