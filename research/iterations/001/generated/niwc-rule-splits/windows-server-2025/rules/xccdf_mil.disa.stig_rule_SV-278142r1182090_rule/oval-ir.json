          "value": "import-module GroupPolicy; $dn = ([ADSI]\"\").distinguishedName; $c = 0; $f = New-Object System.Collections.Generic.List[Object]; $AdminGroupRegex = 'SYSTEM|Domain Admins|Enterprise Admins|Builtin\\\\Administrators|Administrators|CREATOR OWNER|SELF|Key Admins|Enterprise Key Admins|Exchange Enterprise Servers|Exchange Servers|Exchange Windows Permissions|Exchange Trusted Subsystem'; $ReadOnlyGroupRegex = 'Authenticated Users|Pre-Windows 2000|Enterprise Domain Controllers|Everyone|Anonymous Logon'; $ModRightsRegex = 'Write|CreateChild|DeleteChild|GenericAll|GenericWrite|Delete'; :ouLoop foreach ($ou in (Get-ADOrganizationalUnit -Filter \"Name -ne 'Domain Controllers'\")) { $aces = Get-Acl -Path \"AD:$($ou.DistinguishedName)\" | Select-Object -ExpandProperty Access | Select-Object IdentityReference, ActiveDirectoryRights, AccessControlType -Unique; foreach ($ace in $aces) { if ($ace.AccessControlType -eq 'Deny') { continue }; if ($ace.IdentityReference -match $AdminGroupRegex) { continue }; if ($ace.ActiveDirectoryRights.ToString() -match $ModRightsRegex) { if ($c -ge 1000) { $f.Add([PSCustomObject]@{ GPO = 'WARNING'; Status = 'FAIL'; Reason = 'Maximum reporting threshold of 1000 failures reached. Further output truncated.' }); break ouLoop }; $f.Add([PSCustomObject]@{ GPO = $ou.Name; Status = 'FAIL'; Reason = \"Unauthorized Trustee '$($ace.IdentityReference)' holds '$($ace.ActiveDirectoryRights)' modification rights.\" }); $c++ } } }; if ($f.Count -gt 0) { $f | Format-Table -AutoSize | Out-String -Width 4096 } else { [PSCustomObject]@{ GPO = 'Custom OUs'; Status = 'PASS'; Reason = 'Delegation securely restricted to authorized administrative groups on all custom OUs.' } | Format-Table -AutoSize | Out-String -Width 4096 }"
