      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "WN25-DC-000406 - Windows Server 2025 must be configured for name-based strong mappings for certificates."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
                "text": "Microsoft Windows Server 2025"
              }
            ],
            "name": "affected",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Weak mappings give rise to security vulnerabilities and demand hardening measures. Certificate names must be correctly mapped to the intended user account in Active Directory. A lack of strong name-based mappings allows certain weak certificate mappings, such as Issuer/Subject AltSecID and User Principal Names (UPN) mappings, to be treated as strong mappings."
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
      "version": "1"
    },
    {
      "class": "compliance",
      "criteria": {
