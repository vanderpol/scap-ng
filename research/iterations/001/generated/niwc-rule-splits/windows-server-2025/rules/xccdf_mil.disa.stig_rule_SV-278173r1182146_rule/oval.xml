          <key datatype="string" operation="case insensitive equals">Software\Microsoft\Windows\CurrentVersion\Policies\System\KDC\Parameters</key>
          <name datatype="string" operation="case insensitive equals">UseStrongNameMatches</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000001" version="1">
