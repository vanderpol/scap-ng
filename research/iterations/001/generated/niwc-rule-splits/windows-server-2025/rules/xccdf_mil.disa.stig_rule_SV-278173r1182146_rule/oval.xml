      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278173" version="1" class="compliance">
          <metadata>
            <title>WN25-DC-000406 - Windows Server 2025 must be configured for name-based strong mappings for certificates.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Weak mappings give rise to security vulnerabilities and demand hardening measures. Certificate names must be correctly mapped to the intended user account in Active Directory. A lack of strong name-based mappings allows certain weak certificate mappings, such as Issuer/Subject AltSecID and User Principal Names (UPN) mappings, to be treated as strong mappings.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:271427"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:271427" version="1" class="compliance">
          <metadata>
            <title>The operating system must be configured for name-based strong mappings for certificates.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:27142700" comment="UseStrongNameMatches == 1"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:27142700" version="1" check_existence="at_least_one_exists" check="all" comment="UseStrongNameMatches == 1">
          <object object_ref="oval:mil.disa.stig.win:obj:27142700"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000001"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:27142700" version="1">
