      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278090" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 virtualization-based security must be enabled with the platform security level configured to Secure Boot or Secure Boot with DMA Protection.</title>
            <description>Virtualization-based security (VBS) provides the platform for the additional security features Credential Guard and virtualization-based protection of code integrity. Secure Boot is the minimum security level, with DMA protection providing additional memory protection. DMA Protection requires a CPU that supports input/output memory management unit (IOMMU).</description>
          </metadata>
          <criteria operator="AND">
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27809001" comment="Windows Server virtualization-based security must be enabled with the platform security level configured to Secure Boot or Secure Boot with DMA Protection. RequiredSecurityProperties"/>
