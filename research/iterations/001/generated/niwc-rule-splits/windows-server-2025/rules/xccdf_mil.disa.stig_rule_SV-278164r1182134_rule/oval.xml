      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278164" version="1" class="compliance">
          <metadata>
            <title>WN25-DC-000330 - Windows Server 2025 domain controllers must be configured to allow reset of machine account passwords.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Enabling this setting on all domain controllers in a domain prevents domain members from changing their computer account passwords. If these passwords are weak or compromised, the inability to change them may leave these computers vulnerable.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:254417"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:254417" version="1" class="compliance">
          <metadata>
            <title>Windows domain controllers must be configured to allow reset of machine account passwords.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25441700"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25441700" version="1" check="all" comment="'Domain controller: Refuse machine account password changes' is set to 'Disabled'.">
          <object object_ref="oval:mil.disa.stig.win:obj:25441700"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000000"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25441700" version="1">
          <hive operation="case insensitive equals">HKEY_LOCAL_MACHINE</hive>
          <key operation="case insensitive equals">SYSTEM\CurrentControlSet\Services\Netlogon\Parameters</key>
          <name operation="case insensitive equals">RefusePasswordChange</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000000" version="1">
          <type>reg_dword</type>
          <value datatype="int">0</value>
        </registry_state>
        </states></oval_definitions>
