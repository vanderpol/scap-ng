      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278147" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 directory service must be configured to terminate LDAP-based network connections to the directory server after five minutes of inactivity.</title>
            <description>Windows Server directory service must be configured to terminate LDAP-based network connections to the directory server after five minutes of inactivity.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27814701" comment="Review MaxConnIdleTime setting via command line dsquery"/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27814701" version="1" comment="Review MaxConnIdleTime setting via command line dsquery" check_existence="at_least_one_exists" check="at least one">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27814701"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27814701"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27814702" version="1" comment="Gather fully qualified LDAP name of the domain being reviewed via powershell">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>([ADSI]"LDAP://RootDSE").rootDomainNamingContext</independent-def:command>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27814701" version="1" comment="Review MaxConnIdleTime setting via command line dsquery">
          <independent-def:shell>cmd</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:27814701"/>
          <independent-def:pattern>MaxConnIdleTime=(\d+)</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27814701" version="1" comment="MaxConnIdleTime less than or equal to 300" operator="AND">
          <independent-def:shell>cmd</independent-def:shell>
          <independent-def:subexpression datatype="int" operation="less than or equal">300</independent-def:subexpression>
        </independent-def:shellcommand_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:27814701" version="1" datatype="string" comment="The dsquery command used to gather MaxConnIdleTime">
          <concat>
            <literal_component>dsquery * "cn=Default Query Policy,cn=Query-Policies,cn=Directory Service, cn=Windows NT,cn=Services,cn=Configuration,</literal_component>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27814702" item_field="stdout_line"/>
            <literal_component>" -attr LDAPAdminLimits</literal_component>
          </concat>
        </local_variable>
      </variables></oval_definitions>
