            "text": "WN25-DC-000030 - Windows Server 2025 Kerberos service ticket maximum lifetime must be limited to 600 minutes or less."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
