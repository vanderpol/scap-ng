        <definition id="oval:mil.disa.stig.windows2025:def:285323" version="1" class="compliance">
          <metadata>
            <title>WN25-SH-000110 - Windows Server 2025 OpenSSH must not allow GSSAPI authentication.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Generic Security Service Application Program Interface (GSSAPI) authentication is used to provide additional authentication mechanisms to applications. Allowing GSSAPI authentication through SSH exposes the system's GSSAPI to remote hosts, increasing the attack surface of the system.

Satisfies: SRG-OS-000364-GPOS-00151, SRG-OS-000480-GPOS-00228</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:285323"/>
          </criteria>
        </definition>
