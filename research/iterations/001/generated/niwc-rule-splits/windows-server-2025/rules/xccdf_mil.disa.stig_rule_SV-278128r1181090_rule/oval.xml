      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278128" version="1" class="compliance">
          <metadata>
            <title>WN25-CC-000500 - Windows Server 2025 Windows Remote Management (WinRM) service must not use Basic authentication.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Basic authentication uses plain-text passwords that could be used to compromise a system. Disabling Basic authentication will reduce this potential.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253418"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:253418" version="2" class="compliance">
          <metadata>
            <title>The Windows Remote Management (WinRM) service must not use Basic authentication.</title>
            <description/>
          </metadata>
          <criteria operator="AND">
            <criterion test_ref="oval:mil.disa.stig.win:tst:25341800" comment="Verifies 'Allow Basic authentication' is set to 'Disabled'"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25341800" version="1" check_existence="at_least_one_exists" check="all" comment="'Allow Basic authentication' is set to 'Disabled'">
          <object object_ref="oval:mil.disa.stig.win:obj:25341800"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000000"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25341800" version="1">
          <hive datatype="string" operation="equals">HKEY_LOCAL_MACHINE</hive>
          <key datatype="string" operation="equals">SOFTWARE\Policies\Microsoft\Windows\WinRM\Service</key>
          <name datatype="string" operation="equals">AllowBasic</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000000" version="1">
          <type>reg_dword</type>
          <value datatype="int">0</value>
        </registry_state>
        </states></oval_definitions>
