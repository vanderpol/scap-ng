      "criteria": {
        "children": [
          {
            "comment": "FTP servers must be configured to prevent access to the system drive. If the site includes root of the drive this is a finding.",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:navy.navwar.niwcatlantic.scc.windows:tst:27802801"
          },
          {
            "comment": "FTP servers must be configured to prevent access to the system drive. If the site includes Program Files this is a finding.",
            "kind": "test_ref",
