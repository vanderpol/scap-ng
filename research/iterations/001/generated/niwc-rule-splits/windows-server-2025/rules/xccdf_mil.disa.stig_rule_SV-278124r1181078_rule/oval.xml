      <definitions><definition id="oval:mil.disa.stig.defs:def:253414" version="1" class="compliance">
          <metadata>
            <title>PowerShell script block logging must be enabled on Windows.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25341400"/>
