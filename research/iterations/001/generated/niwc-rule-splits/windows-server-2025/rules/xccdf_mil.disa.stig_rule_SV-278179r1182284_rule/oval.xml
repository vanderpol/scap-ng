      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278179" version="1" class="compliance">
          <metadata>
            <title>WN25-MS-000030 - Windows Server 2025 local users on domain-joined member servers must not be enumerated.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>The username is one part of logon credentials that could be used to gain access to a system. Preventing the enumeration of users limits this information to authorized personnel.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253379"/>
          </criteria>
        </definition>
