      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278027" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 FTP servers must be configured to prevent anonymous logons.</title>
            <description>The FTP service allows remote users to access shared files and directories. Allowing anonymous FTP connections makes user auditing difficult.

Using accounts that have administrator privileges to log on to FTP risks that the userid and password will be captured on the network and give administrator access to an unauthorized user.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27802701" comment="FTP servers must be configured to prevent anonymous logons."/>
          </criteria>
        </definition>
        </definitions><tests><win-def:appcmdlistconfig_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27802701" version="1" comment="FTP servers must be configured to prevent anonymous logons." check_existence="at_least_one_exists" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27802701"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27802701"/>
        </win-def:appcmdlistconfig_test>
        </tests><objects><win-def:appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27802701" version="1" comment="FTP Authentication - Anonymous Authentication">
          <win-def:identifier_type>Site</win-def:identifier_type>
          <win-def:identifier operation="pattern match">.*</win-def:identifier>
          <win-def:section>system.applicationHost/sites</win-def:section>
          <win-def:parameter>siteDefaults.ftpServer.security.authentication.anonymousAuthentication.enabled</win-def:parameter>
        </win-def:appcmdlistconfig_object>
        </objects><states><win-def:appcmdlistconfig_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27802701" version="1" comment="Result Must Equal false">
          <win-def:result operation="equals" entity_check="all">false</win-def:result>
        </win-def:appcmdlistconfig_state>
        </states></oval_definitions>
