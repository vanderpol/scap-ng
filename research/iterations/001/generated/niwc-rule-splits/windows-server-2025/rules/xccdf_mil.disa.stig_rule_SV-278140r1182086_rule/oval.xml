      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278140" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 Active Directory (AD) Group Policy Objects (GPOs) must have proper access control permissions.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27814001" comment="Windows Server Active Directory Group Policy objects must have proper access control permissions."/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27814001" version="1" comment="Windows Server Active Directory Group Policy objects must have proper access control permissions." check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27814001"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27814001"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27814001" version="1" comment="Analyze the permissions on the Group Policy Objects and report details on any non-compliant permission found.">
          <independent-def:behaviors error_if_stderr_exists="true"/>
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Import-Module ActiveDirectory; $a='^SYSTEM$|^Domain Admins$|^Enterprise Admins$|^Administrators$|^Enterprise Domain Controllers$|^CREATOR OWNER$'; $s='^Authenticated Users$|^Domain Computers$'; $results=foreach($gpo in (Get-ADObject -Filter "objectClass -eq 'groupPolicyContainer'" -SearchBase (Get-ADDomain).SystemsContainer -Properties displayName)){$acl = (Get-Acl -Path "AD:\$($gpo.DistinguishedName)").Access; foreach($rule in $acl){$t = $rule.IdentityReference.Value.Split('\')[-1]; if(-not $t -or $t -match $a -or $t -match $s){continue}else{"GPO=$($gpo.displayName) | Status=FAIL | Reason=Unauthorized trustee $t holds explicit ACL entry on this GPO."}}}; if($results){$results}else{"GPO=All GPOs | Status=PASS | Reason=Delegation secure."}</independent-def:command>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27814001" version="1" comment="No lines shall exist listed with status of 'FAIL'">
          <independent-def:stdout_line entity_check="none satisfy" operation="pattern match">Status=FAIL</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        </states></oval_definitions>
