          "value": "Import-Module ActiveDirectory; $a='^SYSTEM$|^Domain Admins$|^Enterprise Admins$|^Administrators$|^Enterprise Domain Controllers$|^CREATOR OWNER$'; $s='^Authenticated Users$|^Domain Computers$'; $results=foreach($gpo in (Get-ADObject -Filter \"objectClass -eq 'groupPolicyContainer'\" -SearchBase (Get-ADDomain).SystemsContainer -Properties displayName)){$acl = (Get-Acl -Path \"AD:\\$($gpo.DistinguishedName)\").Access; foreach($rule in $acl){$t = $rule.IdentityReference.Value.Split('\\')[-1]; if(-not $t -or $t -match $a -or $t -match $s){continue}else{\"GPO=$($gpo.displayName) | Status=FAIL | Reason=Unauthorized trustee $t holds explicit ACL entry on this GPO.\"}}}; if($results){$results}else{\"GPO=All GPOs | Status=PASS | Reason=Delegation secure.\"}"
