      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278249" version="1" class="compliance">
          <metadata>
            <title>WN25-UR-000090 - The Windows Server 2025 "Create symbolic links" user right must only be assigned to the Administrators group.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Inappropriately granting user rights provides system, administrative, and other high-level capabilities.

  Accounts with the "Create symbolic links" user right can create pointers to other objects, which could expose the system to attack.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:254499"/>
          </criteria>
        </definition>
