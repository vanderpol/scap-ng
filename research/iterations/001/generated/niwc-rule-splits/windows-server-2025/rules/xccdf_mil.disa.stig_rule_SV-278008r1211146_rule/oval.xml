      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278008" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 must have software certificate installation files removed.</title>
            <description>Use of software certificates and their accompanying installation files for end users to access resources is less secure than the use of hardware-based certificates.</description>
          </metadata>
          <criteria>
            <criterion comment="Software certificate installation files must be removed. Remove .p12 files." test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800801"/>
            <criterion comment="Software certificate installation files must be removed. Remove .pfx files." test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800802"/>
          </criteria>
        </definition>
        </definitions><tests><win-def:file_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800802" version="1" comment="Software certificate installation files must be removed. Remove .pfx files" check_existence="none_exist" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800802"/>
        </win-def:file_test>
        <win-def:file_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800801" version="1" comment="Software certificate installation files must be removed. Remove .p12 files" check_existence="none_exist" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800801"/>
        </win-def:file_test>
        </tests><objects><win-def:file_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800801" version="1" comment="Search for .p12 files">
          <win-def:behaviors max_depth="-1" recurse_direction="down"/>
          <win-def:path operation="pattern match">.*</win-def:path>
          <win-def:filename operation="pattern match">.[Pp]12$</win-def:filename>
        </win-def:file_object>
        <win-def:file_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800802" version="1" comment="Search for .pfx files">
          <win-def:behaviors max_depth="-1" recurse_direction="down"/>
          <win-def:path operation="pattern match">.*</win-def:path>
          <win-def:filename operation="pattern match">.[Pp][Ff][Xx]$</win-def:filename>
        </win-def:file_object>
        </objects></oval_definitions>
