      <definitions><definition id="oval:mil.disa.stig.defs:def:253287" version="2" class="compliance">
          <metadata>
            <title>The Server Message Block (SMB) v1 protocol must be disabled on the SMB server.</title>
            <description/>
          </metadata>
          <criteria operator="OR">
            <criterion test_ref="oval:mil.disa.stig.win:tst:25328600" comment="Verifies 'SMB 1.0/CIFS File Sharing Support' feature is not installed"/>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25328700" comment="Verifies 'Configure SMBv1 Server' is set to 'Disabled'"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.windows2025:def:278024" version="1" class="compliance">
          <metadata>
            <title>WN25-00-000390 - Windows Server 2025 must have the Server Message Block (SMB) v1 protocol disabled on the SMB server.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>SMBv1 is a legacy protocol that uses the MD5 algorithm as part of SMB. MD5 is known to be vulnerable to a number of attacks such as collision and preimage attacks, as well as not being FIPS compliant.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253287"/>
          </criteria>
        </definition>
        </definitions><tests><wmi57_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25328600" version="1" check_existence="all_exist" check="all" comment="'SMB 1.0/CIFS File Sharing Support' feature is not installed">
          <object object_ref="oval:mil.disa.stig.win:obj:25328600"/>
          <state state_ref="oval:mil.disa.stig.win:ste:25328600"/>
        </wmi57_test>
        <registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25328700" version="1" check_existence="at_least_one_exists" check="all" comment="'Configure SMBv1 Server' is set to 'Disabled'">
          <object object_ref="oval:mil.disa.stig.win:obj:25328700"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000000"/>
        </registry_test>
