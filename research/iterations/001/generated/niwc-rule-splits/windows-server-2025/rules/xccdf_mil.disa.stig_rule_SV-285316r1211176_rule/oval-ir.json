            "text": "WN25-SH-000040 - Windows Server 2025 OpenSSH must not allow blank passwords."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
