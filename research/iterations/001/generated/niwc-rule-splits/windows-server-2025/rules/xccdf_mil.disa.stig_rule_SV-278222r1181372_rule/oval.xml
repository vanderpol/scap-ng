      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278222" version="1" class="compliance">
          <metadata>
            <title>WN25-SO-000280 - Windows Server 2025 must prevent PKU2U authentication using online identities.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>PKU2U is a peer-to-peer authentication protocol. This setting prevents online identities from authenticating to domain-joined systems. Authentication will be centrally managed with Windows user accounts.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253459"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:253459" version="1" class="compliance">
          <metadata>
            <title>PKU2U authentication using online identities must be prevented.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25345900" comment="Verifies 'Network Security: Allow PKU2U authentication requests to this computer to use online identities' is set to 'Disabled'"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25345900" version="1" check_existence="at_least_one_exists" check="all" comment="'Network Security: Allow PKU2U authentication requests to this computer to use online identities' is set to 'Disabled'">
          <object object_ref="oval:mil.disa.stig.win:obj:25345900"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000000"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25345900" version="1" comment="Check the registry value at HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\LSA\pku2u\AllowOnlineID">
          <hive datatype="string">HKEY_LOCAL_MACHINE</hive>
          <key datatype="string">SYSTEM\CurrentControlSet\Control\LSA\pku2u</key>
          <name datatype="string">AllowOnlineID</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000000" version="1">
