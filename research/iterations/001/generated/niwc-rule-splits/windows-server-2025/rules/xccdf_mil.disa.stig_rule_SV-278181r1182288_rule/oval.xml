          <hive datatype="string" operation="case insensitive equals">HKEY_LOCAL_MACHINE</hive>
          <key datatype="string" operation="case insensitive equals">SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon</key>
          <name datatype="string" operation="case insensitive equals">CachedLogonsCount</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:25443200" version="1" comment="Reg_sz value of 4 or less">
