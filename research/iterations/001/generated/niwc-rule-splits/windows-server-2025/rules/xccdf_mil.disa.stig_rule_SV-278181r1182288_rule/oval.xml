      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278181" version="1" class="compliance">
          <metadata>
            <title>WN25-MS-000050 - Windows Server 2025 must limit the caching of logon credentials to four or less on domain-joined member servers.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>The default Windows configuration caches the last logon credentials for users who log on interactively to a system. This feature is provided for system availability reasons, such as the user's machine being disconnected from the network or domain controllers being unavailable. Even though the credential cache is well protected, if a system is attacked, an unauthorized individual may isolate the password to a domain user account using a password-cracking program and gain access to the domain.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:254432"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:254432" version="1" class="compliance">
          <metadata>
            <title>Windows must limit the caching of logon credentials to four or less on domain-joined member servers.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25443200" comment="'Interactive logon: Number of previous logons to cache' is set to 4 or less"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25443200" version="1" check_existence="at_least_one_exists" check="all" comment="'Interactive logon: Number of previous logons to cache' is set to 4 or less">
