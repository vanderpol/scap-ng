          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "WN25-DC-000370 - The Windows Server 2025 \"Deny access to this computer from the network\" user right on domain controllers must be configured to prevent unauthenticated access."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
                "text": "Microsoft Windows Server 2025"
              }
            ],
            "name": "affected",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Inappropriately granting user rights provides system, administrative, and other high-level capabilities.\n\n  The \"Deny access to this computer from the network\" user right defines the accounts that are prevented from logging on from the network.\n\n  The Guests group must be assigned this right to prevent unauthenticated access."
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
