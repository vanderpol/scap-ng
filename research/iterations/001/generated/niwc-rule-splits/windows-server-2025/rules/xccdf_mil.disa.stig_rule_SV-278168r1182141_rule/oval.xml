      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278168" version="1" class="compliance">
          <metadata>
            <title>WN25-DC-000370 - The Windows Server 2025 "Deny access to this computer from the network" user right on domain controllers must be configured to prevent unauthenticated access.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Inappropriately granting user rights provides system, administrative, and other high-level capabilities.

  The "Deny access to this computer from the network" user right defines the accounts that are prevented from logging on from the network.

  The Guests group must be assigned this right to prevent unauthenticated access.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:254421"/>
          </criteria>
        </definition>
