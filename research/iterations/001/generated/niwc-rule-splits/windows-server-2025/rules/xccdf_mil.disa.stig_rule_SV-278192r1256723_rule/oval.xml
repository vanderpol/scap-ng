        <definition id="oval:mil.disa.stig.windows2025:def:278192" version="2" class="compliance">
          <metadata>
            <title>WN25-PK-000010 - Windows Server 2025 must have the DoW Root Certificate Authority (CA) certificates installed in the Trusted Root Store.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>To ensure secure DoW websites and DoW-signed code are properly validated, the system must trust the DoW Root CAs. The DoW root certificates will ensure that the trust chain is established for server certificates issued from the DoW CAs.

  Satisfies: SRG-OS-000066-GPOS-00034, SRG-OS-000403-GPOS-00182, SRG-OS-000775-GPOS-00230</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253427"/>
          </criteria>
        </definition>
