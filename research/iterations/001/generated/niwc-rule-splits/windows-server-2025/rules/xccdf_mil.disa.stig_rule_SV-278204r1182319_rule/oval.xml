      <definitions><definition id="oval:mil.disa.stig.defs:def:253442" version="1" class="compliance">
          <metadata>
            <title>The maximum age for machine account passwords must be configured to 30 days or less.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25344200"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.windows2025:def:278204" version="1" class="compliance">
          <metadata>
            <title>WN25-SO-000100 - Windows Server 2025 maximum age for machine account passwords must be configured to 30 days or less.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Computer account passwords are changed automatically on a regular basis. This setting controls the maximum password age that a machine account may have. This must be set to no more than 30 days, ensuring the machine changes its password monthly.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253442"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25344200" version="2" check="all" state_operator="AND" comment="'Domain member: Maximum machine account password age' is set to 30 or less (but not 0).">
          <object object_ref="oval:mil.disa.stig.win:obj:25344200"/>
          <state state_ref="oval:mil.disa.stig.win:ste:25344200"/>
          <state state_ref="oval:mil.disa.stig.win:ste:25344201"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25344200" version="1">
          <hive>HKEY_LOCAL_MACHINE</hive>
          <key>SYSTEM\CurrentControlSet\Services\Netlogon\Parameters</key>
          <name>MaximumPasswordAge</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:25344200" version="1">
