      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278217" version="1" class="compliance">
          <metadata>
            <title>WN25-SO-000230 - Windows Server 2025 must not allow anonymous enumeration of shares.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Allowing anonymous logon users (null session connections) to list all account names and enumerate all shared resources can provide a map of potential points to attack the system.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253454"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:253454" version="1" class="compliance">
          <metadata>
            <title>Anonymous enumeration of shares must be restricted.</title>
            <description/>
          </metadata>
          <criteria operator="AND">
            <criterion test_ref="oval:mil.disa.stig.win:tst:25345400" comment="Verifies 'Network access: Do not allow anonymous enumeration of SAM accounts and shares' is set to 'Enabled'"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25345400" version="1" check_existence="at_least_one_exists" check="all" comment="'Network access: Do not allow anonymous enumeration of SAM accounts and shares' is set to 'Enabled'">
          <object object_ref="oval:mil.disa.stig.win:obj:25345400"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000001"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25345400" version="2">
          <hive datatype="string" operation="equals">HKEY_LOCAL_MACHINE</hive>
          <key datatype="string" operation="equals">SYSTEM\CurrentControlSet\Control\Lsa</key>
          <name datatype="string" operation="equals">restrictanonymous</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000001" version="1">
          <type>reg_dword</type>
          <value datatype="int">1</value>
        </registry_state>
