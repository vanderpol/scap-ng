      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:278005" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 passwords must be configured to expire.</title>
            <description>Passwords that do not expire or are reused increase the exposure of a password with greater probability of being discovered or cracked.</description>
          </metadata>
          <criteria operator="OR">
            <criteria>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800501" comment="Windows Server - Local user account passwords must be configured to expire."/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800502" comment="The system is a Windows Standalone Server or a Windows Domain Member Server"/>
            </criteria>
            <criteria>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800503" comment="Windows Domain Controller - Active Directory User Account passwords must be configured to expire."/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800504" comment="The system is a Windows Domain Controller"/>
            </criteria>
          </criteria>
        </definition>
        </definitions><tests><win-def:cmdlet_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800503" version="1" comment="Windows Domain Controller - Active Directory User Account Passwords for Enabled Users must be configured to expire." check_existence="none_exist" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800503"/>
        </win-def:cmdlet_test>
        <win-def:wmi57_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800502" version="1" comment="The system is a Windows Standalone Server or a Windows Domain Member Server" check="all" state_operator="OR">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800502"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800501"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800502"/>
        </win-def:wmi57_test>
        <win-def:cmdlet_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800501" version="1" comment="Windows Server - Local User Account Passwords from Enabled Users must be configured to expire." check_existence="none_exist" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800501"/>
        </win-def:cmdlet_test>
        <win-def:wmi57_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27800504" version="1" comment="The system is a Windows Domain Controller" check="all" state_operator="OR">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800502"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800504"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800505"/>
        </win-def:wmi57_test>
        </tests><objects><win-def:wmi57_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800502" version="1">
          <win-def:namespace>root\cimv2</win-def:namespace>
          <win-def:wql>SELECT DomainRole FROM win32_computersystem</win-def:wql>
        </win-def:wmi57_object>
        <win-def:cmdlet_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800501" version="1" comment="Enabled Local Accounts with PasswordExpires=False should not exist (list only the first 100, if any are found)">
          <win-def:module_name>CimCmdlets</win-def:module_name>
          <win-def:module_id xsi:nil="true"/>
          <win-def:module_version datatype="version" xsi:nil="true"/>
          <win-def:verb>Get</win-def:verb>
          <win-def:noun>CimInstance</win-def:noun>
          <win-def:parameters datatype="record">
            <field name="class">Win32_Useraccount</field>
            <field name="filter">PasswordExpires=False and LocalAccount=True and Disabled=False</field>
          </win-def:parameters>
          <win-def:select datatype="record">
            <field name="first">100</field>
          </win-def:select>
        </win-def:cmdlet_object>
        <win-def:cmdlet_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27800503" version="1" comment="Enabled Local Accounts with PasswordExpires=False should not exist (list only the first 100, if any are found)">
          <win-def:module_name>ActiveDirectory</win-def:module_name>
          <win-def:module_id xsi:nil="true"/>
          <win-def:module_version datatype="version" xsi:nil="true"/>
          <win-def:verb>Get</win-def:verb>
          <win-def:noun>ADUser</win-def:noun>
          <win-def:parameters datatype="record">
            <field name="properties">PasswordNeverExpires</field>
            <field name="filter">Enabled -eq $true -and PasswordNeverExpires -eq $true</field>
          </win-def:parameters>
          <win-def:select datatype="record">
            <field name="first">100</field>
          </win-def:select>
        </win-def:cmdlet_object>
        </objects><states><win-def:wmi57_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800502" version="1" comment="Domain Member Server">
          <win-def:result datatype="record" operation="equals">
            <field name="domainrole">3</field>
          </win-def:result>
        </win-def:wmi57_state>
        <win-def:wmi57_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800501" version="1" comment="Standalone Server">
          <win-def:result datatype="record" operation="equals">
            <field name="domainrole">2</field>
          </win-def:result>
        </win-def:wmi57_state>
        <win-def:wmi57_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800505" version="1" comment="Primary Domain Controller">
          <win-def:result datatype="record" operation="equals">
            <field name="domainrole">5</field>
          </win-def:result>
        </win-def:wmi57_state>
        <win-def:wmi57_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27800504" version="1" comment="Backup Domain Controller">
          <win-def:result datatype="record" operation="equals">
            <field name="domainrole">4</field>
          </win-def:result>
        </win-def:wmi57_state>
        </states></oval_definitions>
