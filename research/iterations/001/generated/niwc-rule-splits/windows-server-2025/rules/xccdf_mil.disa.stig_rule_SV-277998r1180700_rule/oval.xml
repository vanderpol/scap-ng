      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:277998" version="1" class="compliance">
          <metadata>
            <title>Windows Server 2025 permissions for the system drive root directory (usually C:\) must conform to minimum requirements.</title>
            <description>Permissions for the system drive root directory (usually C:\) must conform to minimum requirements.</description>
          </metadata>
          <criteria>
            <criterion comment="Network access: Let Everyone permissions apply to anonymous users is set to 'Disabled'" test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27799801"/>
            <criterion comment="Permissions must conform to minimum requirements for system drive root directory." test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:27799802"/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27799802" version="1" comment="Permissions must conform to minimum requirements." check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27799802"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27799802"/>
        </independent-def:shellcommand_test>
        <win-def:registry_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:27799801" version="1" comment="Network access: Let Everyone permissions apply to anonymous users is set to 'Disabled'" check_existence="at_least_one_exists" check="only one">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:27799801"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:27799801"/>
        </win-def:registry_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27799802" version="1" comment="Run Icacls command against system drive root directory">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>icacls($env:SystemDrive + '\')</independent-def:command>
          <independent-def:pattern>:</independent-def:pattern>
        </independent-def:shellcommand_object>
        <win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:27799801" version="1" comment="everyoneincludesanonymous must be configured">
          <win-def:hive>HKEY_LOCAL_MACHINE</win-def:hive>
          <win-def:key>SYSTEM\CurrentControlSet\Control\Lsa</win-def:key>
          <win-def:name>everyoneincludesanonymous</win-def:name>
        </win-def:registry_object>
        </objects><states><win-def:registry_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27799801" version="1" comment="Value must be equal to 0">
          <win-def:value datatype="int" operation="equals">0</win-def:value>
        </win-def:registry_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:27799802" version="1" comment="Permissions must equal expected output">
          <independent-def:exit_status datatype="int">0</independent-def:exit_status>
          <independent-def:stdout_line var_check="at least one" operation="pattern match" var_ref="oval:navy.navwar.niwcatlantic.scc.windows:var:27799801"/>
          <independent-def:stderr_line check_existence="none_exist"/>
        </independent-def:shellcommand_state>
        </states><variables><constant_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:27799801" version="1" datatype="string" comment="Required Permissions">
