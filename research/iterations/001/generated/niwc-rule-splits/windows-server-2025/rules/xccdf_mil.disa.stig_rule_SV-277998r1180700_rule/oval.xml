          <value>(?i)BUILTIN\\Administrators:\(OI\)\(CI\)\(F\)</value>
          <value>(?i)BUILTIN\\Users:\(OI\)\(CI\)\(RX\)</value>
          <value>(?i)BUILTIN\\Users:\(CI\)\(AD\)</value>
          <value>(?i)BUILTIN\\Users:\(CI\)\(IO\)\(WD\)</value>
          <value>(?i)CREATOR OWNER:\(OI\)\(CI\)\(IO\)\(F\)</value>
