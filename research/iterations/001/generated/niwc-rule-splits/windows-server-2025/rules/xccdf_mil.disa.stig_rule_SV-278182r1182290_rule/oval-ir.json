          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "The Windows SAM stores users' passwords. Restricting Remote Procedure Call (RPC) connections to the SAM to Administrators helps protect those credentials."
          }
        ],
