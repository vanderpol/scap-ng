  "definitions": [
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "The password for the krbtgt account on a domain must be reset at least every 180 days.",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:navy.navwar.niwcatlantic.scc.windows:tst:27817601"
          }
        ],
        "comment": null,
