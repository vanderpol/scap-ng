      <definitions><definition id="oval:mil.disa.stig.windows2025:def:278228" version="1" class="compliance">
          <metadata>
            <title>WN25-SO-000340 - Windows Server 2025 session security for NTLM SSP-based servers must be configured to require NTLMv2 session security and 128-bit encryption.</title>
            <affected family="windows">
              <platform>Microsoft Windows Server 2025</platform>
            </affected>
            <description>Microsoft has implemented a variety of security support providers for use with Remote Procedure Call (RPC) sessions. All of the options must be enabled to ensure the maximum security level.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253465"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.defs:def:253465" version="1" class="compliance">
          <metadata>
            <title>The system must be configured to meet the minimum session security requirement for NTLM SSP based servers.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25346500" comment="Verifies 'Network security: Minimum session security for NTLM SSP based (including secure RPC) servers' is set to 'Require NTLMv2 session security' and 'Require 128-bit encryption'"/>
          </criteria>
        </definition>
