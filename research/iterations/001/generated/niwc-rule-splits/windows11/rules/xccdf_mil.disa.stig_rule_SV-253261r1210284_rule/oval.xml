            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25326100" comment="BitLocker must be 6 digits or more."/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25326100" version="1" check_existence="at_least_one_exists" check="all" comment="BitLocker must be 6 digits or more.">
