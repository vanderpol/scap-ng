      <definitions><definition id="oval:mil.disa.stig.defs:def:253450" version="1" class="compliance">
          <metadata>
            <title>Unencrypted passwords must not be sent to third-party SMB Servers.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25345000" comment="Verifies 'Microsoft Network Client: Send unencrypted password to connect to third-party SMB servers' is set to 'Disabled'"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.windows11:def:253450" version="2" class="compliance">
          <metadata>
            <title>WN11-SO-000110 - Unencrypted passwords must not be sent to third-party SMB Servers.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Some non-Microsoft SMB servers only support unencrypted (plain text) password authentication. Sending plain text passwords across the network, when authenticating to an SMB server, reduces the overall security of the environment. Check with the vendor of the SMB server to see if there is a way to support encrypted password authentication.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253450"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25345000" version="1" check_existence="at_least_one_exists" check="all" comment="'Microsoft Network Client: Send unencrypted password to connect to third-party SMB servers' is set to 'Disabled'">
          <object object_ref="oval:mil.disa.stig.win:obj:25345000"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000000"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25345000" version="2">
          <hive datatype="string" operation="case insensitive equals">HKEY_LOCAL_MACHINE</hive>
          <key datatype="string" operation="case insensitive equals">SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters</key>
          <name datatype="string" operation="case insensitive equals">EnablePlainTextPassword</name>
        </registry_object>
