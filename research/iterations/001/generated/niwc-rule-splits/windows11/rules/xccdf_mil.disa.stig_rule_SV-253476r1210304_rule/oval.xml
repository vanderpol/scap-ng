      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253476" version="18" class="compliance">
          <metadata>
            <title>Passwords for enabled local Administrator accounts must be changed at least every 60 days.</title>
            <description>Windows Server passwords for the built-in Administrator account must be changed at least every 60 days.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25347601" comment="PasswordLastSet date must be less than or equal to 60 days old for all local administrator accounts"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25347602" comment="LAPS Compliance: Password Age - 60"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25347603" comment="LAPS Compliance: Password Length - 14"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25347604" comment="LAPS Compliance: Password Complexity - large letters + small letters + numbers + specials"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25347605" comment="Verify LAPS policy process is completing"/>
          </criteria>
        </definition>
