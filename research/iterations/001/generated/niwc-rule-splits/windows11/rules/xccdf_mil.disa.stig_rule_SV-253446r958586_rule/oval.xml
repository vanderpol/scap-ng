      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253446" version="18" class="compliance">
          <metadata>
            <title>The Windows message title for the legal notice must be configured.</title>
            <description>Failure to display the logon banner prior to a logon attempt will negate legal proceedings resulting from unauthorized access to system resources.</description>
          </metadata>
