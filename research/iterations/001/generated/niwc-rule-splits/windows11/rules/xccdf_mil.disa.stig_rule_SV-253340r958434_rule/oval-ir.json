            "text": "WN11-AU-000515 - Windows 11 permissions for the Application event log must prevent access by non-privileged accounts."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
