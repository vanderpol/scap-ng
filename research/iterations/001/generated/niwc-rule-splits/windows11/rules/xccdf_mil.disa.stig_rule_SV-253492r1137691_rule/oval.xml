      <definitions><definition id="oval:mil.disa.stig.defs:def:253492" version="6" class="compliance">
          <metadata>
            <title>The "Deny log on as a batch job" user right on domain-joined workstations must be configured to prevent access from highly privileged domain accounts.</title>
            <description/>
          </metadata>
          <criteria>
