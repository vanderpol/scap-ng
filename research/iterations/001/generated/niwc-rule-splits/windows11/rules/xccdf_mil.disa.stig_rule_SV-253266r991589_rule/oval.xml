      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253266" version="18" class="compliance">
          <metadata>
            <title>Alternate operating systems must not be permitted on the same system.</title>
            <description>Allowing other operating systems to run on a secure system may allow security to be circumvented.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25326601" comment="Alternate operating systems must not be permitted on the same system."/>
          </criteria>
        </definition>
