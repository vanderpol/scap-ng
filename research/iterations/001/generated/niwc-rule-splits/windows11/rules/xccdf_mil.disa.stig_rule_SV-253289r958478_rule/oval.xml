          <metadata>
            <title>The Secondary Logon service must be disabled on Windows.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25328900" comment="Verifies the Secondary Logon service Startup Type is Disabled or the service is uninstalled."/>
