        <definition id="oval:mil.disa.stig.windows11:def:253289" version="2" class="compliance">
          <metadata>
            <title>WN11-00-000175 - The Secondary Logon service must be disabled on Windows 11.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>The Secondary Logon service provides a means for entering alternate credentials, typically used to run commands with elevated privileges. Using privileged credentials in a standard user session can expose those credentials to theft.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253289"/>
          </criteria>
        </definition>
