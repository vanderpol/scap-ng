      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253363" version="18" class="compliance">
          <metadata>
            <title>Windows 11 must be configured to prioritize ECC Curves with longer key lengths first.</title>
            <description>Use of weak or untested encryption algorithms undermines the purposes of utilizing encryption to protect data. By default Windows uses ECC curves with shorter key lengths first.  Requiring ECC curves with longer key lengths to be prioritized first helps ensure more secure algorithms are used.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25336301" comment="Prioritize ECC Curves with longer key lengths first."/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:variable_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25336301" version="18" comment="Prioritize ECC Curves with longer key lengths first. NistP384 Requirement" check_existence="at_least_one_exists" check="only one">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25336301"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25336301"/>
        </independent-def:variable_test>
        </tests><objects><win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25336302" version="18" comment="SSL - EccCurves Setting">
          <win-def:hive>HKEY_LOCAL_MACHINE</win-def:hive>
          <win-def:key>SOFTWARE\Policies\Microsoft\Cryptography\Configuration\SSL\00010002\</win-def:key>
          <win-def:name>EccCurves</win-def:name>
        </win-def:registry_object>
        <independent-def:variable_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25336301" version="18">
          <independent-def:var_ref>oval:navy.navwar.niwcatlantic.scc.windows:var:25336301</independent-def:var_ref>
        </independent-def:variable_object>
        </objects><states><independent-def:variable_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25336301" version="18">
          <independent-def:value operation="pattern match">^NistP384\s*NistP256$</independent-def:value>
        </independent-def:variable_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.windows:var:25336301" version="18" comment="Merged Multi-String SSL - EccCurves Setting" datatype="string">
