        <definition id="oval:mil.disa.stig.windows11:def:253453" version="2" class="compliance">
          <metadata>
            <title>WN11-SO-000145 - Anonymous enumeration of SAM accounts must not be allowed.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Anonymous enumeration of SAM accounts allows anonymous log on users (null session connections) to list all accounts names, thus providing a list of potential points to attack the system.</description>
