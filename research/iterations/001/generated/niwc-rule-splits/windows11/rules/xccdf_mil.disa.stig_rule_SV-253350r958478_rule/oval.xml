          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25335001"/>
        </win-def:registry_test>
        </tests><objects><win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25335001" version="18" comment="Prevent enabling lock screen camera">
