      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:268318" version="18" class="compliance">
          <metadata>
            <title>Windows 11 systems must use either Group Policy or an approved Mobile Device Management (MDM) product to enforce STIG compliance.</title>
            <description>Windows systems must use either Group Policy or an approved Mobile Device Management (MDM) product to enforce STIG compliance.</description>
          </metadata>
          <criteria operator="OR">
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:26831801" comment="Windows systems must use either Group Policy or an approved Mobile Device Management (MDM) product to enforce STIG compliance."/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:26831802" comment="Windows systems must use either Group Policy or an approved Mobile Device Management (MDM) product to enforce STIG compliance."/>
          </criteria>
        </definition>
        </definitions><tests><win-def:cmdlet_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:26831801" version="18" comment="Test to ensure that at least one GPO applied is enabled" check_existence="at_least_one_exists" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:26831801"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:26831801"/>
        </win-def:cmdlet_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:26831802" version="18" comment="Run a PowerShell command to determine if a Mobile Device Management (MDM) product is in use to enforce STIG compliance" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:26831802"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:26831802"/>
        </independent-def:shellcommand_test>
        </tests><objects><win-def:cmdlet_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:26831801" version="18" comment="Computer GPO's applied">
          <win-def:module_name operation="equals">CimCmdlets</win-def:module_name>
          <win-def:module_id xsi:nil="true"/>
          <win-def:module_version datatype="version" xsi:nil="true"/>
          <win-def:verb>Get</win-def:verb>
          <win-def:noun>CimInstance</win-def:noun>
          <win-def:parameters datatype="record">
            <field name="classname">RSOP_GPLink</field>
            <field name="namespace">ROOT\RSOP\Computer</field>
          </win-def:parameters>
          <win-def:select datatype="record">
            <field name="property">appliedOrder,enabled,GPO,SOM</field>
          </win-def:select>
        </win-def:cmdlet_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:26831802" version="18" comment="MDM is managing the device">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Get-Service -name IntuneManagementExtension</independent-def:command>
          <independent-def:pattern>IntuneManagementExtension</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><win-def:cmdlet_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:26831801" version="18" comment="At least one enabled must be True">
          <win-def:value datatype="record" entity_check="at least one">
            <field name="enabled">True</field>
          </win-def:value>
        </win-def:cmdlet_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:26831802" version="18" comment="stdout_line must contain the output running">
          <independent-def:stdout_line operation="pattern match">Running</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        </states></oval_definitions>
