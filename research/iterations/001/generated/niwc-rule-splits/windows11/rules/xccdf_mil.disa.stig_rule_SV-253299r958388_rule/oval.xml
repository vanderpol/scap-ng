      <definitions><definition id="oval:mil.disa.stig.windows11:def:253299" version="2" class="compliance">
          <metadata>
            <title>WN11-AC-000015 - The period of time before the bad logon counter is reset must be configured to 15 minutes.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>The account lockout feature, when enabled, prevents brute-force password attacks on the system. This parameter specifies the period of time that must pass after failed logon attempts before the counter is reset to 0. The smaller this value is, the less effective the account lockout feature will be in protecting the local system.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253299"/>
          </criteria>
        </definition>
