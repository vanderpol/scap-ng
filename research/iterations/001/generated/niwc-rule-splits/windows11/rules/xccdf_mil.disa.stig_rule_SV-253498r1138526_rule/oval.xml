      <definitions><definition id="oval:mil.disa.stig.windows11:def:253498" version="2" class="compliance">
          <metadata>
            <title>WN11-UR-000110 - The "Impersonate a client after authentication" user right must only be assigned to Administrators, Service, Local Service, and Network Service.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Inappropriate granting of user rights can provide system, administrative, and other high-level capabilities.

The "Impersonate a client after authentication" user right allows a program to impersonate another user or account to run on their behalf. An attacker could potentially use this to elevate privileges.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253498"/>
          </criteria>
        </definition>
