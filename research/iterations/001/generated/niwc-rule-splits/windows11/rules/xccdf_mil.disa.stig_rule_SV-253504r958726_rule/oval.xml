      <definitions><definition id="oval:mil.disa.stig.windows11:def:253504" version="2" class="compliance">
          <metadata>
            <title>WN11-UR-000150 - The "Profile single process" user right must only be assigned to the Administrators group.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Inappropriate granting of user rights can provide system, administrative, and other high-level capabilities.

Accounts with the "Profile single process" user right can monitor non-system processes performance. An attacker could potentially use this to identify processes to attack.</description>
          </metadata>
