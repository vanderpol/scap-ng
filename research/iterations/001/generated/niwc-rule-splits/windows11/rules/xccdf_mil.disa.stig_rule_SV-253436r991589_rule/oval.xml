        <definition id="oval:mil.disa.stig.windows11:def:253436" version="2" class="compliance">
          <metadata>
            <title>WN11-SO-000025 - The built-in guest account must be renamed.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>The built-in guest account is a well-known user account on all Windows systems and, as initially installed, does not require a password. This can allow access to system resources by unauthorized users. Renaming this account to an unidentified name improves the protection of this account and the system.</description>
