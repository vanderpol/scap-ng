        <definition id="oval:mil.disa.stig.windows11:def:253376" version="2" class="compliance">
          <metadata>
            <title>WN11-CC-000110 - Printing over HTTP must be prevented.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Some features may communicate with the vendor, sending system information or downloading data or components for the feature. Turning off this capability will prevent potentially sensitive information from being sent outside the enterprise and uncontrolled updates to the system. This setting prevents the client computer from printing over HTTP, which allows the computer to print to printers on the intranet as well as the internet.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253376"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25337600" version="1" check_existence="at_least_one_exists" check="all" comment="'Turn off printing over HTTP' is set to 'Enabled'">
