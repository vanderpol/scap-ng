      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253274" version="18" class="compliance">
          <metadata>
            <title>Permissions for system files and directories must conform to minimum requirements.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25327401" comment="Network access: Let Everyone permissions apply to anonymous users is set to 'Disabled'"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25327402" comment="Windows permissions for the system drive root directory (usually C:\) must conform to minimum requirements."/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25327403" comment="Windows permissions for the Windows installation directory must conform to minimum requirements."/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25327404" comment="Windows permissions must conform to minimum requirements for Program Files directory."/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25327405" comment="Windows permissions must conform to minimum requirements for Program Files(x86) directory."/>
          </criteria>
        </definition>
