        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25327404" version="18" comment="Run Icacls command against Program Files directory">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>icacls (Get-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion" -Name ProgramFilesDir).ProgramFilesDir</independent-def:command>
          <independent-def:pattern>:</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25327405" version="18" comment="Run Icacls command against Program Files (x86) directory">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>icacls (Get-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion" -Name 'ProgramFilesDir (x86)').'ProgramFilesDir (x86)'</independent-def:command>
          <independent-def:pattern>:</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25327403" version="18" comment="Run Icacls command against Windows install directory">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>icacls($env:windir)</independent-def:command>
          <independent-def:pattern>:</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25327402" version="18" comment="Run Icacls command against system drive root directory">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>icacls($env:SystemDrive + '\')</independent-def:command>
          <independent-def:pattern>:</independent-def:pattern>
        </independent-def:shellcommand_object>
