      <definitions><definition id="oval:mil.disa.stig.windows11:def:253400" version="2" class="compliance">
          <metadata>
            <title>WN11-CC-000255 - The use of a hardware security device with Windows Hello for Business must be enabled.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>The use of a Trusted Platform Module (TPM) to store keys for Windows Hello for Business provides additional security. Keys stored in the TPM may only be used on that system while keys stored using software are more susceptible to compromise and could be used on other systems.</description>
          </metadata>
