        <definition id="oval:mil.disa.stig.windows11:def:253388" version="2" class="compliance">
          <metadata>
            <title>WN11-CC-000190 - Autoplay must be disabled for all drives.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Allowing autoplay to execute may introduce malicious code to a system. Autoplay begins reading from a drive as soon as media is inserted in the drive. As a result, the setup file of programs or music on audio media may start. By default, autoplay is disabled on removable drives, such as the floppy disk drive (but not the CD-ROM drive) and on network drives. If this policy is enabled, autoplay can be disabled on all drives.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253388"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25338800" version="1" check_existence="all_exist" check="all" comment="'Turn off AutoPlay' is set to 'Enabled:All Drives'">
