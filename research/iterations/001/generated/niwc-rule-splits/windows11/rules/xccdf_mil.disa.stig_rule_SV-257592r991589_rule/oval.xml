      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:257592" version="18" class="compliance">
          <metadata>
            <title>Windows 11 must not have portproxy enabled or in use.</title>
            <description>Having portproxy enabled or configured in Windows 10 could allow a man-in-the-middle attack.</description>
          </metadata>
          <criteria operator="AND">
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25759201" comment="Ensure no portproxies are configured."/>
            <criteria operator="AND">
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25759202" comment="Check registry for existence of v4tov4\tcp"/>
            </criteria>
          </criteria>
        </definition>
        </definitions><tests><win-def:registry_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25759201" version="18" comment="Windows 11 must not have portproxy enabled or in use." check_existence="none_exist" check="only one">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25759201"/>
        </win-def:registry_test>
        <win-def:registry_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25759202" version="18" comment="Windows 11 must not have portproxy enabled or in use." check_existence="none_exist" check="only one">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25759202"/>
        </win-def:registry_test>
        </tests><objects><win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25759202" version="18" comment="Check registry for existence of v4tov4\tcp">
          <win-def:hive>HKEY_LOCAL_MACHINE</win-def:hive>
          <win-def:key>SYSTEM\CurrentControlSet\Services\PortProxy\v4tov4\tcp</win-def:key>
          <win-def:name xsi:nil="true"/>
        </win-def:registry_object>
        <win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25759201" version="18" comment="Ensure no portproxies are configured.">
          <win-def:hive>HKEY_LOCAL_MACHINE</win-def:hive>
          <win-def:key operation="pattern match">SYSTEM\\CurrentControlSet\\Services\\PortProxy\\v.tov.\\.*</win-def:key>
          <win-def:name operation="pattern match">.*</win-def:name>
        </win-def:registry_object>
        </objects></oval_definitions>
