          <metadata>
            <title>WN11-CC-000185 - The default autorun behavior must be configured to prevent autorun commands.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Allowing autorun commands to execute may introduce malicious code to a system. Configuring this setting prevents autorun commands from executing.</description>
