      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253257" version="18" class="compliance">
          <metadata>
            <title>Secure Boot must be enabled on Windows 11 systems.</title>
            <affected family="windows"> </affected>
            <description>Secure Boot is a standard that ensures systems boot only to a trusted operating system. Secure Boot is required to support additional security features in Windows, including Virtualization Based Security and Credential Guard. If Secure Boot is turned off, these security features will not function.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25325701" comment="Secure Boot must be enabled."/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25325701" version="18" comment="Run a PowerShell command to determine if Secure Boot must be enabled." check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25325701"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25325701"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25325701" version="18" comment="Run a PowerShell command to determine if secure boot is enabled">
          <independent-def:shell>powershell</independent-def:shell>
          <independent-def:command>Confirm-SecureBootUEFI</independent-def:command>
          <independent-def:pattern/>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25325701" version="18" comment="Verify True is returned to stdout">
          <independent-def:stdout_line>True</independent-def:stdout_line>
        </independent-def:shellcommand_state>
