          <key datatype="string">SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters</key>
          <name datatype="string">SMB1</name>
        </registry_object>
        <wmi57_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25328600" version="1">
          <namespace datatype="string">root\cimv2</namespace>
          <wql datatype="string" operation="equals">SELECT installstate FROM win32_optionalfeature WHERE name = 'SMB1Protocol'</wql>
        </wmi57_object>
        <registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25328800" version="1">
          <hive datatype="string">HKEY_LOCAL_MACHINE</hive>
          <key datatype="string">SYSTEM\CurrentControlSet\Services\mrxsmb10</key>
          <name datatype="string">Start</name>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000004" version="1" comment="Reg_Dword type and value equals 4">
          <type>reg_dword</type>
          <value datatype="int">4</value>
        </registry_state>
        <registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000000" version="1">
          <type>reg_dword</type>
          <value datatype="int">0</value>
        </registry_state>
        <wmi57_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:25328600" version="1" comment="Check SMB v1 Protocol Win32_OptionalFeature object InstallState is equal to 2">
          <result datatype="record" operation="equals">
            <field xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5" name="installstate" entity_check="at least one" datatype="string">2</field>
          </result>
