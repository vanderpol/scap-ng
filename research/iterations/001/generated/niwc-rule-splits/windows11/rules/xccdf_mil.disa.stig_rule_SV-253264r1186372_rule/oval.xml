      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253264" version="18" class="compliance">
          <metadata>
            <title>The Windows 11 system must use an antivirus program.</title>
            <description>Malicious software can establish a base on individual desktops and servers. Employing an automated mechanism to detect this type of software will aid in elimination of the software from the operating system.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25326401" comment="Windows must use an antivirus program."/>
          </criteria>
        </definition>
        </definitions><tests><win-def:cmdlet_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25326401" version="18" comment="Windows must use an antivirus program" check_existence="at_least_one_exists" check="all">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25326401"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25326401"/>
        </win-def:cmdlet_test>
        </tests><objects><win-def:cmdlet_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25326401" version="18" comment="Gather AntivirusProduct from SecurityCenter2">
          <win-def:module_name operation="equals">CimCmdlets</win-def:module_name>
          <win-def:module_id xsi:nil="true"/>
          <win-def:module_version datatype="version" xsi:nil="true"/>
          <win-def:verb>Get</win-def:verb>
          <win-def:noun>CimInstance</win-def:noun>
          <win-def:parameters datatype="record">
            <field name="classname">antivirusproduct</field>
            <field name="namespace">root\securitycenter2</field>
          </win-def:parameters>
          <win-def:select datatype="record">
            <field name="property">displayname,productstate</field>
          </win-def:select>
        </win-def:cmdlet_object>
        </objects><states><win-def:cmdlet_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25326401" version="18" comment="An antivirus program must be installed and running">
          <win-def:value datatype="record" entity_check="at least one">
            <field name="productstate" datatype="int" operation="bitwise and">4096</field>
          </win-def:value>
        </win-def:cmdlet_state>
        </states></oval_definitions>
