      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253255" version="18" class="compliance">
          <metadata>
            <title>Windows 11 systems must have a Trusted Platform Module (TPM) enabled.</title>
            <description>Credential Guard uses virtualization-based security to protect information that could be used in credential theft attacks if compromised. A number of system requirements must be met for Credential Guard to be configured and enabled properly. Without a TPM enabled and ready for use, Credential Guard keys are stored in a less secure method using software.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25325501" comment="Windows domain-joined systems must have a Trusted Platform Module (TPM) enabled and ready for use."/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25325502" comment="Windows TPM Specific Version should be version 2.0"/>
          </criteria>
        </definition>
        </definitions><tests><win-def:cmdlet_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25325501" version="18" comment="Windows must have TPM and must be ready to use" check_existence="at_least_one_exists" check="at least one">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25325501"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25325501"/>
        </win-def:cmdlet_test>
        <win-def:cmdlet_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25325502" version="18" comment="Windows TPM Specific Version should be version 2.0" check_existence="at_least_one_exists" check="at least one">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25325502"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25325502"/>
        </win-def:cmdlet_test>
        </tests><objects><win-def:cmdlet_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25325502" version="18" comment="Check for TPM Specific Version">
          <win-def:module_name operation="equals">CimCmdlets</win-def:module_name>
          <win-def:module_id xsi:nil="true"/>
          <win-def:module_version datatype="version" xsi:nil="true"/>
          <win-def:verb>Get</win-def:verb>
          <win-def:noun>CimInstance</win-def:noun>
          <win-def:parameters datatype="record">
            <field name="classname">Win32_TPM</field>
            <field name="namespace">root\cimv2\security\microsofttpm</field>
          </win-def:parameters>
          <win-def:select datatype="record">
            <field name="property">specversion</field>
          </win-def:select>
        </win-def:cmdlet_object>
        <win-def:cmdlet_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25325501" version="18" comment="Check for TPM values">
          <win-def:module_name>TrustedPlatformModule</win-def:module_name>
          <win-def:module_id xsi:nil="true"/>
          <win-def:module_version datatype="version" xsi:nil="true"/>
          <win-def:verb>Get</win-def:verb>
          <win-def:noun>Tpm</win-def:noun>
          <win-def:parameters xsi:nil="true"/>
          <win-def:select datatype="record">
            <field name="property">tpmpresent,tpmready,tpmenabled</field>
          </win-def:select>
        </win-def:cmdlet_object>
        </objects><states><win-def:cmdlet_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25325502" version="18" comment="Specific Version must be 2.0">
          <win-def:value datatype="record">
            <field name="specversion" operation="pattern match">2\.0</field>
          </win-def:value>
        </win-def:cmdlet_state>
        <win-def:cmdlet_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25325501" version="18" comment="TPM values must be equal to True">
          <win-def:value datatype="record">
            <field name="tpmpresent" operation="equals">True</field>
            <field name="tpmready" operation="equals">True</field>
            <field name="tpmenabled" operation="equals">True</field>
          </win-def:value>
        </win-def:cmdlet_state>
        </states></oval_definitions>
