        <definition id="oval:mil.disa.stig.windows11:def:253386" version="2" class="compliance">
          <metadata>
            <title>WN11-CC-000180 - Autoplay must be turned off for non-volume devices.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>Allowing autoplay to execute may introduce malicious code to a system. Autoplay begins reading from a drive as soon as media is inserted in the drive. As a result, the setup file of programs or music on audio media may start. This setting will disable autoplay for non-volume devices (such as Media Transfer Protocol (MTP) devices).</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253386"/>
          </criteria>
        </definition>
