            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "WN11-AC-000005 - Windows 11 account lockout duration must be configured to 15 minutes or greater."
          },
          {
            "attributes": {
              "family": "windows"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
