      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:253291" version="18" class="compliance">
          <metadata>
            <title>Bluetooth must be turned off unless approved by the organization.</title>
            <description>If not configured properly, Bluetooth may allow rogue devices to communicate with a system. If a rogue device is paired with a system, there is potential for sensitive information to be compromised.</description>
          </metadata>
          <criteria>
            <criterion comment="Bluetooth must be turned off unless approved by the organization." test_ref="oval:navy.navwar.niwcatlantic.scc.windows:tst:25329101"/>
          </criteria>
        </definition>
        </definitions><tests><win-def:registry_test id="oval:navy.navwar.niwcatlantic.scc.windows:tst:25329101" version="18" comment="Bluetooth radio must be turned off." check_existence="at_least_one_exists" check="only one">
          <win-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.windows:obj:25329101"/>
          <win-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.windows:ste:25329101"/>
        </win-def:registry_test>
        </tests><objects><win-def:registry_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:25329101" version="18" comment="Verify the Bluetooth radio is turned off">
          <win-def:hive>HKEY_LOCAL_MACHINE</win-def:hive>
          <win-def:key>SOFTWARE\Microsoft\PolicyManager\current\device\Connectivity</win-def:key>
          <win-def:name>AllowBluetooth</win-def:name>
        </win-def:registry_object>
        </objects><states><win-def:registry_state id="oval:navy.navwar.niwcatlantic.scc.windows:ste:25329101" version="18" comment="Value Equal To 0">
          <win-def:value operation="equals">0</win-def:value>
        </win-def:registry_state>
        </states></oval_definitions>
