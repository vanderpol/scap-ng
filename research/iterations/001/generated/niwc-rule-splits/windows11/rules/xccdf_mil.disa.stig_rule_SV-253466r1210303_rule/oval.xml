      <definitions><definition id="oval:mil.disa.stig.defs:def:25346600" version="1" class="compliance">
          <metadata>
            <title>The system must be configured to use FIPS-compliant algorithms for encryption, hashing, and signing.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:mil.disa.stig.win:tst:25346610" comment="FIPS-compliant algorithms are enabled"/>
          </criteria>
        </definition>
        <definition id="oval:mil.disa.stig.windows11:def:253466" version="3" class="compliance">
          <metadata>
            <title>WN11-SO-000230 - The system must be configured to use FIPS-compliant algorithms for encryption, hashing, and signing.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>This setting ensures the system uses algorithms that are FIPS compliant for encryption, hashing, and signing. FIPS-compliant algorithms meet specific standards established by the U.S. Government and must be the algorithms used for all OS encryption functions.

Note: A different registry location is needed when systems are managed by Intune versus GPO.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:25346600"/>
          </criteria>
        </definition>
        </definitions><tests><registry_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:tst:25346610" version="1" check="all" comment="FIPS-compliant algorithms are enabled">
          <object object_ref="oval:mil.disa.stig.win:obj:25346610"/>
          <state state_ref="oval:mil.disa.stig.win:ste:20000001"/>
        </registry_test>
        </tests><objects><registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25346611" version="2" comment="GPO registry entry for FIPS-compliant algorithms">
          <hive>HKEY_LOCAL_MACHINE</hive>
          <key>SYSTEM\CurrentControlSet\Control\Lsa\FIPSAlgorithmPolicy</key>
          <name>Enabled</name>
        </registry_object>
        <registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25346612" version="2" comment="Intune registry entry for FIPS-compliant algorithms">
          <hive>HKEY_LOCAL_MACHINE</hive>
          <key>SOFTWARE\Microsoft\PolicyManager\current\device\Cryptography</key>
          <name>AllowFipsAlgorithmPolicy_ProviderSet</name>
        </registry_object>
        <registry_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:obj:25346610" version="1" comment="Registry entries for FIPS-compliant algorithms">
          <set xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5">
            <object_reference>oval:mil.disa.stig.win:obj:25346611</object_reference>
            <object_reference>oval:mil.disa.stig.win:obj:25346612</object_reference>
          </set>
        </registry_object>
        </objects><states><registry_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows" id="oval:mil.disa.stig.win:ste:20000001" version="1">
