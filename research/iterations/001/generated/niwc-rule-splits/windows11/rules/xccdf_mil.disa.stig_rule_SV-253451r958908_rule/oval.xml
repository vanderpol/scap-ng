        <definition id="oval:mil.disa.stig.windows11:def:253451" version="2" class="compliance">
          <metadata>
            <title>WN11-SO-000120 - The Windows SMB server must be configured to always perform SMB packet signing.</title>
            <affected family="windows">
              <platform>Microsoft Windows 11</platform>
            </affected>
            <description>The server message block (SMB) protocol provides the basis for many network operations. Digitally signed SMB packets aid in preventing man-in-the-middle attacks. If this policy is enabled, the SMB server will only communicate with an SMB client that performs SMB packet signing.</description>
          </metadata>
          <criteria>
            <extend_definition definition_ref="oval:mil.disa.stig.defs:def:253451"/>
          </criteria>
        </definition>
