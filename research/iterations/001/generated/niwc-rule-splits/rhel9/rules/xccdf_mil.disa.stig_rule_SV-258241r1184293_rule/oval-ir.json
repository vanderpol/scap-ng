      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "RHEL 9 must implement a FIPS 140-3-compliant systemwide cryptographic policy."
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Centralized cryptographic policies simplify applying secure ciphers across an\n\t\t\toperating system and the applications that run on that operating system. Use of weak or\n\t\t\tuntested encryption algorithms undermines the purposes of using encryption to protect data.\n\n\t\t\t\tSatisfies: SRG-OS-000396-GPOS-00176, SRG-OS-000393-GPOS-00173, SRG-OS-000394-GPOS-00174"
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
      "version": "13"
    }
