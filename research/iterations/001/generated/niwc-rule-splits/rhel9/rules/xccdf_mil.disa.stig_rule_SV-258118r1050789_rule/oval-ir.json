            "text": "RHEL-09-611145 - RHEL 9 must not be configured to bypass password requirements for privilege escalation."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
