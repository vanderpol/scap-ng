        </textfilecontent54_test>
        <variable_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:23031601" version="1" check_existence="at_least_one_exists" check="all" comment="/etc/resolv.conf is configured with at least two name servers">
          <object object_ref="oval:mil.disa.stig.ind:obj:23031601"/>
          <state state_ref="oval:mil.disa.stig.ind:ste:23031601"/>
        </variable_test>
        <textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:23031602" version="1" check_existence="at_least_one_exists" check="all" comment="/etc/resolv.conf contains at least one nameserver entry">
          <object object_ref="oval:mil.disa.stig.ind:obj:23031602"/>
        </textfilecontent54_test>
        </tests><objects><variable_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:23031601" version="1" comment="count of unique name servers">
          <var_ref>oval:mil.disa.stig.ind:var:23031600</var_ref>
        </variable_object>
        <textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:23031602" version="2" comment="/etc/resolv.conf nameserver entries">
          <filepath>/etc/resolv.conf</filepath>
          <pattern operation="pattern match">^nameserver\s+(.*)$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        <textfilecontent54_object xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:obj:23031600" version="2" comment="/etc/nsswitch.conf hosts entry">
          <filepath>/etc/nsswitch.conf</filepath>
          <pattern operation="pattern match">^\s*hosts:\s*(.*)$</pattern>
          <instance datatype="int" operation="greater than or equal">1</instance>
        </textfilecontent54_object>
        </objects><states><textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:23031600" version="2" comment="hosts entry contains dns">
          <subexpression operation="pattern match">(^|\s)dns(\s|$)</subexpression>
        </textfilecontent54_state>
        <variable_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:23031601" version="2" comment="/etc/resolv.conf is configured with at least two name servers">
