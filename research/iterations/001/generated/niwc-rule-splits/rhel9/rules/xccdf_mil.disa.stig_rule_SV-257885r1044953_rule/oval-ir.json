            "text": "RHEL-09-232025 - RHEL 9 /var/log directory must have mode 0755 or less permissive."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
