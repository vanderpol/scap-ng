        </objects><states><textfilecontent54_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:ste:2303001" version="1">
          <subexpression operation="pattern match">(?:^nosuid$|^nosuid,|,nosuid$|,nosuid,)</subexpression>
        </textfilecontent54_state>
        <partition_state xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux" id="oval:mil.disa.stig.linux:ste:20000002" version="1">
