      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "Verify RHEL 9 is configured to audit the execution of any system call made by cron as root or by any privileged user.",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:navy.navwar.niwcatlantic.scc.rhel9os:tst:27993601"
          }
