            "text": "RHEL-09-232105 - RHEL 9 /etc/group- file must be group-owned by root."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
