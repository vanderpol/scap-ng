          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Successful/unsuccessful uses of the chmod, fchmod, and fchmodat system calls in the operating system must generate an audit record."
          },
