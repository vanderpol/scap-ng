            "text": "RHEL-09-411030 - RHEL 9 duplicate User IDs (UIDs) must not exist for interactive users."
          },
          {
            "attributes": {
              "family": "unix"
            },
            "children": [
              {
                "name": "platform",
                "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
