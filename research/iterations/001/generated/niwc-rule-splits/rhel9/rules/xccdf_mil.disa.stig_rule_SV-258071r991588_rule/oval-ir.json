          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "Increasing the time between a failed authentication attempt and reprompting to enter credentials helps to slow a single-threaded brute force attack."
          }
