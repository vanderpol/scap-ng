        </definition>
        </definitions><tests><textfilecontent54_test xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" id="oval:mil.disa.stig.ind:tst:25822700" version="1" check="all" comment="/etc/audit/audit.rules: -f 2 option is present">
