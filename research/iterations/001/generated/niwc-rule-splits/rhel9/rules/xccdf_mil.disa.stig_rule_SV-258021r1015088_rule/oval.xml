      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.linux:def:258021" version="13" class="compliance">
          <metadata>
            <title>RHEL 9 must enable a user session lock until that user re-establishes access using established identification and authentication procedures for graphical user sessions.</title>
            <description>A session lock is a temporary action taken when a user stops work and moves away from the immediate physical vicinity of the information system but does not want to log out because of the temporary nature of the absence.

The session lock is implemented at the point where session activity can be determined.

Regardless of where the session lock is determined and implemented, once invoked, the session lock must remain in place until the user reauthenticates. No other activity aside from reauthentication must unlock the system.</description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.linux:tst:25802101" comment="Verify the operating system enables a user's session lock until that user re-establishes access using established identification and authentication procedures."/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.linux:tst:25802101" check_existence="at_least_one_exists" check="all" version="13" comment="Verify the operating system enables a user's session lock until that user re-establishes access using established identification and authentication procedures.">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.linux:obj:25802101"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.linux:ste:25802101"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object version="13" id="oval:navy.navwar.niwcatlantic.scc.linux:obj:25802101" comment="Retrieve org.gnome.desktop.screensaver lock-enabled setting.">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>gsettings get org.gnome.desktop.screensaver lock-enabled</independent-def:command>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.linux:ste:25802101" version="13" comment="Check value of org.gnome.desktop.screensaver lock-enabled setting.">
