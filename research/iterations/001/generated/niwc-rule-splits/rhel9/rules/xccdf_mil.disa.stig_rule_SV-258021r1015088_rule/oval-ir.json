  "definitions": [
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "Verify the operating system enables a user's session lock until that user re-establishes access using established identification and authentication procedures.",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:navy.navwar.niwcatlantic.scc.linux:tst:25802101"
          }
        ],
