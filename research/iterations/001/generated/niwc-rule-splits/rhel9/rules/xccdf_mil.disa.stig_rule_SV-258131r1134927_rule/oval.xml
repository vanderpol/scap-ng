      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.linux:def:258131" version="13" class="compliance">
          <metadata>
            <title>RHEL 9, for PKI-based authentication, must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.</title>
            <description/>
          </metadata>
          <criteria operator="AND">
            <criterion comment="Verify a DOD Root CA is installed in the designated location" test_ref="oval:navy.navwar.niwcatlantic.scc.linux:tst:25813101"/>
            <criterion comment="Verify the Root CA is date/time valid" test_ref="oval:navy.navwar.niwcatlantic.scc.linux:tst:25813102"/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.linux:tst:25813102" check_existence="at_least_one_exists" check="all" version="13" comment="For PKI-based authentication, the OS must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.linux:obj:25813102"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.linux:ste:25813102"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.linux:tst:25813101" check_existence="at_least_one_exists" check="all" version="13" comment="For PKI-based authentication, the OS must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.linux:obj:25813101"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.linux:ste:25813101"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object version="13" id="oval:navy.navwar.niwcatlantic.scc.linux:obj:25813101" comment="Check that the system has a valid DOD root CA installed">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>openssl x509 -text -in /etc/sssd/pki/sssd_auth_ca_db.pem</independent-def:command>
          <independent-def:pattern operation="pattern match">Issuer:</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object version="13" id="oval:navy.navwar.niwcatlantic.scc.linux:obj:25813102" comment="Check that the root certicate is date/time valid">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>openssl x509 -in /etc/sssd/pki/sssd_auth_ca_db.pem -checkend 0</independent-def:command>
          <independent-def:pattern operation="pattern match">expire</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.linux:ste:25813102" version="13" comment="Verify that the root cert is date/time valid">
          <independent-def:exit_status datatype="int">0</independent-def:exit_status>
          <independent-def:stdout_line check_existence="at_least_one_exists" operation="pattern match">Certificate will not expire</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.linux:ste:25813101" version="13" comment="Verify that the Issuer is a DOD Root CA">
          <independent-def:exit_status datatype="int">0</independent-def:exit_status>
          <independent-def:stdout_line check_existence="at_least_one_exists" operation="pattern match">CN\s*=\s*DoD\s+Root\s+CA</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        </states></oval_definitions>
