  "definitions": [
    {
      "class": "compliance",
      "criteria": {
        "children": [
          {
            "comment": "Verify RHEL 9 is configured to ignore the Ctrl-Alt-Del sequence in the GNOME desktop.",
            "kind": "test_ref",
            "negate": false,
            "test_ref": "oval:navy.navwar.niwcatlantic.scc.rhel9os:tst:25803101"
          }
        ],
        "comment": null,
        "kind": "boolean",
        "negate": false,
        "operator": "AND"
      },
      "deprecated": null,
      "id": "oval:navy.navwar.niwcatlantic.scc.rhel9os:def:258031",
      "metadata": {
        "children": [
          {
            "name": "title",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "RHEL 9 must disable the ability of a user to accidentally press Ctrl-Alt-Del and cause a system to shut down or reboot."
          },
          {
            "name": "description",
            "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5",
            "text": "A locally logged-in user who presses Ctrl-Alt-Del, when at the console, can reboot the system. If accidentally pressed, as could happen in the case of mixed OS environment, this can create the risk of short-term loss of availability of systems due to unintentional reboot."
          }
        ],
        "name": "metadata",
        "namespace": "http://oval.mitre.org/XMLSchema/oval-definitions-5"
      },
      "version": "13"
    }
  ],
