        "type": "independent.textfilecontent54",
        "selectors": {
          "filepath": {
            "variable": "aide-config-path-variable",
            "var_check": "all"
          },
          "pattern": {
            "operation": "pattern match",
            "value": "^[ \\t]*database(?:_in)?[ \\t]*=[ \\t]*file:(/[^#\\s]+)[ \\t]*(?:#.*)?$"
          },
          "instance": {
            "datatype": "int",
            "operation": "greater than or equal",
            "value": "1"
          }
        }
      },
