            "value": "^[ \\t]*database(?:_in)?[ \\t]*=[ \\t]*file:@@\\{DBDIR\\}/([^#\\s]+)[ \\t]*(?:#.*)?$"
          },
          "instance": {
            "datatype": "int",
            "value": "1"
          }
        }
      },
      {
        "id": "aide-package-alt-collection",
        "type": "linux.rpminfo",
        "selectors": {
