      <unix:filepath var_ref="oval:navy.navwar.niwcatlantic.scc:var:28103700017" var_check="at least one"/>
    </unix:symlink_object>
    <unix:file_object xmlns:unix="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix" id="oval:navy.navwar.niwcatlantic.scc:obj:28103700008" version="1" comment="Collect the actual file attributes of symlink targets">
