    <definition id="oval:navy.navwar.niwcatlantic.scc:def:28103700001" version="1" class="compliance">
      <metadata>
        <title>RHEL 10 must be configured so that system commands are owned by "root".</title>
        <affected family="unix">
          <platform>Red Hat Enterprise Linux 10</platform>
        </affected>
        <reference source="DISA STIG" ref_id="SV-281037"/>
        <description>RHEL 10 check-text evaluation. Production comparison: RHEL-09-232190. Production file objects collect filenames, unlike the broken nil-filename RHEL 10 objects. The command source excludes links/directories; the library-owner source limits filenames to .so variants. Target find -L and non-directory scope are broader.</description>
      </metadata>
      <criteria operator="AND" comment="All listed conditions must be satisfied">
        <criteria operator="OR" comment="Either no links exist or every link target is resolved successfully">
          <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:28103700002" comment="The selected population contains no file symlinks"/>
          <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:28103700003" comment="Resolve selected symlinks"/>
        </criteria>
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:28103700004" comment="No selected entry violates user_id"/>
      </criteria>
    </definition>
  </definitions>
