      <unix:behaviors recurse_direction="down" max_depth="-1" recurse="symlinks and directories" recurse_file_system="all"/>
      <unix:path var_ref="oval:navy.navwar.niwcatlantic.scc:var:28103700016" var_check="at least one"/>
      <unix:filename operation="pattern match">^.*$</unix:filename>
      <filter action="exclude">oval:navy.navwar.niwcatlantic.scc:ste:28103700012</filter>
    </unix:file_object>
    <unix:file_object xmlns:unix="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix" id="oval:navy.navwar.niwcatlantic.scc:obj:28103700006" version="1" comment="Select symlinks for canonical-path resolution">
