    <unix:file_object xmlns:unix="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix" id="oval:navy.navwar.niwcatlantic.scc:obj:28103700010" version="1" comment="Union direct entries and resolved link targets for find -L semantics">
