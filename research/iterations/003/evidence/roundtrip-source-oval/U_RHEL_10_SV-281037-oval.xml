    </unix:symlink_test>
    <unix:file_test xmlns:unix="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix" id="oval:navy.navwar.niwcatlantic.scc:tst:28103700004" version="1" comment="No selected entry violates user_id" check_existence="none_exist" check="all">
