            <ns0:title>SRG-APP-000340-WSR-000029</ns0:title>
            <ns0:description>IIS 8.5 web server system files must conform to minimum file permission requirements.</ns0:description>
            <ns0:affected family="windows">
              <ns0:product>MS IIS 8.5 Server</ns0:product>
            </ns0:affected>
            <ns0:reference source="DISA" ref_id="V-214429" ref_url="http://iase.disa.mil" />
