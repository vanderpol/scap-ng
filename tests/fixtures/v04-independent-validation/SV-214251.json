      "tests": {
        "verify-that-sessioncookiename-directive-exists-and-is-configured-with-0d2f812f-test": {
          "test_title": "Verify that SessionCookieName directive exists and is configured with HttpOnly and Secure, and not Domain for all httpd.conf/apache2.conf and included conf files",
          "capability": "independent.shellcommand",
          "object": {
            "shell": "bash",
            "command": {
              "variable": "shell-command-to-check-sessioncookiename-in-httpd-conf-and-all-include-e23fd4db-variable"
            },
            "pattern": ".+",
            "error_if_exit_status_not_0": false,
            "error_if_stderr_exists": false
          },
          "require": {
            "items_found": "one_or_more",
            "items_satisfying": "every",
            "and": [
              {
                "fields": {
                  "stdout_line": {
                    "matches_regex": "(?i)HttpOnly",
                    "values_found": "one_or_more",
                    "values_matching": "every"
                  }
                }
              },
              {
                "fields": {
                  "stdout_line": {
                    "matches_regex": "(?i)Secure",
                    "values_found": "one_or_more",
                    "values_matching": "every"
                  }
                }
              },
              {
                "fields": {
                  "stdout_line": {
                    "matches_regex": "(?i)Domain",
                    "values_found": "may_be_absent",
                    "values_matching": "none"
                  }
                }
              }
            ]
          },
          "reported_elements": "all"
        },
        "if-the-sessioncookiename-exists-in-other-loaded-configurations-files-v-98469305-test": {
