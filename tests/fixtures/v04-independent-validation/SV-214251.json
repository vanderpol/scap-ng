  "native": {
    "assessment": {
      "id": "cookies-exchanged-between-the-apache-web-server-and-client-such-as-ses-848ecd9c-assessment",
      "version": 1,
      "assessment_title": "Cookies exchanged between the Apache web server and client, such as session cookies, must have security settings that disallow cookie access outside the originating Apache web server and hosted application.",
      "mode": "automated",
      "class": "compliance",
      "purpose": "assessment",
      "specification": {
        "id": "scap-ng.pre-alpha.assessment",
        "version": "0.4.0"
      },
      "shared_objects": {
        "gather-unique-apache-http-installation-paths-58db4617-object": {
          "capability": "independent.shellcommand",
          "shell": "bash",
          "command": "ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq",
          "pattern": "^\\/\\S+(\\/httpd|\\/apache2)\\s*",
          "error_if_exit_status_not_0": false,
          "error_if_stderr_exists": false,
          "object_title": "Gather unique apache http installation paths"
        }
      },
      "variables": {
        "apache-base-install-directories-unix-0d8ee599-variable": {
          "kind": "local",
          "datatype": "string",
          "expression": {
            "regex_capture": {
              "pattern": "(^\\/.+\\/)httpd|(^\\/.+/)apache2",
              "value": {
                "values": {
                  "object": "gather-unique-apache-http-installation-paths-58db4617-object",
                  "field": "stdout_line"
                }
              }
            }
          }
        },
        "httpd-root-to-apachectl-v-08e9578a-variable": {
          "kind": "local",
          "datatype": "string",
          "expression": {
            "concat": [
              {
                "variable": "apache-base-install-directories-unix-0d8ee599-variable"
              },
              {
                "literal": {
                  "datatype": "string",
                  "value": "apachectl -V | grep -i 'httpd_root'"
                }
              }
            ]
          }
        },
        "filepath-to-httpd-root-d5499f7d-variable": {
          "kind": "local",
          "datatype": "string",
          "expression": {
            "regex_capture": {
              "pattern": " -D HTTPD_ROOT=\"(.+)\"",
              "value": {
                "values": {
                  "object": {
                    "capability": "independent.shellcommand",
                    "shell": "bash",
                    "command": {
                      "variable": "httpd-root-to-apachectl-v-08e9578a-variable"
                    },
                    "pattern": "HTTPD_ROOT",
                    "error_if_exit_status_not_0": false,
                    "error_if_stderr_exists": false
                  },
                  "field": "stdout_line"
                }
              }
            }
          }
        },
