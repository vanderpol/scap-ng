      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.unix.apache:def:214251" version="2" class="compliance">
          <metadata>
            <title>Cookies exchanged between the Apache web server and client, such as session cookies, must have security settings that disallow cookie access outside the originating Apache web server and hosted application.</title>
            <description/>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21425101" comment="Verify that SessionCookieName directive exists and is configured with HttpOnly and Secure, and not Domain for all httpd.conf/apache2.conf and included conf files"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21425102" comment="If the SessionCookieName exists in other loaded configurations files, verify it is configured with HttpOnly and Secure, and not Domain"/>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21425103" comment="The Apache headers_module must be enabled"/>
          </criteria>
        </definition>
        </definitions><tests><independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21425101" version="2" comment="Verify that SessionCookieName directive exists and is configured with HttpOnly and Secure, and not Domain for all httpd.conf/apache2.conf and included conf files" state_operator="AND" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425101"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425101"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425111"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425112"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21425102" version="2" comment="If the SessionCookieName exists in other loaded configurations files, verify it is configured with HttpOnly and Secure, and not Domain" state_operator="AND" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425102"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425102"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425121"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425122"/>
        </independent-def:shellcommand_test>
        <independent-def:shellcommand_test id="oval:navy.navwar.niwcatlantic.scc.unix.apache:tst:21425103" version="2" comment="Apache headers_module must be enabled" check_existence="at_least_one_exists" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425103"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425103"/>
        </independent-def:shellcommand_test>
        </tests><objects><independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425101" version="2" comment="Gather all SessionCookieName data from httpd and all Include conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425109"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425102" version="2" comment="Gather all SessionCookieName data from all loaded conf files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425108"/>
          <independent-def:pattern>.+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425103" version="2" comment="Gather all installed modules and filter on headers_module">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425111"/>
          <independent-def:pattern>headers_module</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425110" version="2" comment="Gather unique apache http installation paths">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command>ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq</independent-def:command>
          <independent-def:pattern>^\/\S+(\/httpd|\/apache2)\s*</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425120" version="2" comment="Gather HTTPD_ROOT files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425102"/>
          <independent-def:pattern>HTTPD_ROOT</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425130" version="2" comment="Gather SERVER_CONFIG_FILE files via apachectl">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425103"/>
          <independent-def:pattern>SERVER_CONFIG_FILE</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425140" version="2" comment="Gather Include statements from httpd.conf">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425120"/>
          <independent-def:pattern>\S+</independent-def:pattern>
        </independent-def:shellcommand_object>
        <independent-def:shellcommand_object id="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425150" version="2" comment="Gather all loaded config files">
          <independent-def:shell>bash</independent-def:shell>
          <independent-def:command var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425150"/>
          <independent-def:pattern> \(</independent-def:pattern>
        </independent-def:shellcommand_object>
        </objects><states><independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425101" version="2" comment="SessionCookieName is configured with HttpOnly">
          <independent-def:stdout_line entity_check="all" operation="pattern match">(?i)HttpOnly</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425111" version="2" comment="SessionCookieName is configured with Secure">
          <independent-def:stdout_line entity_check="all" operation="pattern match">(?i)Secure</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425112" version="2" comment="SessionCookieName is not configured with Domain">
          <independent-def:stdout_line check_existence="any_exist" entity_check="none satisfy" operation="pattern match">(?i)Domain</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425102" version="2" comment="SessionCookieName is configured with HttpOnly (if found)">
          <independent-def:stdout_line check_existence="any_exist" entity_check="all" operation="pattern match">(?i)HttpOnly</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425121" version="2" comment="SessionCookieName is configured with Secure (if found)">
          <independent-def:stdout_line check_existence="any_exist" entity_check="all" operation="pattern match">(?i)Secure</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425122" version="2" comment="SessionCookieName is not configured with Domain (if found)">
          <independent-def:stdout_line check_existence="any_exist" entity_check="none satisfy" operation="pattern match">(?i)Domain</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        <independent-def:shellcommand_state id="oval:navy.navwar.niwcatlantic.scc.unix.apache:ste:21425103" version="2" comment="headers_module must be enabled">
          <independent-def:stdout_line entity_check="at least one" datatype="string" operation="pattern match">headers_module</independent-def:stdout_line>
        </independent-def:shellcommand_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425101" datatype="string" version="2" comment="Apache base install directories (unix)">
          <regex_capture pattern="(^\/.+\/)httpd|(^\/.+/)apache2">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425110" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425102" datatype="string" version="2" comment="httpd_root to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425101"/>
            <literal_component datatype="string">apachectl -V | grep -i 'httpd_root'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425103" datatype="string" version="2" comment="server_config_file to apachectl -V">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425101"/>
            <literal_component datatype="string">apachectl -V | grep -i 'server_config_file'</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425104" datatype="string" version="2" comment="Filepath to HTTPD_ROOT">
          <regex_capture pattern=" -D HTTPD_ROOT=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425120" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425105" datatype="string" version="2" comment="relative to SERVER_CONFIG_FILE">
          <regex_capture pattern=" -D SERVER_CONFIG_FILE=&quot;(.+)&quot;">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425130" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425106" datatype="string" version="2" comment="Filepath to http conf file">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425104"/>
            <literal_component datatype="string">/</literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425105"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425108" datatype="string" version="2" comment="shell command to check SessionCookieName in all loaded conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*SessionCookieName' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425152"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425109" datatype="string" version="2" comment="shell command to check SessionCookieName in httpd.conf and all Include conf files">
          <concat>
            <literal_component datatype="string">grep -iHn '^\s*SessionCookieName' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425143"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425110" datatype="string" version="2" comment="Apache path to httpd or apache2">
          <regex_capture pattern="(^\/.+\/httpd|^\/.+\/apache2) ">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425110" item_field="stdout_line"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425111" datatype="string" version="2" comment="command to gather httpd/apache2 modules">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425110"/>
            <literal_component datatype="string"> -M</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425120" datatype="string" version="2" comment="shell command to check for all Include and Include Optional files">
          <concat>
            <literal_component datatype="string">grep -iEHn '^\s*Include\s+|^\s*IncludeOptional\s+' </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425106"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425141" datatype="string" version="2" comment="All included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425104"/>
            <literal_component datatype="string">/</literal_component>
            <regex_capture pattern="\S+\s+(\S+)\s*">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425140" item_field="stdout_line"/>
            </regex_capture>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425142" datatype="string" version="2" comment="merged included conf files from Include refernces in httd.conf">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425141"/>
          </merge>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425143" datatype="string" version="2" comment="httpd.conf and merged included conf files from Include refernces in httd.conf">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425106"/>
            <literal_component> </literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425142"/>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425150" datatype="string" version="2" comment="command to gather httpd/apache2 list of all loaded configuration files">
          <concat>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425110"/>
            <literal_component datatype="string"> -t -D DUMP_INCLUDES</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425151" datatype="string" version="2" comment="All loaded configuration filepaths">
          <unique>
            <regex_capture pattern="\(.*\) (/.*)">
              <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:obj:21425150" item_field="stdout_line"/>
            </regex_capture>
          </unique>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425152" datatype="string" version="2" comment="Merged list of all loaded config files">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.unix.apache:var:21425151"/>
          </merge>
        </local_variable>
        </variables></oval_definitions>