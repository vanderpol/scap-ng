      "tests": {
        "verify-that-keepalive-directive-is-defined-and-configured-to-on-in-htt-b69326e5-test": {
          "test_title": "Verify that KeepAlive directive is defined, and configured to On in httpd.conf/apache2.conf or included conf files",
          "capability": "independent.shellcommand",
          "object": {
            "shell": "bash",
            "command": {
              "variable": "shell-command-to-check-keepalive-in-httpd-conf-and-all-include-conf-fi-cb468c9a-variable"
            },
            "pattern": ".+",
            "error_if_exit_status_not_0": false,
            "error_if_stderr_exists": false
          },
          "require": {
            "items_found": "one_or_more",
            "items_satisfying": "every",
            "fields": {
              "stdout_line": {
                "matches_regex": "\\s*KeepAlive On",
                "values_found": "one_or_more",
                "values_matching": "every"
              }
            }
          },
          "reported_elements": "all"
        },
        "if-the-keepalive-directive-is-defined-in-other-loaded-configuration-fi-bbba4ff4-test": {
          "test_title": "If the KeepAlive directive is defined in other loaded configuration files, verify it is configured to On",
          "capability": "independent.shellcommand",
          "object": {
            "shell": "bash",
            "command": {
              "variable": "shell-command-to-check-keepalive-in-all-loaded-conf-files-4cfc32d7-variable"
            },
            "pattern": ".+",
            "error_if_exit_status_not_0": false,
            "error_if_stderr_exists": false
          },
          "require": {
            "items_found": "one_or_more",
            "items_satisfying": "every",
            "fields": {
              "stdout_line": {
                "matches_regex": "\\s*KeepAlive On",
                "values_found": "may_be_absent",
                "values_matching": "every"
              }
            }
          },
          "reported_elements": "all"
        },
        "verify-that-maxkeepaliverequests-is-defined-and-is-configured-to-100-o-f3b27b7c-test": {
          "test_title": "Verify that MaxKeepAliveRequests is defined and is configured to 100 or greater httpd.conf/apache2.conf or included conf files",
          "capability": "independent.shellcommand",
          "object": {
            "shell": "bash",
