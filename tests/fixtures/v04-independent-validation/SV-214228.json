      "shared_objects": {
        "gather-unique-apache-http-installation-paths-dc840f2f-object": {
          "capability": "independent.shellcommand",
          "shell": "bash",
          "command": "ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq",
          "pattern": "^\\/\\S+(\\/httpd|\\/apache2)\\s*",
          "error_if_exit_status_not_0": false,
          "error_if_stderr_exists": false,
          "object_title": "Gather unique apache http installation paths"
        }
      },
      "variables": {
        "apache-base-install-directories-unix-f040395d-variable": {
          "kind": "local",
          "datatype": "string",
          "expression": {
            "regex_capture": {
              "pattern": "(^\\/.+\\/)httpd|(^\\/.+/)apache2",
              "value": {
                "values": {
                  "object": "gather-unique-apache-http-installation-paths-dc840f2f-object",
                  "field": "stdout_line"
                }
              }
            }
          }
        },
