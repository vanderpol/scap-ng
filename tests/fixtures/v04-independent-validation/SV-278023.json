  "native": {
    "assessment": {
      "id": "windows-server-2025-must-not-have-the-server-message-block-smb-v1-prot-0c61e3af-assessment",
      "version": 1,
      "assessment_title": "Windows Server 2025 must not have the Server Message Block (SMB) v1 protocol installed.",
      "mode": "automated",
      "class": "compliance",
      "purpose": "assessment",
      "specification": {
        "id": "scap-ng.pre-alpha.assessment",
        "version": "0.4.0"
      },
      "tests": {
        "smb-1-0-cifs-file-sharing-support-feature-is-not-installed-427e97eb-test": {
          "test_title": "'SMB 1.0/CIFS File Sharing Support' feature is not installed",
          "capability": "windows.wmi.query",
          "object": {
            "namespace": "root\\cimv2",
            "query": "SELECT installstate FROM win32_optionalfeature WHERE name = 'SMB1Protocol'"
          },
          "require": {
            "items_found": "one_or_more",
            "items_satisfying": "every",
            "fields": {
              "result": {
                "record": {
                  "records_found": "one_or_more",
                  "records_matching": "every",
                  "fields": {
                    "installstate": {
                      "equals": "2",
                      "values_found": "one_or_more",
                      "values_matching": "one_or_more"
                    }
                  }
                }
              }
            }
          },
          "reported_elements": "all"
        },
        "configure-smbv1-server-is-set-to-disabled-0d20b30b-test": {
          "test_title": "'Configure SMBv1 Server' is set to 'Disabled'",
          "capability": "windows.registry",
          "object": {
            "hive": {
              "equals": "local_machine"
            },
            "key": {
              "equals": "SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters"
            },
            "name": {
              "equals": "SMB1"
            }
          },
          "require": {
            "items_found": "one_or_more",
            "items_satisfying": "every",
            "and": [
              {
                "fields": {
                  "type": {
                    "equals": "dword",
                    "values_found": "one_or_more",
                    "values_matching": "every"
                  }
                }
              },
              {
                "fields": {
                  "value": {
                    "equals": 0,
                    "datatype": "integer",
                    "values_found": "one_or_more",
                    "values_matching": "every"
                  }
                }
              }
            ]
          },
          "reported_elements": "all"
        },
        "configure-smbv1-client-driver-is-set-to-enabled-with-disable-driver-re-57080af6-test": {
          "test_title": "'Configure SMBv1 client driver' is set to 'Enabled' with 'Disable driver (recommended)' selected for 'Configure MrxSmb10 driver'",
          "capability": "windows.registry",
          "object": {
            "hive": {
              "equals": "local_machine"
            },
            "key": {
              "equals": "SYSTEM\\CurrentControlSet\\Services\\mrxsmb10"
            },
            "name": {
              "equals": "Start"
            }
          },
          "require": {
            "items_found": "one_or_more",
            "items_satisfying": "every",
            "and": [
              {
                "fields": {
                  "type": {
                    "equals": "dword",
                    "values_found": "one_or_more",
                    "values_matching": "every"
                  }
                }
              },
              {
                "fields": {
                  "value": {
                    "equals": 4,
                    "datatype": "integer",
                    "values_found": "one_or_more",
                    "values_matching": "every"
                  }
                }
              }
            ]
          },
          "reported_elements": "all"
        }
      },
      "evaluate": {
        "or": [
          {
            "test": "smb-1-0-cifs-file-sharing-support-feature-is-not-installed-427e97eb-test"
          },
          {
            "and": [
              {
                "or": [
                  {
                    "test": "smb-1-0-cifs-file-sharing-support-feature-is-not-installed-427e97eb-test"
                  },
                  {
                    "test": "configure-smbv1-server-is-set-to-disabled-0d20b30b-test"
                  }
                ]
              },
              {
                "or": [
                  {
                    "test": "smb-1-0-cifs-file-sharing-support-feature-is-not-installed-427e97eb-test"
                  },
                  {
                    "test": "configure-smbv1-client-driver-is-set-to-enabled-with-disable-driver-re-57080af6-test"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
