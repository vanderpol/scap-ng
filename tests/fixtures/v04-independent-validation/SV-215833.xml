      <definitions><definition id="oval:navy.navwar.niwcatlantic.scc.iosxe:def:215833" version="18" class="compliance">
          <metadata>
            <title>The Cisco router must be configured to terminate all network connections associated with device management after five minutes of inactivity.</title>
            <affected family="ios">
              <platform>Cisco IOS-XE</platform>
            </affected>
            <description/>
          </metadata>
          <criteria operator="AND">
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:21583301" comment="Test to ensure that all exec-timeouts are 5 minutes or less"/>
            <criteria operator="OR">
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:21583310" comment="Test ip http timeout-policy idle less than or equal to 300 seconds"/>
              <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:21583320" comment="ip http secure server is disabled"/>
            </criteria>
          </criteria>
        </definition>
        </definitions><tests><independent-def:variable_test id="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:21583301" version="18" comment="All line and vty connections must have exec-timeout with a timeout less than or equal to 5" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583305"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:ste:21583301"/>
        </independent-def:variable_test>
        <independent-def:variable_test id="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:21583310" version="18" comment="Test ip http timeout-policy idle less than or equal to 300 seconds" check="all">
          <independent-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583310"/>
          <independent-def:state state_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:ste:21583310"/>
        </independent-def:variable_test>
        <iosxe-def:global_test check="at least one" comment="ip http secure server is disabled" id="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:21583320" version="18">
          <iosxe-def:object object_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583320"/>
        </iosxe-def:global_test>
        </tests><objects><iosxe-def:global_object id="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583302" version="18">
          <iosxe-def:global_command operation="pattern match">^line con \d+|^line vty \d+</iosxe-def:global_command>
        </iosxe-def:global_object>
        <iosxe-def:line_object id="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583303" version="18" comment="Show running-config">
          <iosxe-def:show_subcommand>show running-config</iosxe-def:show_subcommand>
        </iosxe-def:line_object>
        <independent-def:variable_object id="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583305" version="18" comment="Merged single delimited line of timeout values">
          <independent-def:var_ref>oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583305</independent-def:var_ref>
        </independent-def:variable_object>
        <iosxe-def:global_object id="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583311" version="18">
          <iosxe-def:global_command operation="pattern match">^ip http timeout-policy idle</iosxe-def:global_command>
        </iosxe-def:global_object>
        <independent-def:variable_object id="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583310" version="18" comment="Variable containing the numeric portion of the http timeout-policy">
          <independent-def:var_ref>oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583310</independent-def:var_ref>
        </independent-def:variable_object>
        <iosxe-def:global_object id="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583320" version="18">
          <iosxe-def:global_command operation="pattern match">^no ip http secure-server</iosxe-def:global_command>
        </iosxe-def:global_object>
        </objects><states><independent-def:variable_state id="oval:navy.navwar.niwcatlantic.scc.iosxe:ste:21583301" version="18" comment="Perform a pattern match against a merged single line of all exec-timeout lines verifying timeout is less than or equal to 5.  The number of timeouts must equal the number of line/vty ports found on the system.">
          <independent-def:value datatype="string" operation="pattern match" var_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583306"/>
        </independent-def:variable_state>
        <independent-def:variable_state id="oval:navy.navwar.niwcatlantic.scc.iosxe:ste:21583310" version="18" comment="http timeout must be less than or equal to 300">
          <independent-def:value datatype="int" operation="less than or equal">300</independent-def:value>
        </independent-def:variable_state>
        </states><variables><local_variable id="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583301" version="18" comment="Number of line and vty's on the system" datatype="int">
          <count>
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583302" item_field="global_command"/>
          </count>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583304" version="18" comment="Split the configuration into separate lines" datatype="int">
          <split delimiter="\n">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583303" item_field="config_line"/>
          </split>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583307" version="18" comment="Regex capture timeout lines" datatype="int">
          <regex_capture pattern="\s+exec-(.*)">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583304"/>
          </regex_capture>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583305" version="18" comment="Merge timeout lines into a single string" datatype="int">
          <merge delimiter=" " sort="document">
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583307"/>
          </merge>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583306" datatype="string" version="18" comment="Regex to match all exec-timeout lines">
          <concat>
            <literal_component datatype="string">(timeout (5|4|3|2|1) 0\s*){</literal_component>
            <variable_component var_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583301"/>
            <literal_component datatype="string">}</literal_component>
          </concat>
        </local_variable>
        <local_variable id="oval:navy.navwar.niwcatlantic.scc.iosxe:var:21583310" version="18" comment="Regex capture http timeout" datatype="int">
          <regex_capture pattern="ip http timeout-policy idle (\d+)">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:obj:21583311" item_field="global_command"/>
          </regex_capture>
        </local_variable>
        </variables></oval_definitions>