  <definitions>
    <definition id="oval:navy.navwar.niwcatlantic.scc.test:def:121" version="1" class="miscellaneous">
      <metadata>
        <title>Evaluate to true if the linux-def:rpminfo_test is properly supported</title>
        <description>This definition is intended to evaluate to true if the interpreter properly supports the linux-def:rpminfo_test.</description>
      </metadata>
      <notes>
        <note>It is important to note that the values used in this test definition are specific to a particular machine, and may not necessarily apply to your system. As a result, in order to have the definition return a result of 'true', you must either change these values to the ones found on your particular system, or you must configure your system to use these values.</note>
      </notes>
      <criteria operator="AND">
        <criterion comment="Test that the rpminfo_object is supported with the name entity equal to some value." test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:1" />
        <criterion comment="Test that the rpminfo_object is supported with the name entity not equal to some value." test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:2" />
        <criterion comment="Test that the rpminfo_object is supported with the name entity matching some value." test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:3" />
      </criteria>
    </definition>
  </definitions>
  <tests>
    <rpminfo_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:1" version="1" comment="Test that the rpminfo_object is supported with the name entity equal to some value." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:1" />
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:1" />
    </rpminfo_test>
    <rpminfo_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:2" version="1" comment="Test that the rpminfo_object is supported with the name entity equal to some value." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:2" />
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:2" />
    </rpminfo_test>
    <rpminfo_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:3" version="1" comment="Test that the rpminfo_object is supported with the name entity equal to some value." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:3" />
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:1" />
    </rpminfo_test>
  </tests>
  <objects>
    <rpminfo_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" version="1" comment="Retrieve an rpminfo_item with a name equal to 'gnome-session'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <name>gnome-session</name>
    </rpminfo_object>
    <rpminfo_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:2" version="1" comment="Retrieve an rpminfo_item with a name not equal to 'gnome-session'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <name operation="not equal">gnome-session</name>
      <oval-def:filter action="include">oval:navy.navwar.niwcatlantic.scc.test:ste:3</oval-def:filter>
    </rpminfo_object>
    <rpminfo_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:3" version="1" comment="Retrieve an rpminfo_item with a name matches to '^[Gg]nome.se[Ss]{2}ion$'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <name operation="pattern match">^[Gg]nome.se[Ss]{2}ion$</name>
    </rpminfo_object>
  </objects>
  <states>
    <rpminfo_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:1" version="1" comment="Confirm item name element contains 'gnome-session'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <name>gnome-session</name>
      <arch operation="pattern match">.+</arch>
      <epoch operation="pattern match">.+</epoch>
      <release operation="pattern match">.+</release>
    </rpminfo_state>
    <rpminfo_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:2" version="1" comment="Confirm item name element contains 'audit'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <name operation="pattern match">^[Aa]udit</name>
      <arch operation="pattern match">.+</arch>
      <epoch operation="pattern match">.+</epoch>
      <release operation="pattern match">.+</release>
    </rpminfo_state>
    <rpminfo_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:3" version="1" comment="Filter used to include only the 'audit' package(s)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <name operation="pattern match">^audit</name>
      <arch operation="pattern match">.+</arch>
      <epoch operation="pattern match">.+</epoch>
      <release operation="pattern match">.+</release>
    </rpminfo_state>
  </states>
