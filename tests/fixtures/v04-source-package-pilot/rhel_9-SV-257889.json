ilter>oval:mil.disa.stig.unix:ste:20000017</ns0:filter>\n            <ns0:filter>oval:mil.disa.stig.unix:ste:23032500</ns0:filter>\n          </ns0:set>\n        </ns1:password_object>\n        <ns1:password_object id=\"oval:mil.disa.stig.unix:obj:23032503\" version=\"1\" comment=\"only root users (uid=0) home-dirs excluding root directory\">\n          <ns0:set set_operator=\"COMPLEMENT\">\n            <ns0:object_reference>oval:mil.disa.stig.unix:obj:20000016</ns0:object_reference>\n            <ns0:filter>oval:mil.disa.stig.unix:ste:20000018</ns0:filter>\n            <ns0:filter>oval:mil.disa.stig.unix:ste:23032500</ns0:filter>\n          </ns0:set>\n        </ns1:password_object>\n        </ns0:objects><ns0:states><ns1:password_state id=\"oval:mil.disa.stig.unix:ste:20000017\" version=\"1\" comment=\"only uids &lt; 1000\">\n          <ns1:user_id entity_check=\"all\" datatype=\"int\" operation=\"less than\">1000</ns1:user_id>\n        </ns1:password_state>\n        <ns1:password_state id=\"oval:mil.disa.stig.unix:ste:20000018\" version=\"1\" comment=\"only uids &gt; 0\">\n          <ns1:user_id entity_check=\"all\" datatype=\"int\" operation=\"greater than\">0</ns1:user_id>\n        </ns1:password_state>\n        <ns1:file_state id=\"oval:mil.disa.stig.unix:ste:20000020\" version=\"2\" comment=\"mode 0740 or less permissive\">\n          <ns1:suid datatype=\"boolean\">false</ns1:suid>\n          <ns1:sgid datatype=\"boolean\">false</ns1:sgid>\n          <ns1:sticky datatype=\"boolean\">false</ns1:sticky>\n          <ns1:gwrite datatype=\"boolean\">false</ns1:gwrite>\n          <ns1:gexec datatype=\"boolean\">false</ns1:gexec>\n          <ns1:oread datatype=\"boolean\">false</ns1:oread>\n          <ns1:owrite datatype=\"boolean\">false</ns1:owrite>\n          <ns1:oexec datatype=\"boolean\">false</ns1:oexec>\n        </ns1:file_state>\n        <ns1:file_state id=\"oval:mil.disa.stig.unix:ste:20000021\" version=\"1\">\n          <ns1:type>directory</ns1:type>\n   