  <objects>
    <systemdunitproperty_object comment="Retrieve the LoadState of unit 'home.mount'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit>systemd-journald.service</unit>
      <property>LoadState</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the UnitFileState of unit 'home.mount'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:2" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="not equal">home.mount</unit>
      <property>UnitFileState</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the UnitFileState of unit 'home.mount' with operation of 'pattern match'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:3" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="pattern match">^systemd-journald\.service$</unit>
      <property>UnitFileState</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the UnitFileState with operation of 'pattern match' for unit 'home.mount'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:4" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit>systemd-journald.service</unit>
      <property operation="pattern match">Unit[Ff]ile[Ss]tate</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the Activestate of unit 'reboot.target'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:5" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit>reboot.target</unit>
      <property operation="pattern match">Names</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the Activestate of unit 'ctrl-alt-del.target'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:6" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit>ctrl-alt-del.target</unit>
      <property>Names</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the Activestate of unit 'boot.mount'." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:7" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit>boot.mount</unit>
      <property>Names</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the Activestate of unit template instance." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:8" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="pattern match">blockdev@\.target</unit>
      <property>Names</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the Activestate of unit template instance." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:9" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="pattern match">modprobe@\.service</unit>
      <property operation="pattern match">.*</property>
    </systemdunitproperty_object>
    <systemdunitproperty_object comment="Retrieve the Activestate of unit template that has no instances." version="1" id="oval:navy.navwar.niwcatlantic.scc.test:obj:10" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="pattern match">autovt@\.service</unit>
      <property>Names</property>
    </systemdunitproperty_object>
  </objects>
  <states>
    <systemdunitproperty_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:1" comment="Confirm a reasonable value (loaded or not-found) is reported." version="1" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <value operation="pattern match">(loaded|not-found)</value>
    </systemdunitproperty_state>
    <systemdunitproperty_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:2" comment="Confirm unit 'home.mount' is not included in object results." version="1" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="not equal">home.mount</unit>
    </systemdunitproperty_state>
    <systemdunitproperty_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:3" comment="Confirm unit 'home.mount' is included in object results." version="1" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
      <unit operation="equals">systemd-journald.service</unit>
      <property>UnitFileState</property>
      <value operation="pattern match">static|enabled|disabled|indirect|generated</value>
    </systemdunitproperty_state>
  </states>
