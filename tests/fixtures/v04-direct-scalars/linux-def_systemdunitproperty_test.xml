  <definitions>
    <definition class="compliance" version="1" id="oval:navy.navwar.niwcatlantic.scc.test:def:1">
      <metadata>
        <title>Evaluate to true if the linux-def_systemunitproperty_test is properly supported.</title>
        <description></description>
      </metadata>
      <criteria operator="AND">
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:1" comment="Test that systemdunitproperty test is supported with unit operation of 'equals' and property operation of 'equals'." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:2" comment="Test that systemdunitproperty test is supported with unit operation of 'not equals' and property operation of 'equals'." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:3" comment="Test that systemdunitproperty test is supported with unit operation of 'pattern match' and property operation of 'equals'." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:4" comment="Test that systemdunitproperty test is supported with unit operation of 'equals' and property operation of 'pattern match'." />
        <!-- Some of these are functionally redundant but target different types of Units (e.g. unit templates) and units that were missed due to previous SCC bugs. -->
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:5" comment="Test that systemdunitproperty test is supported with unit operation of 'equals' and property operation of 'equals'." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:6" comment="Test that systemdunitproperty test is supported with unit operation of 'equals' and property operation of 'equals'." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:7" comment="Test that systemdunitproperty test is supported with unit operation of 'equals' and property operation of 'equals'." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:8" comment="Test that systemdunitproperty test retrieves units that are based on templates." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:9" comment="Test that systemdunitproperty test retrieves units that are based on templates and has active instance." />
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:10" comment="Test that systemdunitproperty test retrieves units that are based on templates and has no instances." />

      </criteria>
    </definition>
  </definitions>
