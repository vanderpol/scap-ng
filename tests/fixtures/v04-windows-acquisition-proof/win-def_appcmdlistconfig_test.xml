    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:8" version="1" comment="Not Collected Example - AppCmd.exe reports not collected due to incorrect section setting." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>VDir</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <section>system.weNOEXISTbServer/serverSideInclude</section>
      <parameter>ssiExecDisable</parameter>
      <!-- The incorrect section entry will result in no item to be created-->
    </appcmdlistconfig_object>
