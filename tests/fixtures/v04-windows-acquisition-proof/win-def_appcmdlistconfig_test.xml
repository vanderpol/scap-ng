  <objects>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" version="1" comment="Website Setting Example - All Websites Reviewed." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command used
        for each website that exists on system this appcmd is executed
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:2" version="1" comment="Website Setting Example - Subset Of Websites Reviewed via regular expression (set in identifier)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="pattern match">default</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command used
        for each site that's name matches "default" via regular expression compare on system this appcmd is executed
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:3" version="1" comment="Website Setting Example - Subset Of Websites Reviewed via equal to (set in identifier) 'Default Web Site' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="equals">Default Web Site</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command attempting to review site named "Default Web Site"
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:103" version="1" comment="Website Setting Example - Subset Of Websites Reviewed via case insensitive equal to (set in identifier) 'Default Web Site' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="case insensitive equals">default web site</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command attempting to review an site named Default Web Site
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:4" version="1" comment="Website Setting Example - Subset Of Website Reviewed via not equal to (set in identifier) 'Default Web Site' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="not equal">Default Web Site</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command to review site name is not "Default Web Site"
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:104" version="1" comment="Website Setting Example - Subset Of Website Reviewed via case insensitive not equal to (set in identifier) 'Default Web Site' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="case insensitive not equal">default web site</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command to review site name is not "Default Web Site"
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:5" version="1" comment="VDir Setting Example - All Virtual Directories Reviewed" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>VDir</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <section>system.webServer/serverSideInclude</section>
      <parameter>ssiExecDisable</parameter>
      <!-- AppCmd.exe command used
        for each VDir that exists on system this appcmd is executed
        > C:\Windows\System32\inetsrv\appcmd.exe list config "<VDirName>" /section:system.webServer/serverSideInclude /text:ssiExecDisable
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:6" version="1" comment="VDir Setting Example - Subset Of VDir's Reviewed via regular expression (set in identifier)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>VDir</identifier_type>
      <identifier operation="pattern match">default</identifier>
      <section>system.webServer/serverSideInclude</section>
      <parameter>ssiExecDisable</parameter>
      <!-- AppCmd.exe command used
        for each VDir which name matches "default" via regular expression
        > C:\Windows\System32\inetsrv\appcmd.exe list config "<VDirName>" /section:system.webServer/serverSideInclude /text:ssiExecDisable
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:7" version="1" comment="Webserver Setting  Example" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Webserver</identifier_type>
      <identifier xsi:nil="true"/>
      <section>system.webServer/security/ipSecurity</section>
      <parameter>allowUnlisted</parameter>
      <!-- AppCmd.exe command used will be as follows (webserever settings on have one command)
          Note identifer not needed if identifier_type is Webserver
        > C:\Windows\System32\inetsrv\appcmd.exe list config /section:system.webServer/security/ipSecurity /text:allowUnlisted
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:301" version="1" comment="Variable Test identifier_type - Subset Of Websites Reviewed via equal to (set in identifier) 'Default Web Site' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type var_ref="oval:navy.navwar.niwcatlantic.scc.test:var:301"/>
      <identifier operation="equals">Default Web Site</identifier>
      <section>system.webServer/security/authentication/anonymousAuthentication</section>
      <parameter>logonMethod</parameter>
      <!-- AppCmd.exe command used
        one command run attempting to review an site named "default" if it exists on the system... if not an error is reported
        > .\appcmd.exe list config "<sitename>" /section:system.webServer/security/authentication/anonymousAuthentication /text:logonMethod
      -->
    </appcmdlistconfig_object>
    <appcmdlistconfig_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:302" version="1" comment="Variable Test identifier - Subset Of Websites Reviewed via equal to (set in identifier) 'Default Web Site' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
