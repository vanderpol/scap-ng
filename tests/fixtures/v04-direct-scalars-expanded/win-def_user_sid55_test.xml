  <objects>
    <user_sid55_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:1" version="2" comment="This object represents a user_sid55_object where the user_sid matches the regular expression '^S-1-5-21-[-0-9]+-500$' or the administrator account." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <user_sid operation="pattern match">^S-1-5-21-[-0-9]+-500$</user_sid>
