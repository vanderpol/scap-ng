    <user_sid55_object id="oval:navy.navwar.niwcatlantic.scc.windows:obj:2" version="1" comment="This object represents a user_sid55_object where the user_sid matches the regular expression '-501$'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
