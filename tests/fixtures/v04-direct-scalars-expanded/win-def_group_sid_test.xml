    <group_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:2" version="1" comment="Retrieves a group_sid_object that has a SID that matches the regular expression 'S-1-5-32-54[0-9]'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <group_sid operation="pattern match">S-1-5-32-54[0-9]</group_sid>
    </group_sid_object>
    <group_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:3" version="1" comment="Retrieves a group_sid_object that has a SID not equal to 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
