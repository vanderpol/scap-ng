{
  "assessment": {
    "id": "windows-server-2025-active-directory-sysvol-directory-must-have-the-pr-1ec1fc0c-assessment",
    "version": 1,
    "assessment_title": "Windows Server 2025 Active Directory SYSVOL directory must have the proper access control permissions.",
    "mode": "automated",
    "class": "compliance",
    "purpose": "assessment",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "variables": {
      "icacls-and-path-to-sysvol-directory-62cfc32f-variable": {
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "literal": {
                "datatype": "string",
                "value": "icacls "
              }
            },
            {
              "regex_capture": {
                "pattern": "(^[a-zA-Z]:\\\\.+)\\\\sysvol",
                "value": {
                  "values": {
                    "object": {
                      "capability": "windows.registry",
                      "hive": {
                        "equals": "local_machine"
                      },
                      "key": {
                        "equals": "SYSTEM\\CurrentControlSet\\Services\\Netlogon\\Parameters"
                      },
                      "name": {
                        "equals": "SysVol"
                      }
                    },
                    "field": "value"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "tests": {
      "permissions-must-conform-to-minimum-requirements-e0bf9bc8-test": {
        "test_title": "Permissions must conform to minimum requirements.",
        "capability": "independent.shellcommand",
        "object": {
          "shell": "cmd",
          "command": {
            "variable": "icacls-and-path-to-sysvol-directory-62cfc32f-variable"
          },
          "pattern": ":",
          "error_if_exit_status_not_0": false,
          "error_if_stderr_exists": false
        },
        "require": {
          "items_found": "one_or_more",
          "items_satisfying": "every",
          "and": [
            {
              "fields": {
                "exit_status": {
                  "equals": 0,
                  "datatype": "integer",
                  "values_found": "one_or_more",
                  "values_matching": "every"
                }
              }
            },
            {
              "fields": {
                "stdout_line": {
                  "matches_regex": [
                    "(?i)NT AUTHORITY\\\\Authenticated Users:\\(RX\\)",
                    "(?i)NT AUTHORITY\\\\Authenticated Users:\\(OI\\)\\(CI\\)\\(IO\\)\\(GR,GE\\)",
                    "(?i)BUILTIN\\\\Server Operators:\\(RX\\)",
                    "(?i)BUILTIN\\\\Server Operators:\\(OI\\)\\(CI\\)\\(IO\\)\\(GR,GE\\)",
                    "(?i)BUILTIN\\\\Administrators:\\(M,WDAC,WO\\)",
                    "(?i)BUILTIN\\\\Administrators:\\(OI\\)\\(CI\\)\\(IO\\)\\(F\\)",
                    "(?i)NT AUTHORITY\\\\SYSTEM:\\(F\\)",
                    "(?i)NT AUTHORITY\\\\SYSTEM:\\(OI\\)\\(CI\\)\\(IO\\)\\(F\\)",
                    "(?i)CREATOR OWNER:\\(OI\\)\\(CI\\)\\(IO\\)\\(F\\)"
                  ],
                  "datatype": "string",
                  "value_match": "one_or_more",
                  "values_found": "one_or_more",
                  "values_matching": "every"
                }
              }
            },
            {
              "fields": {
                "stderr_line": {
                  "values_found": "none"
                }
              }
            }
          ]
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "permissions-must-conform-to-minimum-requirements-e0bf9bc8-test"
    }
  }
}
