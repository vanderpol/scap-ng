{
  "assessment": {
    "id": "amazon-linux-2023-must-check-the-gpg-signature-of-locally-installed-so-37611ce7-assessment",
    "version": 1,
    "assessment_title": "Amazon Linux 2023 must check the GPG signature of locally installed software packages before installation.",
    "mode": "automated",
    "class": "compliance",
    "purpose": "assessment",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "tests": {
      "etc-dnf-dnf-conf-localpkg-gpgcheck-is-set-to-true-1-or-yes-d150f049-test": {
        "test_title": "/etc/dnf/dnf.conf: localpkg_gpgcheck is set to True, 1, or yes.",
        "capability": "independent.textfilecontent54",
        "object": {
          "full_path": {
            "equals": "/etc/dnf/dnf.conf"
          },
          "pattern": {
            "matches_regex": "^\\s*localpkg_gpgcheck\\s*=\\s*(\\w+)\\b\\s*$"
          },
          "instance": {
            "greater_than_or_equal": 1,
            "datatype": "integer"
          },
          "ignore_case": false,
          "multiline": true,
          "singleline": false,
          "item_creation": "all_object_elements_fullfilled",
          "filesystem": "all"
        },
        "require": {
          "items_found": "one_or_more",
          "items_satisfying": "every",
          "fields": {
            "subexpression": {
              "matches_regex": "^(True|1|yes)$",
              "values_found": "one_or_more",
              "values_matching": "every"
            }
          }
        },
        "reported_elements": "all"
      }
    },
    "evaluate": {
      "test": "etc-dnf-dnf-conf-localpkg-gpgcheck-is-set-to-true-1-or-yes-d150f049-test"
    }
  }
}
