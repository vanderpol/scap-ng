  <definitions>
    <definition id="oval:navy.navwar.niwcatlantic.scc.windows.test:def:1" version="1" class="miscellaneous">
      <metadata>
        <title>Evaluate to true if the win-def:sid_test is properly supported.</title>
        <description>This definition is intended to evaluate to true if the interpreter properly supports the win-def:sid_test.</description>
      </metadata>
      <notes>
        <note>It is important to note that the following test assumes the test system's local administrator account has not been renamed</note>
        <note>Information regarding the groups and users on your particular machine can be found by navigating to Start -> Run... and by typing 'mmc' and adding the Local Users and Groups Snap-in by navigating to File -> Add/Remove Snap-in -> Add -> Local Users and Groups.</note>
      </notes>
      <criteria>
        <criterion comment="Test that a sid_object with a trustee_name of a Group is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:1"/>
        <criterion comment="Test that a sid_object with a trustee_name pattern match is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:2"/>
        <!--tst 3, 13, 4, and 5 can be Disabled due to DoS on large domain controllers-->
        <criterion comment="Test that a sid_object with not equals is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:3"/>
        <criterion comment="Test that a sid_object with case insensitive not equals is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:13"/>
        <criterion comment="Test that the include_group behavior is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:4"/>
        <criterion comment="Test that the resolve_group behavior is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:5"/>
      </criteria>
    </definition>
  </definitions>
  <tests>
    <sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:1" version="1" comment="Test that a sid_object with a trustee_name is supported." check_existence="at_least_one_exists" check="only one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:1"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:1"/>
    </sid_test>
    <sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:2" version="1" comment="Test that a sid_object with a trustee_name pattern match is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:2"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:2"/>
    </sid_test>
    <sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:3" version="1" comment="Test that a sid_object with not equals is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:3"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:3"/>
    </sid_test>
    <sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:13" version="1" comment="Test that a sid_object with case insensitive not equals is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:13"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:3"/>
    </sid_test>
    <sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:4" version="1" comment="Test that the include_group behavior is supported." check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:4"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:4"/>
    </sid_test>
    <sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:5" version="1" comment="Test that the resolve_group behavior is supported." check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:5"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:5"/>
    </sid_test>
  </tests>
  <objects>
    <sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:1" version="1" comment="Retrieves a sid_object where the trustee_name equals the 'Authenticated Users'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name>Authenticated Users</trustee_name>
    </sid_object>
    <sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:2" version="1" comment="Retrieves a sid_object where the trustee_name matches the regular expression 'Admin.*'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="pattern match">Admin.*</trustee_name>
    </sid_object>
    <sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:3" version="1" comment="Retrieves a sid_object where the trustee_name does not equal 'ADMINISTRATOR'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="not equal">ADMINISTRATOR</trustee_name>
    </sid_object>
    <sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:13" version="1" comment="Retrieves a sid_object where the trustee_name does case insensitve not equal 'ADMINISTRATOR'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="case insensitive not equal">administrator</trustee_name>
    </sid_object>
    <sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:4" version="1" comment="Retrieves a sid_object where the trustee_name equals 'Guests', resolve_group = true, and include_group = true." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <behaviors resolve_group="true" include_group="true"/>
      <trustee_name>Guests</trustee_name>
    </sid_object>
    <sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:5" version="1" comment="Retrieves a sid_object where the trustee_name equals 'Guests', and resolve_group = true." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <behaviors resolve_group="true"/>
      <trustee_name>Guests</trustee_name>
    </sid_object>
  </objects>
  <states>
    <sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:1" version="1" comment="This state represents a sid_object where the trustee_name equals 'Authenticated Users'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name>Authenticated Users</trustee_name>
      <trustee_sid>S-1-5-11</trustee_sid>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_state>
    <sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:2" version="1" comment="This state represents a sid_object where the trustee_name matches the regular expression 'Admin.*'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="pattern match">Admin.*</trustee_name>
      <trustee_sid operation="pattern match">.+</trustee_sid>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_state>
    <sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:3" version="1" comment="This state represents a sid_object where the trustee_name is not equal to 'ADMINISTRATOR'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="not equal">ADMINISTRATOR</trustee_name>
    </sid_state>
    <sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:4" version="1" comment="This state represents a sid_object where the trustee_name matches the regular expression '.*Guest', resolve_group = true, and include_group = true." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="pattern match">.*Guest</trustee_name>
    </sid_state>
    <sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:5" version="1" comment="This state represents a sid_object where the trustee_name matches the regular expression '.*Guest', and resolve_group = true." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_name operation="pattern match">.*Guest</trustee_name>
    </sid_state>
  </states>
</oval_definitions>
