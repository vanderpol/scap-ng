  <definitions>
    <definition id="oval:navy.navwar.niwcatlantic.scc.windows.test:def:1" version="1" class="miscellaneous">
      <metadata>
        <title>Evaluate to true if the win-def:sid_sid_test is properly supported</title>
        <description>This definition is intended to evaluate to true if the interpreter properly supports the win-def:sid_sid_test.</description>
      </metadata>
      <notes>
        <note>It is important to note that the values used in this test definition are specific to a particular machine, and may not necessarily apply to your system. As a result, in order to have the definition return a result of 'true', you must either change these values to the ones found on your particular system, or you must configure your system to use these values.</note>
      </notes>
      <criteria operator="AND">
        <criterion comment="Test that a sid_sid_object with a trustee_sid equals is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:1"/>
        <criterion comment="Test that a sid_sid_object with a trustee_sid pattern match is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:2"/> 
       <!-- tests 3, 13 and 4 Disabling due to potential DoS on large domain controllers -->
       <criterion comment="Test that a sid_sid_object with a trustee_sid not equal is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:3"/>
       <criterion comment="Test that a sid_sid_object with a trustee_sid not equal is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:13"/> 
       <criterion comment="Test a sid_sid object with operation 'equals' that the resolve_group behavior = true is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:4"/>
       <criterion comment="Test a sid_sid object with operation 'equals' that the resolve_group behavior = false is supported." test_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:5"/>
      </criteria>
    </definition>
  </definitions>
  <tests>
    <sid_sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:1" version="1" comment="Test that a sid_sid_object with a trustee_sid is supported." check_existence="at_least_one_exists" check="only one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:1"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:1"/>
    </sid_sid_test>
    <sid_sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:2" version="1" comment="Test that a sid_sid_object with a trustee_sid pattern match is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:2"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:2"/>
    </sid_sid_test>
    <sid_sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:3" version="1" comment="Test that a sid_sid_object with a trustee_sid not equals is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:3"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:3"/>
    </sid_sid_test>
    <sid_sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:13" version="1" comment="Test that a sid_sid_object with a trustee_sid case insensitive not equal is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:13"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:3"/>
    </sid_sid_test>
    <sid_sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:4" version="1" comment="Test that the include_group behavior (disabled)  is supported." check_existence="at_least_one_exists" check="all" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:4"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:4"/>
    </sid_sid_test>
    <sid_sid_test id="oval:navy.navwar.niwcatlantic.scc.windows.test:tst:5" version="1" comment="Test that the resolve_group (disabled)  behavior is supported." check_existence="at_least_one_exists" check="only one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:5"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:5"/>
    </sid_sid_test>
  </tests>
  <objects>
    <sid_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:1" version="1" comment="Retrieves a sid_sid_object with trustee_sid that equals 'S-1-5-32-544' (the Administrators group)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid>S-1-5-32-544</trustee_sid>
    </sid_sid_object>
    <sid_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:2" version="1" comment="Retrieves a sid_sid_object with trustee_sid that matches the regular expression '-501$'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid operation="pattern match">-501$</trustee_sid>
    </sid_sid_object>
    <sid_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:3" version="1" comment="Retrieves a sid_sid_object with trustee_sid that is not equal to 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid operation="not equal">S-1-5-32-544</trustee_sid>
    </sid_sid_object>
    <sid_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:13" version="1" comment="Retrieves a sid_sid_object with trustee_sid that is case insensitive not equal to 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid operation="case insensitive not equal">s-1-5-32-544</trustee_sid>
    </sid_sid_object>
    <sid_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:4" version="1" comment="Retrieves a sid_sid_object with trustee_sid equals 'S-1-5-32-544' and with include_group behavior set to false and resolve_group behavior set to true." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <behaviors resolve_group="true" include_group="false"/>
      <trustee_sid>S-1-5-32-544</trustee_sid>
    </sid_sid_object>
    <sid_sid_object id="oval:navy.navwar.niwcatlantic.scc.windows.test:obj:5" version="1" comment="Retrieves a sid_sid_object with trustee_sid equals 'S-1-5-32-544' and with resolve_group behavior set to false (should not return members of group) and include group set to true." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <behaviors resolve_group="false" include_group="true"/>
      <trustee_sid>S-1-5-32-544</trustee_sid>
    </sid_sid_object>
  </objects>
  <states>
    <sid_sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:1" version="1" comment="This represents a sid_sid_state which has a trustee_sid that equals 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid>S-1-5-32-544</trustee_sid>
      <trustee_name>Administrators</trustee_name>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_sid_state>
    <sid_sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:2" version="1" comment="This represents a sid_sid_state which matches the regular expression '^.*." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid operation="pattern match">^.*</trustee_sid>
      <trustee_name operation="pattern match">.+</trustee_name>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_sid_state>
    <sid_sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:3" version="1" comment="This represents a sid_sid_state which has a trustee_sid that is not equal to 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid operation="not equal">S-1-5-32-544</trustee_sid>
      <trustee_name operation="pattern match">.+</trustee_name>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_sid_state>
    <sid_sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:4" version="1" comment="This represents a sid_sid_state which has a trustee_sid that is not equal to 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid operation="not equal">S-1-5-32-544</trustee_sid>
      <trustee_name operation="pattern match">.+</trustee_name>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_sid_state>
    <sid_sid_state id="oval:navy.navwar.niwcatlantic.scc.windows.test:ste:5" version="1" comment="This represents a sid_sid_state which has a trustee_sid that equals 'S-1-5-32-544'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <trustee_sid>S-1-5-32-544</trustee_sid>
      <trustee_name operation="pattern match">.+</trustee_name>
      <trustee_domain operation="pattern match">.+</trustee_domain>
    </sid_sid_state>
  </states>
</oval_definitions>
