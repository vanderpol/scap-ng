l_component>\n            <ns0:regex_capture pattern=\"(^[a-zA-Z]:\\\\.+)\\\\sysvol\">\n              <ns0:object_component object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:27813902\" item_field=\"value\" />\n            </ns0:regex_capture>\n          </ns0:concat>\n        </ns0:local_variable>\n        </ns0:variables></ns0:oval_definitions>",
