  "source_xml": "<ns0:oval_definitions xmlns:ns0=\"http://oval.mitre.org/XMLSchema/oval-definitions-5\" xmlns:ns1=\"http://oval.mitre.org/XMLSchema/oval-definitions-5#independent\" xmlns:ns2=\"http://oval.mitre.org/XMLSchema/oval-definitions-5#windows\"><ns0:definitions><ns0:definition id=\"oval:navy.navwar.niwcatlantic.scc.windows:def:278139\" version=\"1\" class=\"compliance\">\n          <ns0:metadata>\n            <ns0:title>Windows Server 2025 Active Directory SYSVOL directory must have the proper access control permissions.</ns0:title>\n            <ns0:description>Windows Server Active Directory SYSVOL directory must have the proper access control permissions.</ns0:description>\n          </ns0:metadata>\n          <ns0:criteria>\n            <ns0:criterion comment=\"Permissions must conform to minimum requirements for SYSVOL directory.\" test_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:tst:27813901\" />\n          </ns0:criteria>\n        </ns0:definition>\n        </ns0:definitions><ns0:tests><ns1:shellcommand_test id=\"oval:navy.navwar.niwcatlantic.scc.windows:tst:27813901\" version=\"1\" comment=\"Permissions must conform to minimum requirements.\" check_existence=\"at_least_one_exists\" check=\"all\">\n          <ns1:object object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:27813901\" />\n          <ns1:state state_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:ste:27813901\" />\n        </ns1:shellcommand_test>\n        </ns0:tests><ns0:objects><ns1:shellcommand_object id=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:27813901\" version=\"1\" comment=\"Run Icacls command against SYSVOL Directory\">\n          <ns1:shell>cmd</ns1:shell>\n          <ns1:command var_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:var:27813902\" />\n          <ns1:pattern>:</ns1:pattern>\n        </ns1:shellcommand_object>\n        <ns2:registry_object id=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:27813902\" version=\"1\" comment=\"Filepath to SysVol\">\n