ommand>\n          <ns1:pattern>^description</ns1:pattern>\n          <ns1:exit_status datatype=\"int\">0</ns1:exit_status>\n          <ns1:stdout_line operation=\"pattern match\">^description(\\s*)Windows (11|Boot Manager)$</ns1:stdout_line>\n        </ns1:shellcommand_state>\n        </ns0:states></ns0:oval_definitions>",
