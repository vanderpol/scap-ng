{
  "source_xml": "<ns0:oval_definitions xmlns:ns0=\"http://oval.mitre.org/XMLSchema/oval-definitions-5\" xmlns:ns1=\"http://oval.mitre.org/XMLSchema/oval-definitions-5#windows\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"><ns0:definitions><ns0:definition id=\"oval:mil.disa.stig.defs:def:253401\" version=\"3\" class=\"compliance\">\n          <ns0:metadata>\n            <ns0:title>Windows must be configured to require a minimum pin length of six characters or greater.</ns0:title>\n            <ns0:description />\n          </ns0:metadata>\n          <ns0:criteria>\n            <ns0:criterion test_ref=\"oval:mil.disa.stig.win:tst:25340100\" comment=\"Minimum PIN length is 6 or greater\" />\n          </ns0:criteria>\n        </ns0:definition>\n        <ns0:definition id=\"oval:mil.disa.stig.windows11:def:253401\" version=\"3\" class=\"compliance\">\n          <ns0:metadata>\n            <ns0:title>WN11-CC-000260 - Windows 11 must be configured to require a minimum PIN length of six characters or greater</ns0:title>\n            <ns0:affected family=\"windows\">\n              <ns0:platform>Microsoft Windows 11</ns0:platform>\n            </ns0:affected>\n            <ns0:description>Windows allows the use of PINs and biometrics for authentication without sending a password to a network or website where it could be compromised. Longer minimum PIN lengths increase the available combinations an attacker would have to attempt. Shorter minimum length significantly reduces the strength.\n\nNote: A different registry location is needed when systems are managed by Intune versus GPO.</ns0:description>\n          </ns0:metadata>\n          <ns0:criteria>\n            <ns0:extend_definition definition_ref=\"oval:mil.disa.stig.defs:def:253401\" />\n          </ns0:criteria>\n        </ns0:definition>\n        </ns0:definitions><ns0:tests><ns1:registry_test id=\"oval:mil.disa.stig.win:tst:25340100\" version=\"3\" check=\"all\" comment=\"Minimum PIN length is 6 or greater\">\n          <ns1:object object_ref=\"oval:mil.disa.stig.win:obj:25340100\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:25340100\" />\n        </ns1:registry_test>\n        </ns0:tests><ns0:objects><ns1:registry_object id=\"oval:mil.disa.stig.win:obj:25340100\" version=\"2\" comment=\"Registry entries for MinimumPINLength\">\n          <ns0:set set_operator=\"UNION\">\n            <ns0:object_reference>oval:mil.disa.stig.win:obj:25340101</ns0:object_reference>\n            <ns0:object_reference>oval:mil.disa.stig.win:obj:25340102</ns0:object_reference>\n          </ns0:set>\n        </ns1:registry_object>\n        <ns1:registry_object id=\"oval:mil.disa.stig.win:obj:25340101\" version=\"1\" comment=\"Group Policy registry entry for MinimumPINLength\">\n          <ns1:hive datatype=\"string\">HKEY_LOCAL_MACHINE</ns1:hive>\n          <ns1:key datatype=\"string\">SOFTWARE\\Policies\\Microsoft\\PassportForWork\\PINComplexity</ns1:key>\n          <ns1:name datatype=\"string\">MinimumPINLength</ns1:name>\n        </ns1:registry_object>\n        <ns1:registry_object id=\"oval:mil.disa.stig.win:obj:25340102\" version=\"4\" comment=\"Intune registry entry for MinimumPINLength\">\n          <ns1:hive datatype=\"string\">HKEY_LOCAL_MACHINE</ns1:hive>\n          <ns1:key datatype=\"string\" var_ref=\"oval:mil.disa.stig.defs:var:25340100\" var_check=\"at least one\" />\n          <ns1:name datatype=\"string\">MinimumPINLength</ns1:name>\n        </ns1:registry_object>\n        <ns1:registry_object id=\"oval:mil.disa.stig.win:obj:25340103\" version=\"4\" comment=\"Registry object for the Tenant ID of the account currently in use\">\n          <ns1:hive datatype=\"string\">HKEY_LOCAL_MACHINE</ns1:hive>\n          <ns1:key datatype=\"string\" operation=\"pattern match\">(?i)SYSTEM\\\\CurrentControlSet\\\\Control\\\\CloudDomainJoin\\\\TenantInfo\\\\[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}</ns1:key>\n          <ns1:name xsi:nil=\"true\" />\n        </ns1:registry_object>\n        </ns0:objects><ns0:states><ns1:registry_state id=\"oval:mil.disa.stig.win:ste:25340100\" version=\"1\">\n          <ns1:type>reg_dword</ns1:type>\n          <ns1:value datatype=\"int\" operation=\"greater than or equal\">6</ns1:value>\n        </ns1:registry_state>\n        </ns0:states><ns0:variables><ns0:local_variable id=\"oval:mil.disa.stig.defs:var:25340100\" version=\"2\" datatype=\"string\" comment=\"GUID of current Tenant\">\n          <ns0:concat>\n            <ns0:literal_component>SOFTWARE\\Microsoft\\Policies\\PassportForWork\\</ns0:literal_component>\n            <ns0:regex_capture pattern=\"(?i)\\\\([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$\">\n              <ns0:object_component object_ref=\"oval:mil.disa.stig.win:obj:25340103\" item_field=\"key\" />\n            </ns0:regex_capture>\n            <ns0:literal_component>\\device\\policies\\PINComplexity</ns0:literal_component>\n          </ns0:concat>\n        </ns0:local_variable>\n        </ns0:variables></ns0:oval_definitions>",
