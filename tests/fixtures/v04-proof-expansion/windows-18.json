:literal_component>try {Get-DnsServerZone -Name </ns0:literal_component>\n            <ns0:object_component object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:25933902\" item_field=\"stdout_line\" />\n            <ns0:literal_component> | ForEach-Object {$_.IsSigned}} catch {}</ns0:literal_component>\n          </ns0:concat>\n        </ns0:local_variable>\n        <ns0:local_variable id=\"oval:navy.navwar.niwcatlantic.scc.windows:var:25933902\" version=\"8\" datatype=\"string\" comment=\"The command to get the list of DS signature validity periods\">\n          <ns0:concat>\n            <ns0:literal_component>try {Get-DNSServerSigningKey -ZoneName </ns0:literal_component>\n            <ns0:object_component object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:25933902\" item_field=\"stdout_line\" />\n            <ns0:literal_component> | Where-Object KeyType -eq 'ZoneSigningKey' | ForEach-Object {$_.DSSignatureValidityPeriod.Days * 24 + $_.DSSignatureValidityPeriod.Hours}} catch {Write-Output '0'}</ns0:literal_component>\n          </ns0:concat>\n        </ns0:local_variable>\n        </ns0:variables></ns0:oval_definitions>",
