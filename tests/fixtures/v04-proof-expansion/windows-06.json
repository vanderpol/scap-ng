{
  "source_xml": "<ns0:oval_definitions xmlns:ns0=\"http://oval.mitre.org/XMLSchema/oval-definitions-5\" xmlns:ns1=\"http://oval.mitre.org/XMLSchema/oval-definitions-5#windows\"><ns0:definitions><ns0:definition id=\"oval:mil.disa.stig.defs:def:253394\" version=\"3\" class=\"compliance\">\n          <ns0:metadata>\n            <ns0:title>Windows Update for workstations must not obtain updates from other PCs on the internet.</ns0:title>\n            <ns0:description />\n          </ns0:metadata>\n          <ns0:criteria operator=\"OR\">\n            <ns0:extend_definition definition_ref=\"oval:mil.disa.stig.defs:def:254357\" comment=\"'DownloadMode' is set to 'Enabled' with 'HTTP only, LAN, Group, Simple, or Bypass' selected.\" />\n            <ns0:criteria operator=\"AND\" comment=\"Standalone version of Windows and Download mode is configured through the Settings App\">\n              <ns0:criterion test_ref=\"oval:mil.disa.stig.win:tst:25339402\" comment=\"Standalone Windows system\" />\n              <ns0:criterion test_ref=\"oval:mil.disa.stig.win:tst:25339403\" comment=\"'DownloadMode' is set to 'Enabled' with 'HTTP only, or LAN' selected.\" />\n            </ns0:criteria>\n          </ns0:criteria>\n        </ns0:definition>\n        <ns0:definition id=\"oval:mil.disa.stig.defs:def:254357\" version=\"1\" class=\"compliance\">\n          <ns0:metadata>\n            <ns0:title>Windows Update must not obtain updates from other PCs on the internet.</ns0:title>\n            <ns0:description />\n          </ns0:metadata>\n          <ns0:criteria>\n            <ns0:criterion test_ref=\"oval:mil.disa.stig.win:tst:25339401\" comment=\"'DownloadMode' is set to 'Enabled' with 'HTTP only, LAN, Group, Simple, or Bypass' selected.\" />\n          </ns0:criteria>\n        </ns0:definition>\n        <ns0:definition id=\"oval:mil.disa.stig.windows11:def:253394\" version=\"2\" class=\"compliance\">\n          <ns0:metadata>\n            <ns0:title>WN11-CC-000206 - Windows Update must not obtain updates from other PCs on the internet.</ns0:title>\n            <ns0:affected family=\"windows\">\n              <ns0:platform>Microsoft Windows 11</ns0:platform>\n            </ns0:affected>\n            <ns0:description>Windows 11 allows Windows Update to obtain updates from additional sources instead of Microsoft. In addition to Microsoft, updates can be obtained from and sent to PCs on the local network as well as on the Internet. This is part of the Windows Update trusted process, however to minimize outside exposure, obtaining updates from or sending to systems on the internet must be prevented.</ns0:description>\n          </ns0:metadata>\n          <ns0:criteria>\n            <ns0:extend_definition definition_ref=\"oval:mil.disa.stig.defs:def:253394\" />\n          </ns0:criteria>\n        </ns0:definition>\n        </ns0:definitions><ns0:tests><ns1:registry_test id=\"oval:mil.disa.stig.win:tst:25339401\" version=\"1\" check_existence=\"at_least_one_exists\" check=\"all\" state_operator=\"OR\" comment=\"'DownloadMode' is set to 'Enabled' with 'HTTP only, LAN, Group, Simple or Bypass' selected.\">\n          <ns1:object object_ref=\"oval:mil.disa.stig.win:obj:25339400\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:20000000\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:20000001\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:20000002\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:25339400\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:25339401\" />\n        </ns1:registry_test>\n        <ns1:wmi57_test id=\"oval:mil.disa.stig.win:tst:25339402\" version=\"2\" check=\"all\" state_operator=\"OR\" comment=\"The system is a Windows Standalone Workstation or Server\">\n          <ns1:object object_ref=\"oval:mil.disa.stig.win:obj:10000100\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:10000100\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:10000300\" />\n        </ns1:wmi57_test>\n        <ns1:registry_test id=\"oval:mil.disa.stig.win:tst:25339403\" version=\"2\" check_existence=\"at_least_one_exists\" check=\"all\" state_operator=\"OR\" comment=\"'DownloadMode' is set to 'Enabled' with 'HTTP only or LAN' selected.\">\n          <ns1:object object_ref=\"oval:mil.disa.stig.win:obj:25339401\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:20000000\" />\n          <ns1:state state_ref=\"oval:mil.disa.stig.win:ste:20000001\" />\n        </ns1:registry_test>\n        </ns0:tests><ns0:objects><ns1:wmi57_object id=\"oval:mil.disa.stig.win:obj:10000100\" version=\"1\">\n          <ns1:namespace>root\\cimv2</ns1:namespace>\n          <ns1:wql>SELECT DomainRole FROM win32_computersystem</ns1:wql>\n        </ns1:wmi57_object>\n        <ns1:registry_object id=\"oval:mil.disa.stig.win:obj:25339400\" version=\"1\">\n          <ns1:hive datatype=\"string\" operation=\"equals\">HKEY_LOCAL_MACHINE</ns1:hive>\n          <ns1:key datatype=\"string\" operation=\"equals\">Software\\Policies\\Microsoft\\Windows\\DeliveryOptimization</ns1:key>\n          <ns1:name datatype=\"string\" operation=\"equals\">DODownloadMode</ns1:name>\n        </ns1:registry_object>\n        <ns1:registry_object id=\"oval:mil.disa.stig.win:obj:25339401\" version=\"1\" comment=\"DownloadMode set through the Settings App\">\n          <ns1:hive datatype=\"string\" operation=\"equals\">HKEY_LOCAL_MACHINE</ns1:hive>\n          <ns1:key datatype=\"string\" operation=\"equals\">SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\DeliveryOptimization\\Config</ns1:key>\n          <ns1:name datatype=\"string\" operation=\"equals\">DODownloadMode</ns1:name>\n        </ns1:registry_object>\n        </ns0:objects><ns0:states><ns1:wmi57_state id=\"oval:mil.disa.stig.win:ste:10000100\" version=\"1\" comment=\"Standalone Workstation\">\n          <ns1:result datatype=\"record\" operation=\"equals\">\n            <ns0:field name