atatype=\"int\">0</ns1:stdout_line>\n        </ns1:shellcommand_state>\n        <ns1:shellcommand_state id=\"oval:navy.navwar.niwcatlantic.scc.windows:ste:25935105\" version=\"8\" comment=\"The 'CryptoAlgorithm' setting for each DNSKEY resource record in each forward lookup zone is secure\">\n          <ns1:stdout_line operation=\"pattern match\" entity_check=\"all\" check_existence=\"at_least_one_exists\">^RsaSha\\d</ns1:stdout_line>\n        </ns1:shellcommand_state>\n        </ns0:states><ns0:variables><ns0:local_variable id=\"oval:navy.navwar.niwcatlantic.scc.windows:var:25935101\" version=\"8\" datatype=\"string\" comment=\"The command to get the 'IsSigned' setting for each forward lookup zone\">\n          <ns0:concat>\n            <ns0:literal_component>try {Get-DnsServerZone -Name </ns0:literal_component>\n            <ns0:object_component object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:25935102\" item_field=\"stdout_line\" />\n            <ns0:literal_component> | ForEach-Object {$_.IsSigned}} catch {}</ns0:literal_component>\n          </ns0:concat>\n        </ns0:local_variable>\n        <ns0:local_variable id=\"oval:navy.navwar.niwcatlantic.scc.windows:var:25935102\" version=\"8\" datatype=\"string\" comment=\"The command to get the number of DNSKEY resource records for each forward lookup zone\">\n          <ns0:concat>\n            <ns0:literal_component>try {Get-DnsServerResourceRecord -ZoneName '</ns0:literal_component>\n            <ns0:object_component object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:25935102\" item_field=\"stdout_line\" />\n            <ns0:literal_component>' -RRType DnsKey | Measure-Object | Select-Object -ExpandProperty Count} catch {Write-Output '0'}</ns0:literal_component>\n          </ns0:concat>\n        </ns0:local_variable>\n        <ns0:local_variable id=\"oval:navy.navwar.niwcatlantic.scc.windows:var:25935103\" version=\"8\" datatype=\"string\" comment=\"The command to get the 'CryptoAlgorithm' setting for each DNSKEY resource record in each forward lookup zone\">\n          <ns0:concat>\n            <ns0:literal_component>try {Get-DnsServerResourceRecord -ZoneName '</ns0:literal_component>\n            <ns0:object_component object_ref=\"oval:navy.navwar.niwcatlantic.scc.windows:obj:25935102\" item_field=\"stdout_line\" />\n            <ns0:literal_component>' -RRType DnsKey | ForEach-Object {$_.RecordData.CryptoAlgorithm}} catch {Write-Output 'ERROR'}</ns0:literal_component>\n          </ns0:concat>\n        </ns0:local_variable>\n        </ns0:variables></ns0:oval_definitions>",
