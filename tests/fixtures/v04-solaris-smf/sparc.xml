          <ns0:metadata>
            <ns0:title>All .Xauthority files must have mode 0600 or less permissive.</ns0:title>
            <ns0:affected family="unix">
              <ns0:platform>Oracle Solaris 10</ns0:platform>
            </ns0:affected>
