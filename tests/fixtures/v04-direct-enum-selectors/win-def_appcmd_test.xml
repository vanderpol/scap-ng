    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:103" version="1" comment="Application Pool Setting Example - All Application Pools Reviewed" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="pattern match">.*</identifier>
