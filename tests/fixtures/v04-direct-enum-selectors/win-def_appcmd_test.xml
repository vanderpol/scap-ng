    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:102" version="1" comment="Application Pool Setting Example - All Application Pools Reviewed" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="pattern match" var_ref="oval:navy.navwar.niwcatlantic.scc.test:var:102"/>
      <parameter>recycling.periodicRestart.time</parameter>
