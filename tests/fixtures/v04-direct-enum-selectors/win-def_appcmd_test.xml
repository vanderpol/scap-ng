  <objects>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" version="1" comment="Application Pool Setting Example - All Application Pools Reviewed" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <parameter>recycling.periodicRestart.time</parameter>
      <!-- AppCmd.exe command used
        for each apppool that exists on system this appcmd is executed
        > .\appcmd.exe list apppool <apppoolname> /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:2" version="1" comment="Application Pool Setting Example - Subset Of Application Pools Reviewed via regular expression (set in identifier)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="pattern match">default</identifier>
      <parameter>recycling.periodicRestart.time</parameter>
      <!-- AppCmd.exe command used
        for each apppool that's name matches "default" via regular expression compare on system this appcmd is executed
        > .\appcmd.exe list apppool <apppoolname> /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:3" version="1" comment="Application Pool Setting Example - Subset Of Application Pools Reviewed via equal to (set in identifier) 'DefaultAppPool' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="equals">DefaultAppPool</identifier>
      <parameter>recycling.periodicRestart.time</parameter>
      <!-- AppCmd.exe command used
        one command run attempting to review an apppool named "DefaultAppPool" if it exists on the system... if not an error is reported
        > .\appcmd.exe list apppool default apppool /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:4" version="1" comment="Application Pool Setting Example - Subset Of Application Pools Reviewed via not equal to (set in identifier)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="not equal">DefaultAppPool</identifier>
      <parameter>recycling.periodicRestart.time</parameter>
      <!-- AppCmd.exe command used
        for each apppool that's name is not "DefaultAppPool" via compare on system this appcmd is executed
        > .\appcmd.exe list apppool default apppool /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:5" version="1" comment="Website Setting Example - All Websites Reviewed" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <parameter>logFile.directory</parameter>
      <!-- AppCmd.exe command used
        for each website that exists on system this appcmd is executed
        > .\appcmd.exe list site "<sitename>" /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:6" version="1" comment="Website Setting Example - Subset Of Websites Reviewed via regular expression (set in identifier)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Site</identifier_type>
      <identifier operation="pattern match">default</identifier>
      <parameter>logFile.directory</parameter>
      <!-- AppCmd.exe command used
        for each site that's name matches "default" via regular expression compare on system this appcmd is executed
        > .\appcmd.exe list site "<sitename>" /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:7" version="1" comment="VDir Setting Example - All Virtual Directories Reviewed" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>VDir</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <parameter>physicalpath</parameter>
      <!-- AppCmd.exe command used
        for each VDir that exists on system this appcmd is executed
        > .\appcmd.exe list site <vdir> /text:recycling.periodicRestart.time
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:8" version="1" comment="Not Collected Example - Incorrect Parameter Example - AppCmd.exe reports error due to incorrect parameter setting." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>VDir</identifier_type>
      <identifier operation="pattern match">.*</identifier>
      <parameter>physicalErrorpath</parameter>
      <!-- The incorrect parameter entry will cause an "Not Found" finding
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:9" version="1" comment="Not Collected Example - Application Pool 'Equals' (set in identifier) 'Non-Matching-String' - No Application Pools named 'Non-Matching-String' exist" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="equals">NonMatchingString</identifier>
      <parameter>recycling.periodicRestart.time</parameter>
      <!-- The identifier operation of equals and no Apppool names matching Non-Matching-String will cause an "Not Found" finding
      -->
    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:101" version="1" comment="Application Pool Setting Example - All Application Pools Reviewed Variable Test identifier_type" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type var_ref="oval:navy.navwar.niwcatlantic.scc.test:var:101"/>
