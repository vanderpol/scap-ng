    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:13" version="1" comment="Application Pool Setting Example - Subset Of Application Pools Reviewed via case insensitive equal to (set in identifier) 'DefaultAppPool' which exists by default." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="case insensitive equals">defaultapppool</identifier>
      <parameter>recycling.periodicRestart.time</parameter>
      <!-- AppCmd.exe command used
        one command run attempting to review an apppool named "DefaultAppPool" if it exists on the system... if not an error is reported
        > .\appcmd.exe list apppool default apppool /text:recycling.periodicRestart.time
