    </appcmd_object>
  </objects>
  <states>
    <appcmd_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:1" version="1" comment="Apppool example state recycling.periodicRestart.time" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <result operation="equals" entity_check="all">00:20:00</result>
    </appcmd_state>
    <appcmd_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:2" version="1" comment="Any string will pass." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
