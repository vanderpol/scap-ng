    </appcmd_object>
    <appcmd_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:14" version="1" comment="Application Pool Setting Example - Subset Of Application Pools Reviewed via case insenstive not equal to (set in identifier)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#windows">
      <identifier_type>Apppool</identifier_type>
      <identifier operation="case insensitive not equal">defaultapppool</identifier>
