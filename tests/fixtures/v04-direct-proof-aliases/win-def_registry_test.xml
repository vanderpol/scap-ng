  <definitions>
    <definition id="oval:org.mitre.oval.test:def:38" version="1" class="miscellaneous">
      <metadata>
        <title>Evaluate to true if the win-def:registry_test is properly supported.</title>
        <description>This definition is intended to evaluate to true if the interpreter properly
          supports the win-def:registry_test.</description>
      </metadata>
      <notes>
        <note>It is important to note that the values used in this test definition are specific to a
          particular machine, and may not necessarily apply to your system. As a result, in order to
          have the definition return a result of 'true', you must either change these values to the
          ones found on your particular system, or you must configure your system to use these
          values.</note>
        <note>Information regarding the registry on your particular machine can be found by
          navigating to Start->Run... and by typing 'regedit'.</note>
      </notes>
      <criteria>
        <criterion comment="Test if a registry_object with a hive is supported."       test_ref="oval:org.mitre.oval.test:tst:1000"/>
        <criterion comment="Test if a registry_object with a hive key is supported."   test_ref="oval:org.mitre.oval.test:tst:1010"/>
        <criterion comment="Test if a registry_object with a hive, key, and name is supported."      test_ref="oval:org.mitre.oval.test:tst:1020"/>
        <criterion comment="Test if a registry_object with a hive, key, and name is supported. All using operation=case insensitive equals"     test_ref="oval:org.mitre.oval.test:tst:5020"/>
        <criterion comment="Test if a registry_object with a hive, key, and name pattern match is supported."    test_ref="oval:org.mitre.oval.test:tst:1030"/>
        <criterion comment="Test if a registry_object with a hive, key pattern match, and name pattern match is supported."    test_ref="oval:org.mitre.oval.test:tst:1040"/>
        <criterion comment="Test if a registry_object with a hive, key pattern match with $, and name is supported."  test_ref="oval:org.mitre.oval.test:tst:1080"/>
        <criterion comment="Test if a registry_object is supported with a empty string for a registry value name."    test_ref="oval:org.mitre.oval.test:tst:1090"/>
        <criterion comment="Test that the max_depth behavior is supported with a limited depth of recursion."         test_ref="oval:org.mitre.oval.test:tst:1100"/>
        <criterion comment="Test that the max_depth behavior is supported with a unlimited depth of recursion."     test_ref="oval:org.mitre.oval.test:tst:1110"/>
        <criterion comment="Test reg_expand_sz type registry key on HKLM - State has expanded_value"  test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:3000"/>
        <criterion comment="Test HKCU is supported"      test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:3010"/>
        <criterion comment="Test use of hive variable"   test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:4000"/>
        <criterion comment="Test use of key variable"    test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:4010"/>
        <criterion comment="Test use of value variable"  test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:4020"/>
      </criteria>
    </definition>
