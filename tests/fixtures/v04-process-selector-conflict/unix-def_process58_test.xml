  <objects>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" version="1" comment="Retrieve process58_items with names that are not equal to 'init'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="not equal">init</command_line>
      <pid datatype="int" operation="greater than">0</pid>
    </process58_object>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:2" version="1" comment="Retrieve process58_items with names that match the regular expression '^in.*t$'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="pattern match">^(?:(?:/usr)*/lib/systemd/systemd)|(?:(?:/usr)*/sbin/init)|(?:/sbin/launchd).*</command_line>
      <pid datatype="int" operation="greater than">0</pid>
      <oval-def:filter action="include">oval:navy.navwar.niwcatlantic.scc.test:ste:9</oval-def:filter>
    </process58_object>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:3" version="1" comment="Retrieve process58_items with pid equals 1." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="pattern match">.*</command_line>
      <pid datatype="int">1</pid>
    </process58_object>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:4" version="1" comment="Retrieve process58_items with pid less than 10." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
