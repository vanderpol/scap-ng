      <pid datatype="int" operation="less than or equal">10</pid>
    </process58_object>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:7" version="1" comment="Retrieve process58_items with pid greater than or equals 10." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="pattern match">.*</command_line>
      <pid datatype="int" operation="greater than or equal">10</pid>
    </process58_object>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:8" version="1" comment="Retrieve process58_items with names that are not equal to 'init'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="not equal">init</command_line>
      <pid datatype="int" operation="greater than">0</pid>
      <oval-def:filter action="include">oval:navy.navwar.niwcatlantic.scc.test:ste:8</oval-def:filter>
    </process58_object>
  </objects>
  <states>
    <process58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:1" version="1" comment="This state represents process58_items that have a name not equal to 'init'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="not equal">init</command_line>
    </process58_state>
    <process58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:2" version="1" comment="This state represents process58_items that have a name that matches the regular expression '^in.*t$'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="pattern match">^(?:/usr)*/lib/systemd/systemd|(/usr)*/sbin/init|launchd.*</command_line>
      <pid datatype="int">1</pid>
      <ppid datatype="int" operation="greater than or equal">0</ppid>
      <priority datatype="int" operation="greater than or equal">0</priority>
      <ruid datatype="int" operation="greater than or equal">0</ruid>
      <start_time datatype="string" operation="pattern match">\d</start_time>
      <tty datatype="string" operation="pattern match">.+</tty>
      <user_id datatype="int" operation="greater than or equal">0</user_id>
      <session_id datatype="int" operation="greater than or equal">0</session_id>
    </process58_state>
    <process58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:3" version="1" comment="process58_items whose command starts with the word 'init'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
      <command_line operation="pattern match">systemd|init|launchd</command_line>
    </process58_state>
    <process58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:4" version="1" comment="Confirm items have pid(s) less than 10." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
