      <pid datatype="int" operation="less than">10</pid>
    </process58_object>
    <process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:5" version="1" comment="Retrieve process58_items with pid greater than 10." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#unix">
