  <definitions>
   <definition id="oval:navy.navwar.niwcatlantic.scc.windows:def:1" version="1" class="compliance">
    <metadata>
      <title>Test/Development content for the independent shellcommand test.</title>
      <description>Test/Development content for the independent shellcommand test.  See comments in criterion for the intent of each test.</description>
    </metadata>
    <criteria>
      <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:1" comment="Review Installed OS via PowerShell" />
      <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:2" comment="Review the Windows time service configuration via cmd shell." />
      <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:3" comment="Get C:\ listing via PowerShell" />
      <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:4" comment="Exercise use of a variables for shell and command object elements." />
      <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:5" comment="Get File Permissions of Windows install directory   via powershell." />
      <criterion test_ref="oval:navy.navwar.niwcatlantic.scc:tst:6" comment="Show STDErr Example via cmd" />
    </criteria>
   </definition>
  </definitions>
  
  <tests>
    <shellcommand_test id="oval:navy.navwar.niwcatlantic.scc:tst:1" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" version="1" comment="Review Installed OS via PowerShell" check_existence="at_least_one_exists" check="all">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc:obj:1"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc:ste:1"/>
    </shellcommand_test>
    
    <shellcommand_test id="oval:navy.navwar.niwcatlantic.scc:tst:2" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" version="1" comment="Review the Windows time service configuration via cmd shell" check_existence="at_least_one_exists" check="all">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc:obj:2"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc:ste:2"/>
    </shellcommand_test>
    
    <shellcommand_test id="oval:navy.navwar.niwcatlantic.scc:tst:3" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" version="1" comment="Review the contents of C:\ via powershell" check_existence="at_least_one_exists" check="all">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc:obj:3"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc:ste:1"/>
    </shellcommand_test>
    

    <shellcommand_test id="oval:navy.navwar.niwcatlantic.scc:tst:4" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" version="1" comment="Exercise use of a variables for shell and command object elements." check_existence="at_least_one_exists" check="all">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc:obj:4"/>
    </shellcommand_test>
    
    <shellcommand_test id="oval:navy.navwar.niwcatlantic.scc:tst:5" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" version="1" comment="Get file permissions of Windows install directory via powershell" check_existence="at_least_one_exists" check="all">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc:obj:5"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc:ste:1"/>
    </shellcommand_test>
    
    <shellcommand_test id="oval:navy.navwar.niwcatlantic.scc:tst:6" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" version="1" comment="Show STDErr Example via cmd" check_existence="at_least_one_exists" check="all">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc:obj:6"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc:ste:6"/>
    </shellcommand_test>
  </tests>
 
  <objects>
    <shellcommand_object id="oval:navy.navwar.niwcatlantic.scc:obj:1" version="10" comment="Review Installed OS via PowerShell" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <shell>powershell</shell>
      <command>bcdedit /enum</command>
      <pattern>^description</pattern>
    </shellcommand_object>
    
    <shellcommand_object id="oval:navy.navwar.niwcatlantic.scc:obj:2" version="10" comment="Review the Windows time service configuration via cmd shell" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <shell>cmd</shell>
      <command>W32tm /query /configuration</command>
      <pattern>^Type:</pattern>
    </shellcommand_object>
    
    <shellcommand_object id="oval:navy.navwar.niwcatlantic.scc:obj:3" version="10" comment="C:\ Via powershell" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <shell>powershell</shell>
      <command>Get-ChildItem -Path C:\</command>
      <pattern></pattern>
    </shellcommand_object>
    
    <shellcommand_object id="oval:navy.navwar.niwcatlantic.scc:obj:4" version="1" comment="Exercise use of a variables for shell and command object elements." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <shell var_ref="oval:navy.navwar.niwcatlantic.scc:var:4" />
      <command var_ref="oval:navy.navwar.niwcatlantic.scc:var:5" />
    </shellcommand_object> 
    
    <shellcommand_object id="oval:navy.navwar.niwcatlantic.scc:obj:5" version="1" comment="Run Icacls command against Windows install directory" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <shell>powershell</shell>
      <command>icacls($env:windir)</command>
      <pattern>:</pattern>
    </shellcommand_object>
    
    <shellcommand_object id="oval:navy.navwar.niwcatlantic.scc:obj:6" version="10" comment="Review the Windows time service configuration via cmd shell" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <shell>cmd</shell>
      <command>INVALID Command</command>
      <pattern></pattern>
    </shellcommand_object>
  </objects>
 
  <states>
    <shellcommand_state id="oval:navy.navwar.niwcatlantic.scc:ste:1" version="1" comment="Powershell Command returns data" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <stdout_line operation="pattern match">.*</stdout_line>
    </shellcommand_state>
    
    <shellcommand_state id="oval:navy.navwar.niwcatlantic.scc:ste:2" version="1" comment="cmd shell command returns data'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <exit_status datatype="int">0</exit_status>
      <stdout_line operation="pattern match">.*</stdout_line>
    </shellcommand_state>
    
    <shellcommand_state id="oval:navy.navwar.niwcatlantic.scc:ste:6" version="1" comment="cmd shell command returns data'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <exit_status operation="greater than" datatype="int">0</exit_status>
      <stderr_line operation="pattern match">.*</stderr_line>
    </shellcommand_state>
  </states>

  <variables>
    <local_variable id="oval:navy.navwar.niwcatlantic.scc:var:4" version="1" datatype="string" comment="a comment">
      <literal_component>cmd</literal_component>
    </local_variable>
    
    <local_variable id="oval:navy.navwar.niwcatlantic.scc:var:5" version="1" datatype="string" comment="a comment">
      <literal_component>netstat</literal_component>
    </local_variable>
  </variables>
