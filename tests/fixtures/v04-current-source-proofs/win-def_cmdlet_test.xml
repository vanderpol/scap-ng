      </metadata>
      <criteria operator="AND" negate="false" comment="Get-CimInstance -classname 'Win32_DeviceGuard' -namespace 'root\Microsoft\Windows\DeviceGuard' | select-Object -property 'SecurityServicesRunning', 'AvailableSecurityProperties'">
