{
  "assessment": {
    "id": "SV-214251.automated",
    "version": 2,
    "assessment_title": "Cookies exchanged between the Apache web server and client, such as session cookies, must have security settings that disallow cookie access outside the originating Apache web server and hosted application.",
    "mode": "automated",
    "class": "compliance",
    "purpose": "assessment",
    "specification": {
      "id": "scap-ng.pre-alpha.assessment",
      "version": "0.4.0"
    },
    "variables": {
      "apache-base-install-directories-unix-variable": {
        "title": "Apache base install directories (unix)",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "regex_capture": {
            "value": {
              "values": {
                "object": "gather-unique-apache-http-installation-paths-object",
                "field": "stdout_line"
              }
            },
            "pattern": "(^\\/.+\\/)httpd|(^\\/.+/)apache2"
          }
        }
      },
      "httpd-root-apachectl-v-variable": {
        "title": "httpd_root to apachectl -V",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "apache-base-install-directories-unix-variable"
            },
            {
              "literal": {
                "value": "apachectl -V | grep -i 'httpd_root'",
                "datatype": "string"
              }
            }
          ]
        }
      },
      "filepath-httpd-root-variable": {
        "title": "Filepath to HTTPD_ROOT",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "regex_capture": {
            "value": {
              "values": {
                "object": {
                  "capability": "independent.shellcommand",
                  "object_title": "Gather HTTPD_ROOT files via apachectl",
                  "collect": {
                    "shell": "bash",
                    "command": {
                      "variable": "httpd-root-apachectl-v-variable"
                    },
                    "pattern": "HTTPD_ROOT",
                    "error_if_exit_status_not_0": false,
                    "error_if_stderr_exists": false
                  }
                },
                "field": "stdout_line"
              }
            },
            "pattern": " -D HTTPD_ROOT=\"(.+)\""
          }
        }
      },
      "server-config-file-apachectl-v-variable": {
        "title": "server_config_file to apachectl -V",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "apache-base-install-directories-unix-variable"
            },
            {
              "literal": {
                "value": "apachectl -V | grep -i 'server_config_file'",
                "datatype": "string"
              }
            }
          ]
        }
      },
      "relative-server-config-file-variable": {
        "title": "relative to SERVER_CONFIG_FILE",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "regex_capture": {
            "value": {
              "values": {
                "object": {
                  "capability": "independent.shellcommand",
                  "object_title": "Gather SERVER_CONFIG_FILE files via apachectl",
                  "collect": {
                    "shell": "bash",
                    "command": {
                      "variable": "server-config-file-apachectl-v-variable"
                    },
                    "pattern": "SERVER_CONFIG_FILE",
                    "error_if_exit_status_not_0": false,
                    "error_if_stderr_exists": false
                  }
                },
                "field": "stdout_line"
              }
            },
            "pattern": " -D SERVER_CONFIG_FILE=\"(.+)\""
          }
        }
      },
      "filepath-http-conf-file-variable": {
        "title": "Filepath to http conf file",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "filepath-httpd-root-variable"
            },
            {
              "literal": {
                "value": "/",
                "datatype": "string"
              }
            },
            {
              "variable": "relative-server-config-file-variable"
            }
          ]
        }
      },
      "shell-command-check-all-include-include-optional-files-variable": {
        "title": "shell command to check for all Include and Include Optional files",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "literal": {
                "value": "grep -iEHn '^\\s*Include\\s+|^\\s*IncludeOptional\\s+' ",
                "datatype": "string"
              }
            },
            {
              "variable": "filepath-http-conf-file-variable"
            }
          ]
        }
      },
      "all-included-conf-files-from-include-refernces-in-httd-conf-variable": {
        "title": "All included conf files from Include refernces in httd.conf",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "filepath-httpd-root-variable"
            },
            {
              "literal": {
                "value": "/",
                "datatype": "string"
              }
            },
            {
              "regex_capture": {
                "value": {
                  "values": {
                    "object": {
                      "capability": "independent.shellcommand",
                      "object_title": "Gather Include statements from httpd.conf",
                      "collect": {
                        "shell": "bash",
                        "command": {
                          "variable": "shell-command-check-all-include-include-optional-files-variable"
                        },
                        "pattern": "\\S+",
                        "error_if_exit_status_not_0": false,
                        "error_if_stderr_exists": false
                      }
                    },
                    "field": "stdout_line"
                  }
                },
                "pattern": "\\S+\\s+(\\S+)\\s*"
              }
            }
          ]
        }
      },
      "merged-included-conf-files-from-include-refernces-in-httd-conf-variable": {
        "title": "merged included conf files from Include refernces in httd.conf",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "merge": {
            "values": {
              "variable": "all-included-conf-files-from-include-refernces-in-httd-conf-variable"
            },
            "delimiter": " ",
            "sort": "document",
            "order": "ascending"
          }
        }
      },
      "httpd-conf-merged-included-conf-files-from-include-refernces-in-variable": {
        "title": "httpd.conf and merged included conf files from Include refernces in httd.conf",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "filepath-http-conf-file-variable"
            },
            {
              "literal": {
                "value": " ",
                "datatype": "string"
              }
            },
            {
              "variable": "merged-included-conf-files-from-include-refernces-in-httd-conf-variable"
            }
          ]
        }
      },
      "shell-command-check-sessioncookiename-in-httpd-conf-all-include-conf-variable": {
        "title": "shell command to check SessionCookieName in httpd.conf and all Include conf files",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "literal": {
                "value": "grep -iHn '^\\s*SessionCookieName' ",
                "datatype": "string"
              }
            },
            {
              "variable": "httpd-conf-merged-included-conf-files-from-include-refernces-in-variable"
            }
          ]
        }
      },
      "apache-path-httpd-or-apache2-variable": {
        "title": "Apache path to httpd or apache2",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "regex_capture": {
            "value": {
              "values": {
                "object": "gather-unique-apache-http-installation-paths-object",
                "field": "stdout_line"
              }
            },
            "pattern": "(^\\/.+\\/httpd|^\\/.+\\/apache2) "
          }
        }
      },
      "command-gather-httpd-apache2-list-all-loaded-configuration-files-variable": {
        "title": "command to gather httpd/apache2 list of all loaded configuration files",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "apache-path-httpd-or-apache2-variable"
            },
            {
              "literal": {
                "value": " -t -D DUMP_INCLUDES",
                "datatype": "string"
              }
            }
          ]
        }
      },
      "all-loaded-configuration-filepaths-variable": {
        "title": "All loaded configuration filepaths",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "unique": {
            "regex_capture": {
              "value": {
                "values": {
                  "object": {
                    "capability": "independent.shellcommand",
                    "object_title": "Gather all loaded config files",
                    "collect": {
                      "shell": "bash",
                      "command": {
                        "variable": "command-gather-httpd-apache2-list-all-loaded-configuration-files-variable"
                      },
                      "pattern": " \\(",
                      "error_if_exit_status_not_0": false,
                      "error_if_stderr_exists": false
                    }
                  },
                  "field": "stdout_line"
                }
              },
              "pattern": "\\(.*\\) (/.*)"
            }
          }
        }
      },
      "merged-list-all-loaded-config-files-variable": {
        "title": "Merged list of all loaded config files",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "merge": {
            "values": {
              "variable": "all-loaded-configuration-filepaths-variable"
            },
            "delimiter": " ",
            "sort": "document",
            "order": "ascending"
          }
        }
      },
      "shell-command-check-sessioncookiename-in-all-loaded-conf-files-variable": {
        "title": "shell command to check SessionCookieName in all loaded conf files",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "literal": {
                "value": "grep -iHn '^\\s*SessionCookieName' ",
                "datatype": "string"
              }
            },
            {
              "variable": "merged-list-all-loaded-config-files-variable"
            }
          ]
        }
      },
      "command-gather-httpd-apache2-modules-variable": {
        "title": "command to gather httpd/apache2 modules",
        "kind": "local",
        "datatype": "string",
        "expression": {
          "concat": [
            {
              "variable": "apache-path-httpd-or-apache2-variable"
            },
            {
              "literal": {
                "value": " -M",
                "datatype": "string"
              }
            }
          ]
        }
      }
    },
    "tests": {
      "verify-that-sessioncookiename-directive-exists-configured-httponly-secure-not-domain-test": {
        "test_title": "Verify that SessionCookieName directive exists and is configured with HttpOnly and Secure, and not Domain for all httpd.conf/apache2.conf and included conf files",
        "capability": "independent.shellcommand",
        "object": {
          "object_title": "Gather all SessionCookieName data from httpd and all Include conf files",
          "collect": {
            "shell": "bash",
            "command": {
              "variable": "shell-command-check-sessioncookiename-in-httpd-conf-all-include-conf-variable"
            },
            "pattern": ".+",
            "error_if_exit_status_not_0": false,
            "error_if_stderr_exists": false
          }
        },
        "reported_elements": "all",
        "states_match": "all",
        "state_fields_require": "at_least_one_exists_and_all_match",
        "require": {
          "items": "one_or_more",
          "all_items_must": [
            {
              "stdout_line": {
                "matches_regex": "(?i)HttpOnly"
              }
            },
            {
              "stdout_line": {
                "matches_regex": "(?i)Secure"
              }
            },
            {
              "stdout_line": {
                "require": "may_be_absent_and_none_match",
                "matches_regex": "(?i)Domain"
              }
            }
          ]
        }
      },
      "if-sessioncookiename-exists-in-other-loaded-configurations-files-verify-it-test": {
        "test_title": "If the SessionCookieName exists in other loaded configurations files, verify it is configured with HttpOnly and Secure, and not Domain",
        "capability": "independent.shellcommand",
        "object": {
          "object_title": "Gather all SessionCookieName data from all loaded conf files",
          "collect": {
            "shell": "bash",
            "command": {
              "variable": "shell-command-check-sessioncookiename-in-all-loaded-conf-files-variable"
            },
            "pattern": ".+",
            "error_if_exit_status_not_0": false,
            "error_if_stderr_exists": false
          }
        },
        "reported_elements": "all",
        "states_match": "all",
        "state_fields_require": "may_be_absent_and_all_match",
        "require": {
          "items": "one_or_more",
          "all_items_must": [
            {
              "stdout_line": {
                "matches_regex": "(?i)HttpOnly"
              }
            },
            {
              "stdout_line": {
                "matches_regex": "(?i)Secure"
              }
            },
            {
              "stdout_line": {
                "require": "may_be_absent_and_none_match",
                "matches_regex": "(?i)Domain"
              }
            }
          ]
        }
      },
      "apache-headers-module-enabled-test": {
        "test_title": "Apache headers_module must be enabled",
        "capability": "independent.shellcommand",
        "object": {
          "object_title": "Gather all installed modules and filter on headers_module",
          "collect": {
            "shell": "bash",
            "command": {
              "variable": "command-gather-httpd-apache2-modules-variable"
            },
            "pattern": "headers_module",
            "error_if_exit_status_not_0": false,
            "error_if_stderr_exists": false
          }
        },
        "reported_elements": "all",
        "require": {
          "items": "one_or_more",
          "all_items_must": [
            {
              "stdout_line": {
                "require": "at_least_one_exists_and_some_match",
                "matches_regex": "headers_module"
              }
            }
          ]
        }
      }
    },
    "evaluate": {
      "all": [
        {
          "test": "verify-that-sessioncookiename-directive-exists-configured-httponly-secure-not-domain-test"
        },
        {
          "test": "if-sessioncookiename-exists-in-other-loaded-configurations-files-verify-it-test"
        },
        {
          "test": "apache-headers-module-enabled-test"
        }
      ]
    },
    "shared_objects": {
      "gather-unique-apache-http-installation-paths-object": {
        "capability": "independent.shellcommand",
        "object_title": "Gather unique apache http installation paths",
        "collect": {
          "shell": "bash",
          "command": "ps -e -o command --no-headers | grep -e httpd -e apache2 | sort | uniq",
          "pattern": "^\\/\\S+(\\/httpd|\\/apache2)\\s*",
          "error_if_exit_status_not_0": false,
          "error_if_stderr_exists": false
        }
      }
    }
  }
}
