{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scap-ng.dev/experimental/conditional/proposal-01/expression.schema.json",
  "title": "Experimental conditional expression, proposal-01",
  "description": "Fixture-only structural grammar. Not the released 0.2.0 schema or proof of execution semantics.",
  "$ref": "#/$defs/expression",
  "$defs": {
    "expression": {
      "oneOf": [
        {"type": "object", "required": ["test"], "properties": {"test": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["assessment"], "properties": {"assessment": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["if", "then", "else"], "properties": {
          "if": {"$ref": "#/$defs/expression"}, "then": {"$ref": "#/$defs/expression"}, "else": {"$ref": "#/$defs/expression"}
        }, "additionalProperties": false},
        {"type": "object", "required": ["not"], "properties": {"not": {"$ref": "#/$defs/expression"}}, "additionalProperties": false},
        {"type": "object", "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}, "additionalProperties": false},
        {"type": "object", "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}, "additionalProperties": false},
        {"type": "object", "required": ["not_applicable"], "properties": {"not_applicable": {
          "type": "object", "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "pattern": "\\S"}}, "additionalProperties": false
        }}, "additionalProperties": false}
      ]
    }
  }
}
